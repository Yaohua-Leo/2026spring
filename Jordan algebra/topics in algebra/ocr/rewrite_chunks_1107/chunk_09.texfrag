\begin{lemma}
For any $s \in S_0$ the set $\operatorname{spec}(s) \setminus \{0\}$ has at least $2n$ elements, where $n = \deg f$.
\end{lemma}

\begin{proof}
Suppose there exist $\alpha_1,\dots,\alpha_{2n+1} \in \operatorname{spec}(s)$ nonzero and $\alpha_i \neq \alpha_j$ if $i \neq j$.
Let $P_i = J U_{s-\alpha_i 1}$. Then $P_i$ is an ideal, $P_i$ is quadratic and by a previous lemma $f|_{P_i}=0$ for all $i=1,\dots,2n+1$.
Consider $g(x)=\prod_{i=1}^{2n+1}(x-\alpha_i)$, $g_i(x)=\frac{g(x)}{x-\alpha_i}$.
The polynomials $g_i(x)$ are pairwise prime. Then there exist $h_1,\dots,h_{2n+1} \in F[x]$ such that $\sum_{i=1}^{2n+1} h_i(x)g_i(x)=1$.
In particular, $\sum_{i=1}^{2n+1} h_i(s)g_i(s)=1$.
Then $1 = \sum_{i,j} U_{h_i(s)g_i(s),h_j(s)g_j(s)}$.
Let $x^{(1)},\dots,x^{(m)} \in J$ be arbitrary elements. Then $x^{(k)}=\sum_{i,j} x_{ij}^{(k)}$ with $x_{ij}^{(k)} \in J U_{h_i(s)g_i(s),h_j(s)g_j(s)}$.
Since the field $F$ is infinite, we may assume $f$ is homogeneous. Let $\sum_k f_k$ be the linearization of $f$, then
\[
f\left(x^{(1)},\dots,x^{(m)}\right)=f\left(\sum_{i,j} x_{ij}^{(1)},\dots,\sum_{i,j} x_{ij}^{(m)}\right)=\sum_k f_k\left(x_{i_1j_1}^{(1)},\dots,x_{i_mj_m}^{(m)}\right).
\]
Since $m \leq n$, there exists $r \leq 2n+1$ such that $r \notin \{i_1,j_1,\dots,i_m,j_m\}$. We show that $x_{i_1j_1}^{(1)},\dots,x_{i_mj_m}^{(m)} \in P_r$.
We have $P_r = J U_{s-\alpha_r 1}$ and $(x-\alpha_r 1)$ divides $g_i(x)$ for all $i \neq r$.
Now, $U_{ab,ac}=U_{b,c}U_a = U_a U_{b,c}$ for all $a,b,c \in F[x]$. In fact, since the algebra generated by $x$ is special, we have
\[
y U_{ab,ac} = \frac{1}{2}\big((ab)y(ac)+(ac)y(ab)\big) = \frac{1}{2}\big(a(byc+cyb)a\big) = \frac{1}{2}(byc+cyb)U_a = y U_{b,c}U_a.
\]
Thus $U_{ab,ac}=U_{b,c}U_a$. Moreover, since the operators commute we have $U_{b,c}U_a = U_a U_{b,c}$.
Writing $h_i(x)g_i(x) = (x-\alpha_r 1)f_i(x)$, we have
\[
x_{ij}^{(k)} \in J U_{h_i(s)g_i(s),h_j(s)g_j(s)} = J U_{(s-\alpha_r 1)f_i(s),(s-\alpha_r 1)f_j(s)} \stackrel{(*)}{=} J U_{f_i(s),f_j(s)}U_{s-\alpha_r 1} \subseteq P_r.
\]
Since $f|_{P_r}=0$, it implies that $\sum_k f_k\left(x_{i_1j_1}^{(1)},\dots,x_{i_mj_m}^{(m)}\right)$ is zero. Since $x^{(1)},\dots,x^{(m)}$ are arbitrary, we get $f|_J=0$, a contradiction. Hence $\operatorname{spec}(s)\setminus\{0\}$ has at most $2n$ elements.
\end{proof}

\begin{lemma}
The set $S_0$ is algebraic over $F$.
\end{lemma}

\begin{proof}
Let $s \in S_0$. By the previous lemma $\operatorname{spec}(s)$ is finite. Since $F$ is infinite, $F \setminus \operatorname{spec}(s)$ is infinite and for every $\alpha \notin \operatorname{spec}(s)$ we have $s-\alpha 1$ is invertible.
Consider the set $\{(s-\alpha 1)^{-1} : \alpha \in F \setminus \operatorname{spec}(s)\}$.
This set is linearly dependent since $\#F > \dim J$. Thus there exist $\alpha_1,\dots,\alpha_m \in F \setminus \operatorname{spec}(s)$ and $\beta_i \in F$, $\beta_i \neq 0$, $i=1,\dots,m$ such that $\sum_{i=1}^m \beta_i (s-\alpha_i 1)^{-1}=0$.
Multiplying by $(s-\alpha_1 1)\cdots(s-\alpha_m 1)$ we have
\[
0 = (s-\alpha_1 1)\cdots(s-\alpha_m 1) \sum_{i=1}^m \beta_i (s-\alpha_i 1)^{-1} = \sum_{i=1}^m \beta_i f_i(s),
\]
where $f_i(s) = \frac{(s-\alpha_1 1)\cdots(s-\alpha_m 1)}{s-\alpha_i 1}$, $i=1,\dots,m$.
We have $g(x)=\sum_{i=1}^m \beta_i f_i(x) \neq 0$ since $x-\alpha_i$ divides all summands except one. On the other hand $g(s)=0$, so $s$ is algebraic over $F$.
\end{proof}

\begin{lemma}
The algebra $S_0$ is simple.
\end{lemma}

\begin{proof}
Let $I$ be a nonzero ideal of $S_0$. Since $\operatorname{Nil}(J)=0$, we have $\operatorname{Nil}(S_0)=0$. Then $I$ is not nil, is algebraic and thus contains an idempotent $e \neq 0$ (since any nonzero element in an algebraic algebra generates a finite-dimensional associative algebra).
Let $I_1 = I$, $I_{k+1} = (I_k)^3$ for all $k \geq 1$. Then for any $k \geq 1$ we have $I_k$ an ideal of $S_0$. Set $\tilde{I} = \bigcup_k I_k \subseteq S_0$.
We prove that $\tilde{I}$ is an ideal of $J$. It is enough to show that $I_{k+1} J \subseteq I_k$.
By induction, $k=1$: if $a,b,c \in I_k$ and $x \in J$, then
\[
((ab)c)x = (ab)(cx) + (ab,c,x),
\]
with $(ab)(cx) \in (I_k)^2 I_{k-1} \subseteq (I_{k-1})^3 = I_k$ and
\[
(ab,c,x) = -(ax,c,b) - (bx,c,a) \in (I_{k-1},I_k,I_k) \subseteq (I_{k-1})^3 = I_k.
\]
Then $\tilde{I} \triangleleft J$ is an ideal containing a nonzero idempotent. Thus $S_0 \subseteq \tilde{I}$. Then $S_0 \subseteq \tilde{I} \subseteq I \subseteq S_0$, so $I = S_0$.
\end{proof}

\begin{lemma}
If $F = \bar{F}$, then $S_0$ is an Albert algebra.
\end{lemma}

\begin{proof}
We have $S_0$ an algebraic algebra.
Let $e_1,\dots,e_m$ be pairwise orthogonal idempotents in $S_0$. We will show that $m \leq 2n$.
Let $s = \alpha_1 e_1 + \cdots + \alpha_m e_m \in S_0$ with $\alpha_i \neq 0$ and $\alpha_i \neq \alpha_j$ if $i \neq j$. Observe that $\alpha_i \in \operatorname{spec}(s)$ (since $s-\alpha_i 1$ is not invertible: $e_i U_{s-\alpha_i 1} = (s-\alpha_i 1)e_i(s-\alpha_i 1)=0$). Then $m \leq 2n$, where $n = \deg f$.
Since $F$ is algebraically closed, any idempotent can be decomposed into a sum of absolutely primitive idempotents, pairwise orthogonal. Let $m$ be maximal with $e = e_1+\cdots+e_m$, $e_i$ pairwise orthogonal, absolutely primitive. Then
\[
J = J_1(e) \oplus J_{1/2}(e) \oplus J_0(e)
\]
with $J_0(e)$ nil (otherwise there exists another idempotent). Thus $J_0(e)=0$.
Analogously we prove that $J_{1/2}(e)=0$. Then $J = J_1(e)$, so $e=1$.
Since $S_0$ is simple, $e_1,\dots,e_m$ are connected $\Rightarrow$ for all $i,j$ there exists $a_{ij} \in J_{ij}$ with $a_{ij}^2 = e_i + e_j$.
By the coordinatization theorem $S_0 \cong H_4(D,*)$ with $(D,*)$ alternative with involution.
If $D$ is associative, then $S_0$ is special, which does not happen since $f|_{S_0} \neq 0$. Hence $n=3$, and $(D,*)$ is simple alternative non-associative, so $S_0$ is an Albert algebra.
\end{proof}

\begin{theorem}
Let $J$ be a primitive Jordan algebra with unit over $F = \bar{F}$, and $\#F > \dim J$. If $J$ is not special, then $J$ is an Albert algebra.
\end{theorem}

\begin{proof}
We will show that $S_0 = J$.
We know $1_{S_0} = e \in S_0$. We prove next that $e \in Z(J)$ and equivalently $e \in N(J)$, since $J$ is commutative.
Let $a,b \in J$. We have
\[
(e,a,b) = (e^2,a,b) = 2(e,a,be) = 2(e^2,a,be) = 4(e,a(be),e).
\]
From $2(e,a,be)=4(e,a(be),e)$ it follows that $(e,a,be)=0$, hence $(e,a,b)=0$.
By the flexibility law $(b,a,e)=0$ as well, and since $(a,b,c)+(b,c,a)+(c,a,b)=0$, we get $(a,e,b)=0$, so $e \in Z(J)$.
For any $a \in J$ we have $a = ae + (a - ae)$; $ae \in J e$ (which is an ideal since $e \in Z(J)$) and $a-ae \in I$, with $I := \{a-ae : a \in J\}$.
We show that $I$ is an ideal of $J$: for $a,b \in J$ we have $(a-ae)b = ab - (ae)b \stackrel{e \in Z(J)}{=} ab - a(be) = a(b-be) \in I$.
Moreover $J e \cap I = 0$ because if $x = ae = b - be$, then $xe = ae = be - b(e e)=0$, so $ae=0$ and $x=0$.
Then $J = J e \oplus I$. If $I \neq 0$, $I$ would be a nonzero ideal, so $I=0$ and $J = J e = S_0$.
\end{proof}

\begin{corollary}
If $J$ is a Jordan algebra with unity, simple central over $F$ and $J$ is not special, then $J$ is an Albert algebra.
\end{corollary}
