\begin{definition}
A Jordan algebra $\mathcal{J}$ over a field $F$ is said to be of \emph{Albert type} if there exists an extension field $K \supseteq F$ such that $\mathcal{J}_K = K \otimes_F \mathcal{J}$ is an Albert algebra over $K$.
\end{definition}

\begin{lemma}
Let $I$ be an ideal of a Jordan algebra $J$. Define the annihilator of $I$ by
\[
\operatorname{Ann}(I) = \{ b \in J : \{b a x\} = 0 \text{ for all } a \in I, x \in J \} = \{ b \in J : bI = \{bIJ\} = 0 \}.
\]
Then $\operatorname{Ann}(I)$ is an ideal of $J$.
\end{lemma}

\begin{proof}
Observe that $b \in \operatorname{Ann}(I)$ if and only if $b I = 0$ and $(b J) I = 0$. Indeed, if $b I = 0$, then for any $a \in I$ and $x \in J$,
\[
\{b, a, x\} = (ba)x + (xa)b - (bx)a = 0,
\]
since $ba=0$ and $xa \in I$ so $(xa)b = b(xa)=0$. Thus $\{b a x\} = 0$ is equivalent to $(b x) a = 0$, so $(b x) I = 0$ for all $x \in J$. Hence $(b J) I = 0$. Conversely, if $b I = 0$ and $(b J) I = 0$, then clearly $\{b a x\} = 0$ for all $a \in I$, $x \in J$.

To show $\operatorname{Ann}(I)$ is an ideal, take $b \in \operatorname{Ann}(I)$ and $x \in J$. We need to show that $b x \in \operatorname{Ann}(I)$. First, $(b x) I = 0$ by the above. Next, for any $y \in J$ and $a \in I$,
\begin{align*}
((b x) y) a &= (b (x y)) a + (b, x, y) a \\
&= 0 + (b, a x, y) - (b, a, y) x \in (b, I, y) + (b, I, y) \subseteq 0,
\end{align*}
since $(b, I, y) = 0$ because $b \in \operatorname{Ann}(I)$. Thus $((b x) y) I = 0$, so $b x \in \operatorname{Ann}(I)$.
\end{proof}

For subsets $A, B$ of a Jordan algebra $\mathcal{J}$, denote $V(A, B) = \{ V_{a,b} : a \in A, b \in B \}$.

\begin{lemma}
Let $H = H(F\langle X \rangle, *)$ be the set of symmetric elements in the free associative algebra with involution. For every $a \in H$, there exists an integer $m \geq 1$ such that
\[
a \, V(P, Sy\langle x \rangle^\#)^m \subseteq Sy\langle x \rangle,
\]
where $P$ is the T-ideal generated by $\{ t(n_1, n_2, n_3)^+ : n_i \in N_t(Sy\langle x \rangle) \}$.
\end{lemma}

\begin{proof}
We first prove by induction on $s$ that for all $x, y, z, t, x_1, \dots, x_s, a \in X$ and $p \in P$,
\begin{enumerate}
\item[(i)] $\{x y z t\} R_{x_1} \cdots R_{x_s} V_{p,a} \in Sy\langle x \rangle$;
\item[(ii)] $\{x y z t\} R_{x_1} \cdots R_{x_s} R_p \in Sy\langle x \rangle$.
\end{enumerate}
For $s=0$, (ii) holds by previous results. For (i) modulo $Sy\langle x \rangle$,
\begin{align*}
\{x y z t\} V_{p,a} &= \{x y z t\} (D_{p,a} + R_{pa}) \\
&\equiv \{x y z t\} D_{p,a} \quad (\text{since } pa \in P) \\
&= (p, \{x y z t\}, a)_+ = \frac{1}{4} [\{x y z t\}, [p, a]] \\
&= \{x D_{p,a} y z t\} + \{x y D_{p,a} z t\} + \{x y z D_{p,a} t\} + \{x y z t D_{p,a}\} \equiv 0,
\end{align*}
because $x D_{p,a}, t D_{p,a} \in D_{p,a}$. So (i) holds for $s=0$.

Assume (i) and (ii) for some $s \geq 0$. Then
\begin{align*}
&\{x y z t\} R_{x_1} \cdots R_{x_{s+1}} R_p \\
&= \{x y z t\} R_{x_1} \cdots R_{x_s} R_p R_{x_{s+1}} - \{x y z t\} R_{x_1} \cdots R_{x_s} [R_p, R_{x_{s+1}}] \\
&\equiv - \{x y z t\} R_{x_1} \cdots R_{x_s} V_{p, x_{s+1}} \quad (\text{by } (*)) \\
&\equiv 0 \quad \text{by induction hypothesis,}
\end{align*}
proving (ii) for $s+1$. Next,
\begin{align*}
&\{x y z t\} R_{x_1} \cdots R_{x_{s+1}} V_{p,a} \\
&= \{x y z t\} R_{x_1} \cdots R_{x_{s+1}} (D_{p,a} + R_{pa}) \\
&= \{x y z t\} R_{x_1} \cdots R_{x_s} D_{p,a} R_{x_{s+1}} + \{x y z t\} R_{x_1} \cdots R_{x_s} [R_{x_{s+1}}, D_{p,a}] \\
&\quad + \{x y z t\} R_{x_1} \cdots R_{x_{s+1}} R_{pa}.
\end{align*}
The first term is zero by induction, the second term involves $[R_{x_{s+1}}, D_{p,a}] = R_{x_{s+1} D_{p,a}}$, and the third term is in $Sy\langle x \rangle$ by (ii). Hence (i) holds for $s+1$.

Now let $a \in H$. By Cohn's theorem, $a = j(t_1, \dots, t_r, x_1, \dots, x_l)$ with $t_i$ tetrads and $x_j \in X$. Let $d(a)$ denote the degree of $a$ in tetrads. We prove the lemma by induction on $d(a)$. If $d(a)=0$, then $a$ is already a Jordan element. Suppose $d(a) \geq 1$. Then $a$ is a sum of terms of the form $t R_{a_1} \cdots R_{a_k}$ with $t$ a tetrad and each $a_i$ a monomial in the $t_j$ and $x_j$. Without loss of generality, assume $a = t R_{a_1} \cdots R_{a_k}$ with $\sum_{i=1}^k d(a_i) = d(a)-1$. For any $p \in P$ and $x \in J$,
\[
a V_{p,x} = t R_{a_1} \cdots R_{a_k} V_{p,x} = \sum W_i,
\]
where each $W_i$ is of the form $j(a_1, \dots, a_k, x)$ and satisfies $d(W_i) < d(a)$. By the induction hypothesis, there exists $m_i$ such that $W_i V(P, Sy\langle x \rangle^\#)^{m_i} \subseteq Sy\langle x \rangle$. Taking $m = \max_i m_i$, we get $a V(P, Sy\langle x \rangle^\#)^{m+1} \subseteq Sy\langle x \rangle$.
\end{proof}

\begin{theorem}
Let $J = Sy\langle x \rangle / I$ with $P(J) = 0$ and $J$ prime. Let $\hat{I}$ be the ideal of $F\langle x \rangle$ generated by $I$, and let $f \in Sy\langle x \rangle \cap \hat{I}$. Then $f \in I$.
\end{theorem}

\begin{proof}
Write $f = \sum_{k=1}^l \{ i_k a_1^{(k)} \cdots a_{n_k}^{(k)} \}$ with $i_k \in I$. Introduce new variables $Y = \{y_1, \dots, y_s\}$ and consider the algebra $F\langle Y \cup X \rangle$. Define
\[
\tilde{f} = \sum_{k=1}^l \{ y_k a_1^{(k)} \cdots a_{n_k}^{(k)} \} \in H\langle Y \cup X \rangle.
\]
By the previous lemma, there exists $m \geq 1$ such that
\[
\tilde{f} \, V(P, Sy\langle Y \cup x \rangle^\#)^m \subseteq Sy\langle Y \cup x \rangle.
\]
Let $\varphi: Sy\langle Y \cup x \rangle \to Sy\langle x \rangle$ be the homomorphism fixing $X$ and sending $y_k$ to $i_k$. Applying $\varphi$, we obtain
\[
\varphi(\tilde{f}) = f \quad \text{and} \quad f V(P, Sy\langle Y \cup x \rangle^\#)^m \subseteq \operatorname{id}_{Sy\langle x \rangle}\langle i_1, \dots, i_l \rangle \subseteq I.
\]
Thus in $J$,
\[
\bar{f} V(P(J), J^\#)^m = 0.
\]
Since $J$ is prime and $P(J) \neq 0$, we have $\bar{f} V(P(J), J^\#)^{m-1} = 0$. Repeating, we eventually get $\bar{f} = 0$ in $J$, so $f \in I$.
\end{proof}

\begin{corollary}
Let $J$ be a simple Jordan algebra. Then one of the following holds:
\begin{enumerate}
\item $J \cong H(A,*)$ for some $*$-simple associative algebra $A$.
\item $P(J) = 0$ and $J$ satisfies additional conditions (e.g., $J$ is either a Jordan algebra of a quadratic form or associative if nondegenerate).
\end{enumerate}
\end
