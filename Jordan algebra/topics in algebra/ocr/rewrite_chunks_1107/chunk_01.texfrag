Let $A$ be an algebra. Denote by $\operatorname{rad}(A)$ the intersection of all prime ideals of $A$.

\begin{definition}
An algebra $A$ is called a \textbf{prime algebra} if for any ideals $I, J$ of $A$ we have
\[
IJ = 0 \Rightarrow I = 0 \text{ or } J = 0.
\]
An ideal $P$ of $A$ is called \textbf{prime} if $A/P$ is a prime algebra. Thus $P$ is a prime ideal if for any two ideals $I, J$ of $A$ we have $IJ \subseteq P \Rightarrow I \subseteq P$ or $J \subseteq P$.
\end{definition}

\begin{definition}
A sequence $\{a_i : a_i \in A, i \ge 1\}$ is an \textbf{$m$-sequence} if for any $i \ge 1$ we have $a_{i+1} \in (\operatorname{id}_A(a_i))^2$. We say that an element $a \in A$ \textbf{annihilates $m$-sequences} if any $m$-sequence which contains $a$ also contains zero.
\end{definition}

\begin{definition}
An algebra $A$ is called a \textbf{semi-prime algebra} if for any ideal $I$ of $A$ with $I^2 = 0$ we have $I = 0$. An ideal $P$ of $A$ is called a \textbf{semi-prime ideal} if $A/P$ is a semi-prime algebra. Thus $P$ is a semi-prime ideal if for any ideal $I$ of $A$ with $I^2 \subseteq P$ we have $I \subseteq P$.
\end{definition}

\begin{lemma}
If $a \in A$ is an element which annihilates $m$-sequences, then $a$ belongs to all semi-prime ideals of $A$.
\end{lemma}

\begin{proof}
Suppose there exists a semi-prime ideal $P$ of $A$ such that $a \notin P$. Consider $(\operatorname{id}\langle a\rangle)^2$. If $(\operatorname{id}\langle a\rangle)^2 \subseteq P$, then $\operatorname{id}\langle a\rangle \subseteq P$ and thus $a \in P$. Hence there exists $a_1 \in (\operatorname{id}\langle a\rangle)^2$ with $a_1 \notin P$. Similarly, there exists $a_2 \in (\operatorname{id}\langle a_1\rangle)^2$ such that $a_2 \notin P$. Continuing, we construct an infinite $m$-sequence $\{a, a_1, a_2, \dots\}$ containing $a$. Thus $a$ does not annihilate $m$-sequences, contradicting the hypothesis.
\end{proof}

\begin{theorem}
Let $A$ be an algebra. Then $\operatorname{rad}(A) = \{a \in A : a \text{ annihilates } m\text{-sequences}\}$.
\end{theorem}

\begin{proof}
Let $M = \{a \in A : a \text{ annihilates } m\text{-sequences}\}$. To show $\operatorname{rad}(A) \subseteq M$, it is enough to prove that if $a \notin M$, then there exists a prime ideal $P$ of $A$ such that $a \notin P$. Let $m = \{a = a_0, a_1, \dots\}$ be an $m$-sequence with $0 \notin m$. Consider
\[
\mathcal{M} = \{I \triangleleft A : m \cap I = \varnothing\}.
\]
Then $(0) \in \mathcal{M}$ and $\mathcal{M}$ is inductive. By Zorn's lemma, there exists a maximal element $P \in \mathcal{M}$. Clearly $a \notin P$. We show that $P$ is prime. Let $I, J$ be ideals of $A$ such that $IJ \subseteq P$, $I \nsubseteq P$ and $J \nsubseteq P$. Without loss of generality, we may assume $P \cap I = P \cap J = \varnothing$ (otherwise replace $I$ by $I + P$ and $J$ by $J + P$). Then there exist $a_i \in I$ and $a_j \in J$ with $a_i, a_j \notin P$. Suppose $i \le j$; then $a_j \in I$ by induction since $a_{k+1} \in (\operatorname{id}\langle a_k\rangle)^2 \subseteq I$ for $k \ge i$. Therefore
\[
a_{j+1} \in (\operatorname{id}\langle a_j\rangle)^2 \subseteq IJ \subseteq P,
\]
which implies $a_{j+1} \in P \cap m$, contradicting $P \in \mathcal{M}$. Thus $P$ is prime.

The reverse inclusion follows from the previous lemma, since any prime ideal is semi-prime.
\end{proof}

\begin{corollary}
The ideal $\operatorname{rad}(A)$ is the minimal semi-prime ideal. In particular, if $A$ is semi-prime, then $\operatorname{rad}(A) = 0$.
\end{corollary}

\begin{proof}
We show that $A/\operatorname{rad}(A)$ is semi-prime. Let $I \triangleleft A$ such that $I^2 \subseteq \operatorname{rad}(A)$. Equivalently, for each prime ideal $P$ of $A$, we have $I^2 \subseteq P$. Since $P$ is prime, this implies $I \subseteq P$. Therefore $I \subseteq \operatorname{rad}(A)$, and consequently $A/\operatorname{rad}(A)$ is a semi-prime algebra.
\end{proof}

\begin{corollary}
For any algebra $A$ we have $\operatorname{rad}(A/\operatorname{rad}(A)) = 0$.
\end{corollary}

\begin{proof}
Note that for any prime ideal $\overline{P}$ of $\overline{A} = A/\operatorname{rad}(A)$, there exists a prime ideal $P \triangleleft A$ with $\operatorname{rad}(A) \subseteq P$ and $\overline{P} = P/\operatorname{rad}(A)$. Conversely, for each prime ideal $P \triangleleft A$, the ideal $\overline{P} = P/\operatorname{rad}(A)$ is a prime ideal of $\overline{A}$. Then for any $\overline{a} \in \bigcap \{\overline{P} \triangleleft \overline{A}\}$, if $a \in A$ is such that $\overline{a} = a + \operatorname{rad}(A)$, then $a \in P$ for each prime ideal $P$ of $A$. Thus
\[
a \in \bigcap \{P \triangleleft A\} = \operatorname{rad}(A) \Rightarrow \overline{a} = \overline{0}.
\]
Consequently, $\operatorname{rad}(\overline{A}) = \bigcap \{\overline{P} \triangleleft \overline{A}\} = 0$.
\end{proof}

\begin{definition}
We say that an algebra $A$ is a \textbf{subdirect product} of algebras $\{A_\alpha : \alpha \in I\}$ if $A$ is isomorphic to a subalgebra $B \subseteq \prod_{\alpha \in I} A_\alpha$ with the property that for any $\alpha \in I$, the projection $\pi_\alpha : B \to A_\alpha$ is surjective. We write $A \simeq \prod_{\alpha \in I} A_\alpha$ in this case.
\end{definition}

\begin{proposition}
An algebra $A$ is isomorphic to a subdirect product of algebras $\{A_\alpha : \alpha \in I\}$ if and only if there exists a family of ideals $\{K_\alpha \triangleleft A : \alpha \in I\}$ such that
\begin{enumerate}
\item[(i)] for any $\alpha \in I$, $A/K_\alpha \simeq A_\alpha$,
\item[(ii)] $\bigcap_{\alpha \in I} K_\alpha = 0$.
\end{enumerate}
\end{proposition}

\begin{proof}
If $A \simeq \prod_{\alpha \in I} A_\alpha$, then $A \hookrightarrow \prod_{\alpha \in I} A_\alpha$. Let $K_\alpha = \ker \pi_\alpha \cap A$, where $\pi_\alpha : \prod A_\alpha \to A_\alpha$ is the projection. Then $K_\alpha \triangleleft A$. If $a \in \bigcap K_\alpha$, then $\pi_\alpha(a) = 0$ for all $\alpha$, so $a = 0$. Moreover,
\[
A/K_\alpha = A/(A \cap \ker \pi_\alpha) \simeq (A + \ker \pi_\alpha)/\ker \pi_\alpha \simeq \pi_\alpha(A) = A_\alpha.
\]

Conversely, if there exists $\{K_\alpha \triangleleft A : \alpha \in I\}$ with $\bigcap K_\alpha = 0$, denote $A_\alpha = A/K_\alpha$ and consider $\varphi : A \to \prod_{\alpha \in I} A_\alpha$ defined by $\varphi(a)_\alpha = a + K_\alpha \in A_\alpha$. Then $\varphi$ is a homomorphism with $\ker \varphi = \bigcap K_\alpha = 0$, so $A$ embeds into $\prod_{\alpha \in I} A_\alpha$, and $\pi_\alpha(\varphi(A)) = A_\alpha$ for all $\alpha$.
\end{proof}

\begin{corollary}
An algebra $A$ is semi-prime if and only if $A$ is isomorphic to a subdirect product of prime algebras.
\end{corollary}

\begin{proof}
If $A$ is semi-prime, then $0 = \operatorname{rad}(A) = \bigcap \{P : P \text{ prime ideal of } A\}$. By the proposition, $A$ is a subdirect product of $\{A/P : P \text{ prime ideal of } A\}$, and each $A/P$ is prime.

Conversely, if $A \simeq \prod_{\alpha \in I} A_\alpha$ with each $A_\alpha$ prime, then by the proposition there exists a family $\{P_\alpha \triangleleft A : \alpha \in I\}$ such that $A/P_\alpha \simeq A_\alpha$ and $\bigcap_{\alpha \in I} P_\alpha = 0$. Then
\[
\operatorname{rad}(A) = \bigcap \{P : P \text{ prime ideal of } A\} \subseteq \bigcap_{\alpha \in I} P_\alpha = 0,
\]
so $A$ is semi-prime.
\end{proof}

\begin{theorem}
Let $\mathcal{V}$ be a homogeneous variety of algebras with the property that locally nilpotent algebras in $\mathcal{V}$ are radical. Then for any algebra $A \in \mathcal{V}$ we have $\operatorname{LocNilp}(A) = \bigcap \{P \triangleleft A : P \text{ prime}, \operatorname{LocNilp}(A/P) = 0\}$.
\end{theorem}
