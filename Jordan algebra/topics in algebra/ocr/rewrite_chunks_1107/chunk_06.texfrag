\begin{definition}
Let $\mathcal{J}$ be a Jordan algebra. We define
\[
\delta_{\mathrm{alt}}(\mathcal{J}) = \{ z \in \mathcal{J} : (z, x, x)=0 \ \forall x \in \mathcal{J} \},
\]
the alternative center of $\mathcal{J}$. In the free Jordan algebra $F\langle x,y\rangle$ we have the identity
\[
[x, y] = -2(x^2, y, y) + 4 x \cdot (x, y, y),
\]
so in particular $[x,y]$ is a Jordan element. For $x,y \in \mathcal{J}$, we denote the element $-2(x^2, y, y) + 4x \cdot (x, y, y)$ by $[x,y]$.
\end{definition}

\begin{lemma}\label{lem:1}
Let $\mathcal{J}$ be a Jordan algebra satisfying a polynomial identity $f=0$, and suppose $\operatorname{Nil}(\mathcal{J})=0$. Then for all $a, b \in \mathcal{J}$ we have $[a, b]^2 \in Z(\mathcal{J})$.
\end{lemma}

\begin{proof}
Let $c = [a, b]^2$. To show that $c \in Z(\mathcal{J})$, we prove:
\begin{enumerate}
\item[(1)] $(c, p, p)$ is nilpotent for every $p \in \mathcal{J}$.
\item[(2)] For all $p, q \in \mathcal{J}$, $(c, p, p)q$ is nilpotent.
\item[(3)] $(c, p, p) \in \operatorname{Nil}(\mathcal{J})$ for all $p \in \mathcal{J}$ (thus $c \in \delta_{\mathrm{alt}}(\mathcal{J})$).
\item[(4)] If $z \in \delta_{\mathrm{alt}}(\mathcal{J})$ is nilpotent then $z=0$.
\item[(5)] For all $x, y \in \mathcal{J}$, $(x, c, y)$ is nilpotent.
\item[(6)] $c \in Z(\mathcal{J})$.
\end{enumerate}
For (1), consider $\mathcal{J}_0 = \operatorname{alg}\langle a, b, p \rangle$. Then $\mathcal{J}_0$ is a Jordan algebra and $f=0$ in $\mathcal{J}_0$. It suffices to show that $(c, p, p) \in \operatorname{Nil}(\mathcal{J}_0)$. We have
\[
\mathcal{J}_0 / \operatorname{Nil}(\mathcal{J}_0) \hookrightarrow \prod_\alpha \mathcal{J}_\alpha,
\]
with $\mathcal{J}_\alpha$ simple. Let $\varphi_\alpha: \mathcal{J} \to \mathcal{J}_\alpha$ be the epimorphism associated to the subdirect product. If $(c, p, p) \notin \operatorname{Nil}(\mathcal{J})$, then there exists $\alpha$ such that $\varphi_\alpha(c, p, p) \neq 0$ in $\mathcal{J}_\alpha$. In $\mathcal{J}_\alpha$, $\varphi_\alpha(c) = [\varphi_\alpha(a), \varphi_\alpha(b)]^2$. If we show that for every $x, y \in \mathcal{J}_\alpha$, $[x, y]^2 \in Z(\mathcal{J}_\alpha)$, then $\varphi_\alpha((c, p, p))=0$, a contradiction. To show that $([x, y], \mathcal{J}_\alpha, \mathcal{J}_\alpha)=0$, we prove $([x, y], \mathcal{J}_\alpha, \mathcal{J}_\alpha)=0$. If $\mathcal{J}_\alpha$ is a field, it is valid. Suppose that $\mathcal{J}_\alpha = \mathcal{J}(V, f)$. Since $[x, y] = -2(x^2, y, y) + 4x(x, y, y)$, we have
\[
(x^2, y, y) - 2x(x, y, y) = (\operatorname{tr}(x)x - n(x), y, y) - 2x(x, y, y) = \operatorname{tr}(x)(x, y, y) - 2x(x, y, y) = (\operatorname{tr}(x)-2x)(x, y, y).
\]
Observe that $\operatorname{tr}(x)-2x \in V$ (if $x = \alpha + x_1$ with $\alpha \in F$ and $x_1 \in V$, then $\operatorname{tr}(x)=2\alpha$ and $\operatorname{tr}(x)-2x = -x_1 \in V$) and $(x, y, y) \in V$ (if $y = \beta + y_1$ with $\beta \in F$ and $y_1 \in V$, then $(x, y, y) = (x, y_1, y_1) \in V$). Then $[x, y] = -2(\operatorname{tr}(x)-2x)(x, y, y) \in V \cdot V \subseteq F \cdot 1$, so $[x, y]^2 \in F \cdot 1 \subseteq Z(\mathcal{J}_\alpha)$. Thus $(c, p, p)$ is nilpotent for all $p \in \mathcal{J}$.

For (2), let $\mathcal{J}_0 = \operatorname{alg}\langle c, p, q \rangle$. We prove that $(c, p, p) \in \operatorname{Nil}(\mathcal{J}_0)$. Consider the embedding
\[
\mathcal{J}_0 / \operatorname{Nil}(\mathcal{J}_0) \hookrightarrow \prod_\alpha \mathcal{J}_\alpha.
\]
For any $\alpha$, $\mathcal{J}_\alpha$ is either a field or of type $\mathcal{J}(V, f)$. For any $\bar{p} \in \mathcal{J}_\alpha$, $(\bar{c}, \bar{p}, \bar{p})$ is nilpotent. Thus $\bar{c} \in Z(\mathcal{J}_\alpha)$ (since $\mathcal{J}_\alpha = \mathcal{J}(V, f)$). Then $(\bar{c}, \bar{p}, \bar{p})=0$, equivalently $(c, p, p) \in \operatorname{Nil}(\mathcal{J}_0)$. Consequently, $(c, p, p)q$ is nilpotent.

The proofs of (3) and (4) follow from Lemma~\ref{lem:2} and parts (1) and (2). We conclude that $(c, p, p) \in \operatorname{Nil}(\mathcal{J}) = \{0\}$, so $c \in \delta_{\mathrm{alt}}(\mathcal{J})$.

For (5), let $\mathcal{J}_0 = \operatorname{alg}\langle z, x \rangle$ with $x \in \mathcal{J}$. We show that $z \in \operatorname{Nil}(\mathcal{J}_0)$ and then by Lemma~\ref{lem:2}, $z \in \operatorname{Nil}(\mathcal{J})$.

Finally, (6) follows from the previous parts.
\end{proof}

\begin{lemma}\label{lem:identity}
Every Jordan algebra satisfies the identity
\[
n_1(x, y) \cdot x^2 - n_2(x, y) \cdot x + n_3(x, y) = 0,
\]
where
\begin{align*}
& n_1(x, y) = [x, y]^2, \quad n_2(x, y) = [x^2, y] \circ [x, y], \\
& n_3(x, y) = \frac{1}{2}\left( [x^2, y^2]^2 - 2 [y \circ x^2, x] \circ [y, x] \right).
\end{align*}
\end{lemma}

\begin{proof}
Exercise (it suffices to verify for special Jordan algebras).
\end{proof}

\begin{lemma}\label{lem:2}
Let $\mathcal{J}$ be a unital Jordan algebra over an infinite field $F$, such that for every $x, y \in \mathcal{J}$, $[x, y] \in F \cdot 1$. If there exist $a, b \in \mathcal{J}$ with $[a, b]^2 \neq 0$, then $\mathcal{J}$ is quadratic over $F$.
\end{lemma}

\begin{proof}
By Lemma~\ref{lem:identity}, if $x \in \mathcal{J}$ is such that there exists $y \in \mathcal{J}$ with $[x, y]^2 \neq 0$, then $x$ is quadratic in $\mathcal{J}$. Observe that for all $x, y \in \mathcal{J}$, $n_i(x, y) \in F \cdot 1$ because $n_2$ and $n_3$ are linearizations of $n_1$. In particular, the elements $a$ and $b$ are quadratic. For $x \in \mathcal{J}$ and $\beta \in F$, consider
\[
[a, x + \beta b]^2 = [a, x]^2 + \beta [a, x] \cdot [a, b] + \beta^2 [a, b]^2.
\]
Since $F$ is infinite, there exist $\beta_1 \neq \beta_2 \in F$ such that $[a, x + \beta_i b]^2 \neq 0$ for $i=1,2$. Then $x + \beta_i b$ is quadratic for $i=1,2$. Thus there exist $\alpha_i \in F$ such that
\[
(x + \beta_i b)^2 - \alpha_i (x + \beta_i b) \in F \cdot 1.
\]
Since $b$ is quadratic, we have
\[
x^2 + 2\beta_i (x \cdot b) - \alpha_i x \in F \cdot 1 + F \cdot b, \quad i=1,2.
\]
Multiplying the first equation by $\beta_2$ and the second by $\beta_1$ and subtracting, we obtain
\[
x^2 - \alpha x = \gamma + \delta b, \quad \alpha, \gamma, \delta \in F.
\]
Doing the same for $a$ yields
\[
x^2 - \alpha' x = \gamma' + \delta' b.
\]
If $\delta = 0$ or $\delta' = 0$, then $x$ is quadratic. If $\delta \delta' \neq 0$, then
\[
\delta^2 (\delta')^2 [a, b]^2 = [x^2 - \alpha x - \gamma, x^2 - \alpha' x - \gamma']^2 = 0,
\]
which implies $[a, b]^2 = 0$, a contradiction. Hence $\delta = 0$ or $\delta' = 0$, and $x$ is quadratic.
\end{proof}

\begin{corollary}\label{cor:quadratic}
If $\mathcal{J}$ satisfies the conditions of Lemma~\ref{lem:2}, then $\mathcal{J} \simeq \mathcal{J}(V, f)$ for some bilinear form $f$ on $V$.
\end{corollary}

\begin{proof}
It suffices to observe that any quadratic Jordan algebra is a Jordan algebra of a bilinear form. The space $V$ consists of trace-zero elements.
\end{proof}

