\begin{topic}[Week 5 (part 2)]
\[
G/C_{G}(N) = N_{G}(N)/C_{G}(N) \leqslant \operatorname{Aut}(N) = \mathbb{Z}_{p-1}.
\]

Then $G = C_{G}(N)$, so $N \leqslant Z(G)$.

\begin{corollary}
A group of order $p^{2}$ with $p$ prime is abelian.
\end{corollary}

\begin{proof}
$Z(G)$ is nontrivial.
\end{proof}

\textbf{Question:} What about $|G| = p^{3}$? (Note: $D_{8}$, $Q_{8}$ are not abelian.)

\begin{theorem}[Structure of $G$ when $|G| = p^{3}$]
Let $|G| = p^{3}$. Then either $G$ is abelian (3 types) or
\begin{enumerate}
\item for $p = 2$, $G \cong D_{8}$ or $Q_{8}$;
\item for $p \geqslant 3$, $G \cong \mathbb{Z}_{p^{2}} \rtimes \mathbb{Z}_{p}$ or $G = \langle a, b, c \mid a^{p} = b^{p} = c^{p} = 1, [a,b] = c \rangle$ (exponent $p$).
\end{enumerate}
\end{theorem}

\begin{proof}
Assume $G$ is nonabelian.

(1) Suppose $G$ has an element $a$ of order $p^{2}$.

By the above theorem, $\langle a \rangle \lhd G$. Then there is $b \in G \setminus \langle a \rangle$ and $b^{p} \in \langle a \rangle$ (since $b\langle a \rangle$ is of order $p$ in $G/\langle a \rangle$).

If $b^{p} = 1$, then $G = \langle a \rangle \rtimes \langle b \rangle$ as in (1) for $p = 2$, (2) for $p \geqslant 3$.

Suppose $|b| = p^{2}$. Then $b^{p} = a^{lp}$, $a^{b} = a^{\lambda}$ for some integer $\lambda$. If $p = 2$, then $a^{b} = a^{\lambda} = a^{-1}$ and $b^{a} = b^{\lambda} = b^{-1}$. We have $G = \langle a, b \mid a^{4} = b^{4}, a^{b} = a^{-1}, b^{a} = b^{-1} \rangle$, with unique element of order 2: $a^{2} = b^{2}$.

Suppose $p$ is odd. Then $a^{b} = a^{1+kp}$ for some $k$ with $1 \leq k \leq p-1$ (from $a^{b^{p}} = a = a^{\lambda^{p}} \Rightarrow \lambda^{p} \equiv 1 \pmod{p^{2}} \Rightarrow \lambda^{p} \equiv 1 \pmod{p} \Rightarrow \lambda^{p} \equiv \lambda \equiv 1 \pmod{p} \Rightarrow \lambda = 1 + kp$).

\textbf{Claim:} $(ba^{-l})^{p} = 1$.

We compute:
\begin{align*}
ba^{-l} \cdot ba^{-l} &= b^{2} b^{-l} a^{-l} ba^{-l} = b^{2} a^{-2l - lkp}, \\
(ba^{-l})^{p} &= b^{p} a^{-pl - lkp^{2}} = 1.
\end{align*}
Let $b' = ba^{-l}$ as in (2).

(2) Suppose $G$ does not have elements of order $p^{2}$.

Then each non-identity element of $G$ is of order $p$. Note: $p$ must be odd, since if every element of $G$ is of order 2, then $G$ is abelian.

Consider $G'$. Since $Z(G)$ is nontrivial, pick $z \in Z(G)$, then $\mathbb{Z}_{p} = \langle z \rangle \lhd G$. We have $|G/\langle z \rangle| = p^{2} \Rightarrow G/\langle z \rangle$ is abelian by the above discussion.

Hence $G' \leqslant \langle z \rangle \Rightarrow G' = \mathbb{Z}_{p} = \langle [a,b] \rangle$.

Let $c = [a,b]$. Then $a^{p} = b^{p} = c^{p} = 1$, $c = [a,b]$ as in (2). (Note: $\langle a, b \rangle \leqslant G$, $|\langle a, b \rangle| \neq p$ and $\neq p^{2}$ since $a, b$ do not commute. So $\langle a, b \rangle = G$.)
\end{proof}

\textbf{Automorphism groups of groups of order $p^{3}$:}
\begin{itemize}
\item $\operatorname{Aut}(D_{8}) \simeq D_{8}$
\item $\operatorname{Aut}(Q_{8}) \simeq S_{4}$
\item $\operatorname{Aut}(\mathbb{Z}_{p^{2}} \rtimes \mathbb{Z}_{p}) \simeq P \rtimes \mathbb{Z}_{p-1}$
\item $\operatorname{Aut}(p_{+}^{1+2}) \simeq GL(2,p)$
\end{itemize}

\begin{example}
Let $G = P_{-}^{1+2}$ or $P_{+}^{1+2}$. Then $G' = Z(G) = \mathbb{Z}_{p}$.
\end{example}

Let $\tau \in \operatorname{Aut}(G)$. Then $(G')^{\tau} = G'$ ($(z(G))^{\tau} = z(G)$), and $\tau$ induces an automorphism $\bar{\tau}$ of $G/G' \simeq \mathbb{Z}_{p} \times \mathbb{Z}_{p}$.

\begin{enumerate}
\item $G = \langle a \rangle \rtimes \langle b \rangle = \mathbb{Z}_{p^{2}} \rtimes \mathbb{Z}_{p}$, then $G' = \langle a^{p} \rangle$.

This is because $a^{b} = a^{i} \Rightarrow a^{b^{p}} = a^{ip} = a \Rightarrow i = 1 + lp \Rightarrow (a^{p})^{b} = a^{p}$.

Then $G/G' = \langle \bar{a}, \bar{b} \rangle = \mathbb{Z}_{p} \times \mathbb{Z}_{p}$ (abelian) such that $\bar{a}^{\tau} \in \langle \bar{a} \rangle$. If $(|z|, p) = 1$, then $|\bar{z}| \mid p - 1$.

\item $G = P_{+}^{1+2}$, then $\bar{z} \in \operatorname{Aut}(\langle \bar{a} \rangle \times \langle \bar{b} \rangle)$.

$\tau$ fixes $G' = \langle [x,y] \mid x,y \in G \rangle$ — bilinear form.

$\tau \in Sp(2,p) \simeq SL(2,p)$, extension by scalar multiplication.
\end{enumerate}
\end{topic}

\begin{topic}[Week 6. Free groups and minimal normal subgroups (part 1)]

\subsection*{Free Groups}

\begin{definition}[Free Group]
Let $\{x_{1}, \ldots, x_{n}\}$ be a set and $\{x_{1}', \ldots, x_{n}'\}$ such that $\{x_{1}, \ldots, x_{n}\} \cap \{x_{1}', \ldots, x_{n}'\} = \emptyset$. Let $S = \{x_{1}, \ldots, x_{n}, x_{1}', \ldots, x_{n}'\}$.

Let $X$ be the set of all words (finite sequences) composed of the elements of $S$. For $u, v \in X$,
\[
u = x_{i_1} \cdots x_{i_r}, \quad v = y_{j_1} \cdots y_{j_t},
\]
define:
\begin{enumerate}
\item $u \cdot v = x_{i_1} \cdots x_{i_r} y_{j_1} \cdots y_{j_t}$.
\end{enumerate}

Another way of definition via ``reduced words'': $x_i$ and $x_i'$ are not adjacent. If $u = u_1 x_i$ and $v = x_i' v_1$, then $uv = u_1 x_i x_i' v_1$. This identification is an equivalence relation, which gives rise to an equivalence partition of $X$. Let $[uv]$ denote the class containing $uv$. Then $[u]$ denotes the class containing $u$, and $[u][v] = [uv]$.

Then $\bar{X} = \{[u] \mid u \in X\}$ forms a group, called a \emph{free group} generated by $x_1, \ldots, x_n$, denoted by $F_n = \langle x_1, \ldots, x_n \rangle$. The integer $n$ is called the \emph{rank} of $F_n$.
\end{definition}

\begin{example}
$X = \langle x_1, x_2 \rangle$. If $g \in X$, then
\[
g = x_1^{m_1} x_2^{m_2} x_1^{m_3} \cdots x_2^{m_t} \cdots \quad \text{or} \quad x_2^{m_1} x_1^{m_2} \cdots x_1^{m_t} \cdots
\]
where $|m_i| \geq 1$.
\end{example}

\begin{example}
\begin{enumerate}
\item $X = \langle x_1, x_2 \mid x_1^2 = 1, x_2^2 = 1 \rangle$ — infinite dihedral group.
\item $X = \langle x_1, x_2 \mid x_1^2 = x_2^2 = 1, |x_1 x_2| = m \rangle$ — $D_{2m}$.
\item $X = \langle x, y \mid |x| = m, |y| = n, |xy| = l \rangle$ — triangle group.
\end{enumerate}
\end{example}

\begin{topic}[Triangle Groups $T_{m,n,l}$]
Consider $\left(\frac{1}{m} + \frac{1}{n} + \frac{1}{l}\right)$:
\begin{itemize}
\item $> \pi$: spherical
\item $= \pi$: Euclidean
\item $< \pi$: hyperbolic
\end{itemize}

WLOG, assume $m \leq n \leq l$. Then if $G \neq \mathbb{Z}_2$, $l > 1$.

\textbf{Case 1:} $\frac{1}{m} + \frac{1}{n} + \frac{1}{l} > 1$.

For $m = 2$, $n = 3 \Rightarrow l = 3$ or $4$ or $5$.

Further analysis shows $G = A_4$, $S_4$, or $A_5$.
\end{topic}

\end{topic}

\begin{topic}[Week 6. Free groups and minimal normal subgroups (part 2)]

\textbf{Case 2:}
\[
\frac{1}{m}+\frac{1}{n}+\frac{1}{l}=1
\]
The solutions are $(m, n, l)=(3,3,3)$, $(2,3,6)$, or $(2,4,4)$.

The group $G=\left\langle x, y \mid x^{m}=y^{n}=(xy)^{l}=1\right\rangle$ is infinite and solvable.

These correspond to the three regular tilings of the plane:
\begin{itemize}
    \item $(3,3,3)$: equilateral triangles
    \item $(2,3,6)$: regular hexagons (dual of equilateral triangles)
    \item $(2,4,4)$: squares
\end{itemize}
(These are the only three regular polygons that can tile the plane.)

\textbf{Case 3:}
\[
\frac{1}{m}+\frac{1}{n}+\frac{1}{l}<1
\]
The group $G=\left\langle x, y \mid x^{m}=y^{n}=(xy)^{l}=1\right\rangle$ is infinite and nonsolvable.

\begin{example}
Consider $S_{n}=\langle(12),(12\cdots n)\rangle$. Then
\[
S_{n}=\left\langle x, y \mid x^{2}=y^{n}=1,(xy)^{n-1}=1, \ldots\right\rangle.
\]
There must be additional relations. Otherwise, by the above discussion,
\[
1>\frac{1}{2}+\frac{1}{n}+\frac{1}{n-1},
\]
which would imply $S_n$ is infinite, a contradiction.
\end{example}

\begin{theorem}
Every finitely generated group is a homomorphic image of a free group. Let $G=\left\langle g_{1}, \cdots, g_{n}\right\rangle$. Then $F_{n}$ is homomorphic to $G$.
\end{theorem}

\begin{proof}
Define $\varphi: F_{n} \rightarrow G$ by $x_{i} \mapsto g_{i}$ and $x_{i}^{-1} \mapsto g_{i}^{-1}$. Let $N=\ker \varphi=\{x \mid \varphi(x)=1\}$. Then $F_{n}/N \simeq G$.
\end{proof}

We call $\{g_{1}, \ldots, g_{n}\}$ the \emph{generating elements} (or \emph{generators}) and $\{\varphi(x)=1 \mid x \in N\}$ the \emph{generating relations}.

For example,
\[
D_{2m}=\left\langle x, y \mid x^{2}=y^{2}=(xy)^{m}=1\right\rangle = \left\langle a, y \mid a^{m}=y^{2}=1, a^{y}=a^{-1}\right\rangle.
\]

\section*{Minimal Normal Subgroups}

Let $\Omega=\{1,2, \ldots, n\}$. If $H<\operatorname{Sym}(\Omega) \simeq S_{n}$ is intransitive, then $H \leq S_{K} \times S_{n-K}$ for some proper subset $K \subset \Omega$.

\end{topic}

\begin{topic}[Week 6. Free groups and minimal normal subgroups (part 3)]

Let $G \leqslant \operatorname{Sym}(\Omega) = S_n$.

\begin{definition}
A group $G$ is called a \emph{quasi-primitive group} if all its nontrivial normal subgroups are transitive.
\end{definition}

\begin{example}
Consider $G = D_{2n} < S_n$ with generators $x = (1\ 2\ \cdots\ n)$ and $y = (1\ n)(2\ n-1)\cdots$. When $n$ is even, $\{b, a^{2}b, \ldots, a^{n-2}b\} \triangleleft G$, but it has $\frac{n}{2}$ elements, so it cannot be transitive.
\end{example}

\begin{proposition}
Let $G$ be a quasi-primitive group. Let $M$ be a minimal normal subgroup of $G$. Then:
\begin{enumerate}
\item $M$ is transitive. (For an arbitrary group $G$, this is not always true; e.g., $G = \{(12)(34), (13)(24), (14)(23), 1\} < A_4$ has minimal normal subgroup $\langle(12)(34)\rangle$ which is not transitive.)
\item $M = T^{l} \simeq T_{1} \times \cdots \times T_{l}$ where $l \geqslant 1$ and $T_{1} \simeq \cdots \simeq T_{l} \simeq T$ are simple.
\end{enumerate}
\end{proposition}

\begin{lemma}
If $M \triangleleft G$ is transitive, then $G = M G_w$ for any $w \in \Omega$.
\end{lemma}

\begin{proof}
Given $g \in G$, let $w' = w^{g}$. Since $M$ is transitive on $\Omega$, there exists $m \in M$ such that $w^{m} = w^{g} = w'$. Thus $m^{-1}g = y \in G_w$, i.e., $g = my \in M G_w$.
\end{proof}

\begin{lemma}
Let $G$ be a quasi-primitive group. Then $G$ has at most two minimal normal subgroups. If $M, N$ are two minimal normal subgroups, then $M \simeq N$, and both are nonabelian and regular.
\end{lemma}

\begin{proof}
That $G$ has at most two minimal normal subgroups will be proved later.

If $M, N$ are two minimal normal subgroups, then $M \cap N = \{1\}$. So $M \times N = MN \triangleleft G$ and $M$ and $N$ commute.

\textbf{(1) Regular.} Since $N$ is transitive, for any $w, w' \in \Omega$, there exists $x \in N$ such that $w^{x} = w'$. Then
\[
M_{w'} = M_{w^{x}} = x^{-1} M_{w} x = M_{w}
\]
since $M$ and $N$ commute. So $M_w$ fixes all points $w' \in \Omega$. Then $M_w = 1$ since $M$ is faithful. Similarly $N_w = 1$.

\textbf{(2) Nonabelian.} If $M$ or $N$ is abelian, WLOG assume $M$ is abelian. Since $M$ and $N$ commute, $\langle M, x \rangle = H$ for any $x \in N$ is strictly bigger than $M$ and abelian. It is transitive, hence regular (since $H_{w} = H_{w'^{x}} = x^{-1} H_{w'} x = H_{w'}$). But for regular groups $A$, for all $g, h \in \Omega$, there exists a unique $x \in A$ such that $g^{x} = h$. Then $|A| = |\Omega|$. Since $M$ and $N$ are regular, $|M| = |N| = |\Omega|$. Hence $|H| > |\Omega|$, a contradiction. Thus $M$ and $N$ are both nonabelian.

\textbf{(3) $M \simeq N$.} Let $X = M \times N \triangleleft G$. Then $X = M X_{w} = M \rtimes X_{w}$ and
\[
X_{w} = \{(x, x') \mid x \in M, x' \in N\}
\]
where $x'$ is uniquely determined by $x$.

Define $\varphi: M \rightarrow N$ by $x \mapsto y$ if $(x, y) \in X_w$.

Prove that $\varphi$ is a homomorphism.
\end{proof}

\end{topic}

\begin{topic}[Week 7 (part 1)]

\begin{lemma}
Let $G \leqslant \operatorname{Sym}(\Omega)$ be transitive. Then $C_{\operatorname{Sym}(\Omega)}(G)$ is semiregular.
\end{lemma}

\begin{proof}
Let $C \in C_{\operatorname{Sym}(\Omega)}(G)$. For $w, w^{\prime} \in \Omega$, $\exists g \in G$ such that $w^{g}=w^{\prime}$. Then $C_{w^{\prime}}=C_{w^{g}}=C_{w}^{g}=g^{-1}C_{w}g=C_{w}$. So $C_{w}=1$ and $C$ is semiregular.
\end{proof}

\begin{corollary}
A transitive abelian permutation group $G$ is regular.
\end{corollary}

\begin{proof}
$G \leqslant C_{\operatorname{Sym}(\Omega)}(G)$.
\end{proof}

\begin{theorem}[from last time]
Let $G$ be a quasi-primitive group. Then $G$ has at most two minimal normal subgroups. If $G$ has two minimal normal subgroups $M, N$, then $M \simeq N$, and $M, N$ are regular and nonabelian.
\end{theorem}

\begin{proof}
$M, N$ regular (use lemma). $X=MN=M \times N$. $\Rightarrow M \leqslant C_{\operatorname{Sym}(\Omega)}(N)$ $\Rightarrow M$ is regular, so is $N$. Also $M \simeq N$.

For $w \in \Omega$, $X_{w}=\{(x, x^{\prime}) \mid x \in M, x^{\prime} \in N\} \leqslant M \times N$.

Let $\varphi: M \rightarrow N$ by $x \mapsto x^{\prime}$. This is surjective and injective by comparison.
\end{proof}

Case: assume that $G$ has a unique minimal normal subgroup $N$.

\begin{lemma}
Let $G$ have a unique minimal normal nonabelian subgroup $N$. Then $C_{G}(N)=\{1\}$, so $G \leqslant \operatorname{Aut}(N)$ by $N/C$ lemma.
\end{lemma}

\begin{proof}
Since $N$ is nonabelian, $N \neq C_{G}(N)$. Since $C_{G}(N) \triangleleft G$, it would contain a minimal normal subgroup if $C_{G}(N) \neq \{1\}$, contradiction. Thus $C_{G}(N)=\{1\}$.
\end{proof}

Thus:
\begin{enumerate}
\item If $N=\mathbb{Z}^{n}$, then $N$ is regular.
\item If $N$ is nonabelian simple, then $N \triangleleft G \leqslant \operatorname{Aut}(N)$.
\item Let $N=T^{k}$ where $k \geqslant 2$ and $T$ is nonabelian simple:
\begin{enumerate}[(i)]
\item $N$ is regular $\Leftrightarrow N_{w}=1$ TW (twisted wreath product).
\item $N_{w} \cong T$ \quad SD$_{k}$ (simple diagonal).
\item $N_{w} \simeq T^{m}$, $2 \leqslant m \leqslant \frac{k}{2}$ \quad CD (compound diagonal).
\item $1 \neq N_{w} \neq T^{m}$ for $m \geqslant 1$ \quad PA (product action).
\end{enumerate}
\end{enumerate}

\begin{theorem}[O'Nan--Scott--Praeger]
Let $G$ be a quasi-primitive group. Then one of the following holds:
\begin{enumerate}
\item $G$ has exactly two minimal normal subgroups $M \simeq N$ \quad HS (holomorph simple).
\item $G$ has two minimal normal subgroups $M \simeq N \simeq T^{k}$ with $k \geqslant 2$ \quad HC type (holomorph compound).
\item $G$ has a unique minimal normal abelian subgroup \quad HA type (holomorph affine).
\item $G$ has a unique minimal normal subgroup $N$, simple and nonabelian \quad AS type (almost simple).
\item $G$ has a minimal normal nonabelian regular subgroup.
\item Case (3)(ii) above.
\item Case (3)(iii).
\item Case (3)(iv).
\end{enumerate}
\end{theorem}

\textbf{Case 1:} $G \leqslant \operatorname{Sym}(\Omega)$ quasi-primitive. Let $M, N \triangleleft G$. Then $M \simeq N$, nonabelian, regular. So $M \times N$ and $|\Omega|=|M|=|N|$.

Fix $w \in \Omega$. For any $w^{\prime} \in \Omega$, $\exists! x \in M$ such that $w^{x}=w^{\prime}$.

$\Rightarrow$ There is a $1$--$1$ correspondence between $\Omega$ and $M$ by
\[
% [OCR unclear - correspondence not fully specified]
\]

\end{topic}

\begin{topic}[Week 7 (part 2)]

\begin{align*}
w & \mapsto 1 \\
w' & \mapsto x'.
\end{align*}

Relabel:
\begin{align*}
\Omega &= \{w_1, w_2, \ldots, w_n\} \quad \text{where} \quad \Omega \to M, \; w_i \mapsto h, \\
M &= \{1 = x_1, x_2, \ldots, x_n\}, \quad w_i \mapsto x_i, \; w_i = w_1^{x_i}.
\end{align*}

\begin{lemma}[Relationship between $\hat{g}$, $\tilde{g}$, right/left multiplication]
Let $G$ be a finite group. Fix $g \in G$. Define permutations on $G$:
\begin{align*}
\hat{g} &: x \mapsto xg, \\
\tilde{g} &: x \mapsto g^{-1}x, \\
\bar{g} &: x \mapsto gx^{-1}.
\end{align*}
Then:
\begin{align*}
\hat{G} &= \{\hat{g} \mid g \in G\}, \\
\tilde{G} &= \{\tilde{g} \mid g \in G\}, \\
\bar{G} &= \{\bar{g} \mid g \in G\}.
\end{align*}
\end{lemma}

\begin{enumerate}
\item $\hat{G}, \tilde{G} \leqslant \operatorname{Sym}(G)$, and both are regular.
\item $\langle \hat{G}, \tilde{G} \rangle = \hat{G}\tilde{G} = \hat{G} \cdot \tilde{G}$, central product, with $\hat{G} \cap \tilde{G} = Z(\hat{G}) = Z(\tilde{G})$.
\item Let $X = \hat{G}\tilde{G}$, $X_1 = \tilde{G}$, then $X = \hat{G}:\tilde{G} = \tilde{G}:\hat{G}$.
\end{enumerate}

\begin{definition}[Central Product $M \circ N$ or $M * N$]
Let $C_1 \leq Z(M)$, $C_2 \leq Z(N)$ with $C_1 \simeq C_2$ via isomorphism $\varphi \colon C_1 \to C_2$. Set
\[
C = \{(c, c^\varphi) \mid c \in C_1\} \simeq C_1.
\]
The \emph{central product} is defined as
\[
M \circ N = M \times N / C.
\]
Usually when $C$ is maximal, i.e., $Z(M) \simeq Z(N) \simeq C$, this is called the \emph{standard central product}.
\end{definition}

\begin{example}
\begin{enumerate}
\item $Q_8 \times Q_8$: Here $Z = \{1, -1\} \cong Z_2$. Let $Z = \langle c_1 \rangle = \langle c_2 \rangle$. Then
\[
Q_8 \times Q_8 / \langle(c_1, c_2)\rangle = Q_8 \circ Q_8,
\]
with $|Q_8 \circ Q_8| = 32$.

\item $Q_8 \circ Z_4 = Q_8 \times Z_4 / \langle(c_1, c_2)\rangle$.

\item Let $M = Z_8 : Z_2$ with $\langle a \rangle : \langle z \rangle$ and $a^z = a^5$. Then $(a^2)^z = a^{10} = a^2$, so $a^2 \in Z(M) = \langle a^2 \rangle \cong Z_4$.

Let $N = \langle b \rangle : \langle y \rangle$ with $b^y = b^5$.
\end{enumerate}
\end{example}

\end{topic}

\begin{topic}[Week 7 (part 3)]

\textbf{Central products.} Let $C_{2} \in Z(N) = Z_{4}$. If $|c_{1}| = |c_{2}| = 4$, then
\[
M \times N / \langle(c_{1}, c_{2})\rangle = M \cdot N
\]
is a central product. If $|k_{1}| = |k_{2}| = 2$, then
\[
M \times N / \langle(c_{1}, c_{2})\rangle = M \circ N.
\]

\begin{lemma}
\begin{enumerate}
\item $\hat{G}$ is a group: if $\hat{g}, \hat{h} \in \hat{G}$, then $\hat{g}\hat{h} = \widehat{gh} \in \hat{G}$. Similarly $\tilde{G}$ is a group, since
\[
x^{\tilde{g}\tilde{h}} = (x^{\tilde{g}})^{\tilde{h}} = (g^{-1}x)^{\tilde{h}} = h^{-1}g^{-1}x = x^{\widetilde{gh}}.
\]
Moreover, for any $x, y \in \Omega (= G)$, $\hat{g} = x^{-1}y$ maps $x$ to $y$, so $\hat{G}$ is transitive. Thus $G$ is regular since $|\hat{G}| = |G|$.

\item Let $\hat{g} \in \hat{G}$ and $\tilde{h} \in \tilde{G}$.

\textbf{Claim:} $\hat{g}\tilde{h} = \tilde{h}\hat{g}$ in $\operatorname{Sym}(\Omega)$.

For $x \in G$, we have
\begin{align*}
x^{\hat{g}\tilde{h}} &= (x^{\hat{g}})^{\tilde{h}} = (xg)^{\tilde{h}} = h^{-1}xg, \\
x^{\tilde{h}\hat{g}} &= (x^{\tilde{h}})^{\hat{g}} = (h^{-1}x)^{\hat{g}} = h^{-1}xg.
\end{align*}
Hence $\hat{G}$ and $\tilde{G}$ commute and $\langle\hat{G}, \tilde{G}\rangle = \hat{G}\tilde{G}$. Moreover, $\hat{G} \cap \tilde{G} = 1$ since $\hat{G}$ and $\tilde{G}$ commute.

The map $\varphi\colon M \times N \to MN$ given by $(m,n) \mapsto mn$ is a homomorphism since $\hat{G}$ and $\tilde{G}$ commute. We have
\[
\ker\varphi = \{(\hat{g}, \tilde{g}) \mid g \in Z(G)\}, \quad \hat{g} \in Z(M).
\]

\item Let $X = \langle\hat{G}, \tilde{G}\rangle = \hat{G} \circ \tilde{G}$. Then
\[
X_{w} = \{(\hat{g}, \tilde{g}) \mid g \in G\}
\]
and $x^{(\hat{g}, \tilde{g})} = g^{-1}xg$, where $w = 1 \in G$.

Since $\hat{G}$ is regular, $\hat{G} \cap X_{w} = 1$ and $\hat{G} \triangleleft X$. Thus $X_{1} = \tilde{G}$ and
\[
X = \hat{G} \rtimes X_{w} = \hat{G} \rtimes \tilde{G}.
\]
So $\hat{G}\tilde{G} = \hat{G} \rtimes \tilde{G} = \tilde{G} \rtimes \hat{G}$ (internal semidirect product).
\end{enumerate}
\end{lemma}

In particular, if $Z(G) = 1$, then $\hat{G} \times \tilde{G} \cong G \times G$.

\textbf{Return to case (1).} Identify $\Omega$ with $M$. Then $\hat{M}$ acts regularly on $M$ by right multiplication. Let $X = M \times N < \operatorname{Sym}(\Omega)$. Then
\[
X_{w} = \{(g, g') \mid g \in M\}.
\]
Define $\varphi\colon M \to N$ by $g^{\varphi} = g'$. Then $X = \hat{M} \rtimes M$ acts on $M$. We aim to prove the two actions are equivalent.

Recall $\tilde{\omega} \mapsto 1\mu$ and $X_{w} = \{(g, g') \mid g \in M\}$.

\end{topic}

\begin{topic}[Week 7 (part 4)]
Let $X_{1} = \{(\hat{g}, \check{g}) \mid g \in M\}$. Let $\varphi: M \rightarrow N$ be such that $g^{\prime} = g^{\varphi}$.

We have $(g, 1) \mapsto (\hat{g}, 1)$ and $M \times \{1\} \rightarrow \{1\} \times M$. 

Now $X = MN = M \times N = M \times M = \hat{M} \times \hat{M}$, so $M \equiv \hat{M}$ and $N \equiv \check{M}$.

Suppose $Z(a^{2})^{3} = 1$. Let $M < \operatorname{Sym}(\Omega)$ be regular. Then $\operatorname{C}_{\operatorname{Sym}(\Omega)}(M) \geqslant N$, and by the lemma, $\operatorname{C}_{\operatorname{Sym}(\Omega)}(M) = N$.

Note that $M$ is transitive and $\operatorname{C}_{\operatorname{Sym}(\Omega)}(M)$ is semiregular. Similarly, $\operatorname{C}_{\operatorname{Sym}(M)}(\hat{M}) = \check{M}$.

\begin{lemma}
Let $M < \operatorname{Sym}(\Omega)$ be regular. Then, identifying $\Omega$ with $M$, the action of $M$ on $\Omega$ is equivalent to the action of $\hat{M}$ on $M$.
\end{lemma}

\begin{proof}
Let $\Omega = \{w_{1}, w_{2}, \ldots, w_{n}\}$ where $w_{i} = w_{1}^{g_{i}}$, and let $M = \{1 = g_{1}, g_{2}, \ldots, g_{n}\}$. 

Under the identification $w_{i} \mapsto g_{i}$, we have $w_{i}^{g} = w_{1}^{g_{i}g} \mapsto g_{i}g$. Thus $(g_{i})^{g} = g_{i}g$, and the actions are equivalent.
\end{proof}

Moreover, $N = \operatorname{C}_{\operatorname{Sym}(\Omega)}(M) = \operatorname{C}_{\operatorname{Sym}(M)}(\hat{M}) = \check{M}$.
\end{topic}

\begin{topic}[Week 8 holomorph (part 1)]

\begin{corollary}
Each regular action of a group $X$ is equivalent to $\hat{X}$ acting on $X$.
\end{corollary}

\textbf{Proof.} We only prove for $X$. Let $\varphi\colon X \to \Omega$. Define
\[
\varphi\colon x_i \mapsto w x_i^{-1}, \quad x_v \mapsto x, \quad x_j \mapsto x_j.
\]
This yields $x_i^{x_j} = x_j^{-1} x_i \mapsto x_i^{-1} x_j = (w^{x_i^{-1}}) x_j$. Then $\varphi$ is $H$-equivariant and $\rho$ is an isomorphism. Hence the two actions are equivalent.

\begin{definition}[Holomorph]
Let $G$ be a group. The \emph{holomorph} of $G$ is $\mathrm{Hol}(G) = G \rtimes \mathrm{Aut}(G)$. Explicitly,
\[
\mathrm{Hol}(G) = \{(g, \theta) \mid g \in G, \theta \in \mathrm{Aut}(G)\}
\]
with multiplication
\[
(g_1, \theta_1)(g_2, \theta_2) = (g_1 \theta_1(g_2), \theta_1 \theta_2).
\]
\end{definition}

\textbf{Case (1): Holomorph simple.} Let $M \times N \triangleleft G \leq \mathrm{Sym}(\Omega)$ where $M \simeq N \simeq T$ is simple. Then
\[
M \rtimes \mathrm{Inn}(M) \leq G \leq M \rtimes \mathrm{Aut}(M).
\]

\textbf{Proof.} For the left-hand side: $\hat{M} \times \hat{M} = M \times N \triangleleft G$, and $\hat{M} \cong M$ gives $M \rtimes \mathrm{Inn}(M)$. For the right-hand side: $G = M \rtimes G_w \leq \mathrm{Sym}(\Omega)$. Identifying $M$ with $\Omega$, we have
\[
G = \hat{M} \rtimes G_1 \leq \mathrm{Sym}(M).
\]

\textbf{Claim:} $G_1 \leq \mathrm{Aut}(M)$. For all $\theta \in G_1$, we have $\theta^{-1} \hat{m} \theta = \hat{m}'$ for some $m' \in M$. Then $\theta^{-1} \hat{m} \theta(1) = \hat{m}'(1)$ implies $\theta(m) = m'$. Let $\theta^{-1} \hat{m} \theta = \hat{m}'$ and $\theta^{-1} \hat{n} \theta = \hat{n}'$. Then $\theta^{-1} \hat{m}\hat{n} \theta = \hat{m}'\hat{n}'$, which yields $\theta(mn) = m'n' = \theta(m)\theta(n)$. Hence $G_1 \leq \mathrm{Aut}(M)$.

\begin{lemma}[Frattini Argument]
Let $H < G \leq \mathrm{Sym}(\Omega)$ such that $G$ is transitive on $\Omega$. Then $H$ is transitive on $\Omega$ if and only if $G = H G_w$ (i.e., for all $g \in G$, there exist $x \in H$ and $y \in G_w$ such that $g = xy$).
\end{lemma}

\begin{lemma}
Let $M \triangleleft G \leq \mathrm{Sym}(\Omega)$ such that $M$ is regular on $\Omega$. Then $G = M \rtimes G_w$ where $w \in \Omega$.
\end{lemma}

\textbf{Case (2): Holomorph compound.} Let $M \times N \triangleleft G \leq \mathrm{Sym}(\Omega)$ where $M \simeq N = T^\ell$ with $\ell \geq 2$ and $T$ nonabelian simple. Then
\[
M \rtimes \widetilde{M} \leq G \leq M \rtimes \mathrm{Aut}(M)
\]
where $\mathrm{Aut}(M) = \mathrm{Aut}(T) \wr S_\ell$ (wreath product). Here $M \simeq N = T^\ell = T_1 \times \cdots \times T_\ell$ where $T \simeq T_1 \simeq \cdots \simeq T_\ell$, and $G$ induces a transitive action on $\{T_1, \ldots, T_\ell\}$.

\end{topic}

\begin{lemma}
A quasiprimitive permutation group of type HS, HC, or HA is primitive.
\end{lemma}

\begin{topic}[Blocks and Block Systems]
Let $G$ be a transitive permutation group on $\Omega$.

\textbf{Definition.}
\begin{enumerate}
\item A subset $B \subseteq \Omega$ is called a \emph{block} if for any element $g \in G$, $B^{g} = \{\omega^{g} \mid \omega \in B\}$ satisfies either $B^{g} = B$ or $B^{g} \cap B = \emptyset$.
\item For a block $B$, the set $\mathcal{B} = \{B^{g} \mid g \in G\}$ is called a \emph{block system} for $G$ on $\Omega$.
\end{enumerate}
\end{topic}

\begin{topic}[Properties of Blocks]
Write $\mathcal{B} = \{B_{1}, B_{2}, \ldots, B_{m}\}$.
\begin{enumerate}
\item Each $B_{i}$ is a block.
\item $B_{i} \cap B_{j} = \emptyset$ for all $i \neq j$.
\item $|B_{1}| = \cdots = |B_{m}|$.
\item $G$ induces a transitive action on $\mathcal{B}$.
\end{enumerate}
\end{topic}

\begin{definition}[Primitive and Imprimitive]
If there exists a block $B$ for $G$ on $\Omega$ with $1 < |B| < |\Omega|$ (i.e., a nontrivial block), then $G$ is said to be \emph{imprimitive} on $\Omega$. Otherwise, $G$ is said to be \emph{primitive}.
\end{definition}

\begin{lemma}
A transitive group $G \leqslant \operatorname{Sym}(\Omega)$ is primitive if and only if $G_{\omega}$ is a maximal subgroup of $G$.
\end{lemma}

\begin{proof}
$(\Rightarrow)$ Assume otherwise: $G$ is imprimitive on $\Omega$, and let $B$ be a nontrivial block. Let $\omega \in B$. Then
\[
G_{\omega} \neq G_{B} = \{g \in G \mid B^{g} = B\}.
\]
(There exists $\omega' \neq \omega$ in $B$ and $g \in G$ such that $\omega^{g} = \omega'$; then $g \in G_{B}$ but $g \notin G_{\omega}$.) That is, $G_{\omega} < G_{B} < G$.

$(\Leftarrow)$ If $G_{\omega} < H < G$, then $B := \omega^{H}$ is a block.
\begin{enumerate}
\item $B^{g} \cap B = \emptyset$ or $B^{g} = B$: Let $g \in G$ and suppose $\delta \in B^{g} \cap B$. Then $\omega^{h_{1}g} = \omega^{h_{2}}$ for some $h_{1}, h_{2} \in H$, so $h_{1}gh_{2}^{-1} \in G_{\omega} < H$. Since $h_{1}, h_{2} \in H$, we have $g \in H$, hence $B^{g} = B$.
\item $B$ is a nontrivial block: If $H$ is transitive, then $G = HG_{\omega} = H$, a contradiction. Hence $H$ is not transitive and $1 < |B| < |\Omega|$.
\end{enumerate}
\end{proof}

\begin{proof}[Proof of Lemma (Case HA)]
Let $G$ be of type HA. Then $G = M \rtimes G_{\omega}$ where $M$ is an abelian unique minimal normal subgroup.

Suppose $G$ is imprimitive on $\Omega = M$. Then $G_{\omega} < H < G$, and $1 \neq H \cap M = M_{0} < M$. (If $H \cap M = 1$, then $G = M \rtimes H$, contradiction.) Then $M_{0} \triangleleft M$, $M_{0} \triangleleft H$, and $M_{0} \triangleleft \langle H, M \rangle = G$, contradicting $M$ being minimal normal and $M$ abelian.
\end{proof}

\begin{example}
A group can be quasiprimitive but not primitive. (Note that primitive implies quasiprimitive.)

\textbf{Proof that primitive implies quasiprimitive:} Let $H \triangleleft G$.
\begin{enumerate}
\item If $H < G_{\omega}$ for some $\omega \in \Omega$, then $H < G_{\omega^{x}}$ for any $x \in G$. Hence $H$ fixes every element in $\Omega$. Since $G$ is faithful, $H = 1$.
\item If $H \not\leq G_{\omega}$ for any $\omega \in \Omega$, then $HG_{\omega}$ is a group strictly larger than $G_{\omega}$, so $G = HG_{\omega}$.
\end{enumerate}

Let $G$ be a non-abelian simple group. Then $\hat{G}$ is a quasiprimitive group on $G$, but $\hat{G}$ is not primitive since $\hat{G}_{\omega} = 1$ is not maximal in $\hat{G}$.
\end{example}

\begin{topic}[Week 9 (part 1)]

\textbf{HS type} (HC type $\ast$ (homework)).

Let $G = T{:}H$ with $\operatorname{Inn}(T) \leqslant H \leqslant \operatorname{Aut}(T)$.

\begin{itemize}
\item $H$ can be $G_w$ with $w = 1 \in T$ (or any other $w'$).
\item Claim: $G$ is primitive on $\Omega (\equiv T)$ ($\Leftrightarrow G_w$ is maximal).
\end{itemize}

\begin{proof}
Suppose $H \leqslant K \leqslant G$. Then an element $g \in K \setminus H$ has the form $g = (t, h) \in G = T{:}H$ such that $t \neq 1$. Thus $(t, 1) = (t, h)(1, h^{-1}) \in K$.

For any element $x \in H$, we have $(1, x^{-1}) \in K$ and
\[
(1, x^{-1})(t, 1) = (t^{x^{-1}}, x^{-1}) \in K,
\]
so $(t^{x^{-1}}, x^{-1})(1, x) = (t^{x^{-1}}, 1) \in K$.

Let $M = \langle (t^{x}, 1) \mid x \in H \rangle \leqslant T \times \{1\}$.

Since $H \geqslant \operatorname{Inn}(T)$, the action of $T$ on $M$ by conjugation fixes $M$, so $M \trianglelefteq T$. Since $T$ is simple, $\langle M, H \rangle = \langle T, H \rangle = T{:}H = G \leqslant K$. So $H$ is a maximal subgroup of $G$ and $G$ is primitive on $\Omega$.
\end{proof}

\begin{corollary}
This provides a way to construct primitive groups. For $T$ simple, let $G = T \times T = T{:}\widetilde{T} = T{:}\operatorname{Inn}(T)$ (since $T$ simple, $Z(T)$ is trivial, hence semidirect product).
\end{corollary}

\end{topic}

\begin{topic}[Notation]

Let $G \leqslant \operatorname{Sym}(\Omega)$, $|\Omega| = n$.

\begin{itemize}
\item For $\Delta \subseteq \Omega$ and $g \in G$, let $\Delta^{g} = \{\delta^{g} \mid \delta \in \Delta\}$.
\item For $w_{1}, w_{2} \in \Omega$, write $w_{1} \sim w_{2}$ if $w_{1}^{g} = w_{2}$ for some $g \in G$.
\item $w^{G} = \{w^{g} \mid g \in G\}$ is the \emph{orbit} of $w$.
\item $G_{w} = \{g \in G \mid w^{g} = w\}$ is the \emph{stabilizer} of $w$.
\end{itemize}

\end{topic}

\begin{topic}[Subgroups and Actions on Subsets]

For $\Delta \subseteq \Omega$, let
\[
G_{\Delta} = \{g \in G \mid \Delta^{g} = \Delta\}
\]
and
\[
G_{(\Delta)} = \{g \in G \mid w^{g} = w \text{ for all } w \in \Delta\}.
\]

Then $G_{(\Delta)} \trianglelefteq G_{\Delta}$ and $G_{\Delta}$ acts on $\Delta$ with kernel $G_{(\Delta)}$.

We have:
\begin{itemize}
\item $g^{-1}G_{w}g = G_{w^{g}}$
\item $g^{-1}G_{\Delta}g = G_{\Delta^{g}}$
\item $g^{-1}G_{(\Delta)}g = G_{(\Delta^{g})}$
\end{itemize}

The group $G_{\Delta}$ acting on $\Delta$ induces a permutation group on $\Delta$, denoted by $G_{\Delta}^{\Delta}$, and $G_{\Delta}^{\Delta} \simeq G_{\Delta}/G_{(\Delta)}$.

\end{topic}

\begin{topic}[Fixed Points]

\begin{itemize}
\item $\operatorname{Fix}_{\Omega}(G) = \{w \in \Omega \mid w^{g} = w \text{ for all } g \in G\}$, the set of fixed points of $G$ on $\Omega$.
\item $\operatorname{Fix}_{\Omega}(g) = \{w \in \Omega \mid w^{g} = w\}$, the set of fixed points of $g$ on $\Omega$.
\end{itemize}

\end{topic}

\begin{definition}[Semiregular]
$G$ is said to be \emph{semiregular} on $\Omega$ if $G_{w} = \{1\}$ for each point $w \in \Omega$.
\end{definition}

\begin{itemize}
\item $|G| = $ length of each orbit $\Rightarrow |G| \mid |\Omega|$.
\item If $G$ is transitive and semiregular, then $G$ is \emph{regular} on $\Omega$ and $|G| = |\Omega|$.
\end{itemize}

\begin{definition}[Coset Action]
Let $G$ be a group and $H \leqslant G$. Let $\Omega = [G:H] = \{Hg \mid g \in G\}$. Define an action of $G$ on $\Omega$ by
\[
(Hg) \cdot x = H(gx) \in [G:H] \quad \text{for all } Hg \in \Omega \text{ and } x \in G,
\]
i.e., $x\colon Hg \mapsto Hgx$.
\end{definition}

\begin{topic}[Week 9 (part 2)]
\begin{itemize}
\item A coset action is transitive: $\left(Hg_{1}\right)^{g_{1}^{-1} g_{2}}=Hg_{2}$.
\item The kernel of this action is $G(\Omega)=\bigcap_{g \in G} g^{-1} H g$.
\end{itemize}

Denote $G(\Omega)$ by $M$. Then $M=\bigcap_{g \in G} g^{-1} H g \triangleleft G$, $M \leqslant H$, and $M$ is the largest normal subgroup of $G$ contained in $H$, called the \emph{core} of $H$ in $G$, denoted by $\mathrm{Core}(H)$.

\begin{proposition}
$G/\mathrm{Core}_{G}(H) \simeq G^{\Omega}$ is a transitive permutation group on $\Omega=[G:H]$.
\end{proposition}

\begin{itemize}
\item If $\mathrm{Core}_{G}(H)=1$, then the action is said to be \emph{faithful} ($H$ is core-free in $G$). Otherwise the action is unfaithful.
\end{itemize}

\begin{theorem}
Each transitive permutation group is equivalent to a faithful coset action.
\end{theorem}

\begin{proof}
Let $G$ be a transitive permutation group on $\Omega$, i.e., $G \leqslant \mathrm{Sym}(\Omega)$ is transitive. Let $H=G_{w}$ with $w \in \Omega$ and let $\Sigma=[G:H]$. Then for $C=Hg$ and $x \in G$, $C^{x}=(Hg)^{x}=Hgx \in \Sigma$.

\[
\begin{array}{llll}
\Omega: & w, w^{g_{1}}, w^{g_{2}}, & \ldots, & w^{g_{n}} \\
\Sigma: & H, Hg_{1}, Hg_{2}, & \ldots, & Hg_{n}
\end{array}
\]

For $x \in G$:
\[
\begin{aligned}
x\colon w^{g_{i}} &\mapsto w^{g_{j}} \\
Hg_{i} &\mapsto Hg_{j}.
\end{aligned}
\]

$H$ is core-free in $G$, i.e., $\mathrm{Core}_{G}(H)=1$, meaning $H$ does not contain a non-identity normal subgroup of $G$.

Suppose $N \leqslant H$ and $N \triangleleft G$. Then $N=N \cdot w$ since $N \leqslant H$. For $x \in G$, $Nw=N=x^{-1}Nx=x^{-1}N_{w}x=N_{w}x$, so $N$ fixes every point of $\Omega$. We then must have $N=1$ as $G \leqslant \mathrm{Sym}(\Omega)$. Thus $\mathrm{Core}_{G}(H)=1$ and $G$ acts on $\Sigma$ faithfully.
\end{proof}

\begin{definition}[Equivalence of actions]
Let $G$ act on $\Omega$ and $\Sigma$ transitively and faithfully. Then $G^{\Omega}$ and $G^{\Sigma}$ are said to be \emph{equivalent} if there is a bijection $\varphi\colon \Omega \to \Sigma$ such that for any $w \in \Omega$ and $g \in G$,
\[
\varphi(w^{g}) = \varphi(w)^{g}.
\]
\end{definition}

\begin{example}
Are the following actions equivalent?
\[
\begin{aligned}
G &= S_{4} \text{ on } \{1,2,3,4\}\\
H_{1} &= \langle(12)\rangle\\
H_{2} &= \langle(12)(34)\rangle\\
H_{3} &= \langle(13)\rangle
\end{aligned}
\]
Let $\Omega_{i}=[G:H_{i}]$. Compare $G^{\Omega_{1}}$, $G^{\Omega_{2}}$, and $G^{\Omega_{3}}$.

\textbf{(1) $G^{\Omega_{1}}$ and $G^{\Omega_{2}}$:} Note that $H_{1}(12)=H_{1}$. If $H_{1} \mapsto H_{2}g$ for some $g \in G$, then we must have $H_{2}g=H_{2}g(12)$, which means either
\[
\begin{cases}
g(12)=g, \quad \text{or}\\
g(12)=(12)(34)g.
\end{cases}
\]
Both are not possible. Hence $G^{\Omega_{1}}$ and $G^{\Omega_{2}}$ are not equivalent.

\textbf{(2) $G^{\Omega_{1}}$ and $G^{\Omega_{3}}$:} We may take $H_{1} \mapsto H_{3}(23)$. Define $\varphi\colon [G:H_{1}] \to [G:H_{3}]$ by
\[
\varphi(H_{1}g) = H_{3}(23)g.
\]
One checks that $\varphi$ is well-defined and gives an equivalence.
\end{example}
\end{topic}

\begin{topic}[Week 9 (part 3)]
Indeed, if $H_{1} g_{1} = H_{1} g_{2}$, then $g_{1} g_{2}^{-1} \in H_{1} = H_{3}$. Hence
\[
(23) H_{3}(23) g_{1} = (23) H_{3}(23) g_{2} \Rightarrow H_{3}(23) g_{1} = H_{3}(23) g_{2}.
\]

\begin{theorem}[Criterion for equivalence]
The transitive actions $G^{\Omega}$ and $G^{\Sigma}$ are equivalent if and only if $G_{w}$ and $G_{\delta}$ are conjugate in $G$.
\end{theorem}

\begin{proof}
($\Leftarrow$) The defined map is well-defined.

($\Rightarrow$) $\Omega \to \Sigma$: $g^{-1} G_{\delta} g \subset G_{w}$.

$\Sigma \to \Omega$: $g^{-1} G_{w} g \subset G_{\delta}$.
\end{proof}
\end{topic}

\begin{topic}[Week 10]

\begin{exercise}
Characterize quasiprimitive permutation groups $G \leqslant \operatorname{Sym}(\Omega)$ such that $G_{\omega}$ has $r$ orbits on $\Omega$ where $r = 2, 3, 4, 5$. If $G$ is of holomorph simple type, then $r \geqslant$ ?
\end{exercise}

\begin{theorem}[Burnside]
A $2$-transitive permutation group is affine (holomorph affine) or almost simple (AS). For all such groups, $\operatorname{rank}(G) = 2$.
\end{theorem}

\begin{definition}[Rank]
Let $G \leqslant \operatorname{Sym}(\Omega)$ be transitive. Then $G$ induces an action on $\Omega \times \Omega = \{(\omega_{1}, \omega_{2}) \mid \omega_{1}, \omega_{2} \in \Omega\}$ by
\[
(\omega_{1}, \omega_{2})^{g} = (\omega_{1}^{g}, \omega_{2}^{g}) \quad \forall g \in G.
\]
Then $G$ acts intransitively and partitions $\Omega \times \Omega$ into $G$-orbits.

The number of $G$-orbits is called the \emph{rank} of $G$ on $\Omega$, denoted by $\operatorname{rank}(G)$.
\end{definition}

\begin{itemize}
\item $\{(\omega, \omega) \mid \omega \in \Omega\}$ is an orbit, so $\operatorname{rank}(G) \geqslant 2$.
\item If $\operatorname{rank}(G) = 2$, then $G$ is called \emph{$2$-transitive}.
\item A $2$-transitive group is primitive.
\item If $G$ is $2$-transitive on $\Omega$, then:
\begin{enumerate}[(i)]
\item $G_{\omega}$ is faithful and transitive on $\Omega \setminus \{\omega\}$.
\item $|\Omega| - 1$ divides $|G_{\omega}|$.
\item If $N \triangleleft G$, then $N_{\omega}$ is \emph{half-transitive} on $\Omega \setminus \{\omega\}$, i.e., all $N_{\omega}$-orbits have the same size.
\end{enumerate}
\end{itemize}

\textbf{Note:} (iii) uses the following lemma with $N_{\omega} = N \cap G_{\omega}$ and $G_{\omega}$ where $G_{\omega}$ is transitive on $\Omega \setminus \{\omega\}$.

\begin{lemma}
Let $G \leqslant \operatorname{Sym}(\Omega)$ be transitive. If $1 \neq N < G$ is intransitive, then the $N$-orbits on $\Omega$ form a nontrivial block system and $N$ is half-transitive.
\end{lemma}

\begin{proof}
Let $\Delta_{1}, \Delta_{2}$ be two $N$-orbits. Choose $\delta_{i} \in \Delta_{i}$ with $i = 1, 2$. Then $\delta_{1}^{g} = \delta_{2}$ for some $g \in G$.

Write $\Delta_{1} = \{\delta_{1}^{x_{1}}, \delta_{1}^{x_{2}}, \ldots, \delta_{1}^{x_{t}}\}$ with $x_{i} \in N$. Then
\[
(\delta_{1}^{x_{i}})^{g} = \delta_{1}^{g g^{-1} x_{i} g} = (\delta_{1}^{g})^{g^{-1} x_{i} g} = \delta_{2}^{g^{-1} x_{i} g} \in \Delta_{2}.
\]
So $\Delta_{1}^{g} \subseteq \Delta_{2}$. Similarly $\Delta_{2}^{g^{-1}} \subseteq \Delta_{1}$, so $|\Delta_{1}| = |\Delta_{2}|$.
\end{proof}

\begin{corollary}
If $G$ is primitive, then $G$ is quasiprimitive.
\end{corollary}

\textbf{Proof of Theorem.} Let $G \leqslant \operatorname{Sym}(\Omega)$ be $2$-transitive. Let $N \triangleleft G$ such that $N = T^{k}$ with $k \geq 2$ and $T$ nonabelian simple.

\begin{lemma}
$N$ does not have a proper normal subgroup which is regular on $\Omega$ (i.e., $G$ is not HS, HC, SD, or CD).
\end{lemma}

\begin{proof}
Suppose $M \triangleleft N$ is regular on $\Omega$. Then $|\Omega| = |M|$ and $N_{\omega} \neq 1$ (since $M < N$) is half-transitive on $\Omega \setminus \{\omega\}$. Let $m$ be the size of an orbit of $N_{\omega}$ on $\Omega \setminus \{\omega\}$. Then $m \mid |\Omega \setminus \{\omega\}|$ and $m \mid |N_{\omega}|$. Thus $m \mid \gcd(|M| - 1, |N_{\omega}|)$.

Now $|M| = |T|^{l}$ for $l < k$, and $N = M \rtimes N_{\omega}$ so that $|N_{\omega}| = |T|^{k-l}$. Thus
\[
m \mid \gcd(|T|^{l} - 1, |T|^{k-l}) = 1 \Rightarrow m = 1,
\]
a contradiction (since $N_{\omega}$ is faithful on $\Omega \setminus \{\omega\}$).
\end{proof}

\begin{lemma}
$N$ is not regular on $\Omega$ (i.e., $G$ is not TW).
\end{lemma}

\begin{proof}
Suppose $N$ is regular on $\Omega$. Then $G = N \rtimes G_{\omega}$ and $N \cap G_{\omega} = N_{\omega} = 1$. Hence $G = N \rtimes G_{\omega}$, and $\Omega$ can be identified with $N$ with $\omega \mapsto 1$, so that $G_{\omega}$ acts on $N$ by conjugation:
\[
\omega^{n} \mapsto n; \quad \omega^{ng} = \omega^{g^{-1}ng} \mapsto g^{-1}ng = n^{g}.
\]
The action of $G_{\omega}$ partitions $N$ into orbits and fixes $1$.

Note that elements of $N$ in the same orbit have the same order.

Clearly $|N|$ has at least $3$ prime divisors $r, s, t$. (For $N = T^{k}$ where $k \geq 2$ and $T$ nonabelian simple, $N$ is not solvable, while groups of odd order are solvable, and groups of order $p^{a} q^{b}$ are solvable by Burnside.)

Then there exist $x, y, z \in N$ such that $|x| = r$, $|y| = s$, $|z| = t$. Thus $x^{G_{\omega}}$, $y^{G_{\omega}}$, $z^{G_{\omega}}$ are $3$ distinct orbits of $G_{\omega}$ on $N$. Since $\operatorname{rank}(G) = \#$ of $G_{\omega}$-orbits on $\Omega$, we have $\operatorname{rank}(G) \geqslant 4$, a contradiction.
\end{proof}

\begin{remark}
An example with $\operatorname{rank}(G) = 4$: If $N = T = A_{5}$, then $(r, s, t) = 2, 3, 5$. With $G_{\omega} = S_{5}$, we have $\operatorname{rank}(G) = 4$ (HS type).
\end{remark}

\begin{lemma}
% [OCR unclear - content continues]
\end{lemma}

\end{topic}

\begin{topic}[Week 10. (part 2)]

Let $G$ be $2$-transitive and let $N \trianglelefteq G$ be a minimal normal subgroup such that $N = T^{k}$ with $k \geqslant 2$ and $T$ nonabelian simple. Then $N$ is the unique minimal normal subgroup. Now $G$ acts on $\Omega$ by
\[
(\delta_{1}, \ldots, \delta_{k})^{(z_{1}, \ldots, z_{k})\pi} = (\delta_{1}^{z_{1}\pi^{-1}}, \ldots, \delta_{k}^{z_{k\pi^{-1}}})
\]
(sometimes called type PA, i.e., $G$ acts on $\Omega$ in product action).

\begin{proof}
$N_{\omega} \neq 1$. Write $N = T_{1} \times \cdots \times T_{k}$ where $T_{1} \simeq \cdots \simeq T_{k}$. Let $H_{i}$ be the projection image of $N_{\omega}$ into $T_{i}$: for $g \in N_{\omega} < T_{1} \times \cdots \times T_{k}$, write $g = (t_{1}, \ldots, t_{k})$ where $t_{i} \in T_{i}$, and project to $t_{i}$.

Let $M_{i} = \prod_{j \neq i} T_{j}$. Then $M_{i} \triangleleft N$ and $N/M_{i} \cong T_{i}$. Then $H_{i} = N_{\omega}/(N_{\omega} \cap M_{i}) \cong N_{\omega}M_{i}/M_{i}$, and $H_{i} \leq T_{i}$ with $H_{1} \simeq H_{2} \simeq \cdots \simeq H_{k}$. If not, any orbit is a proper smaller normal subgroup.

Since $G = NG_{\omega}$ is transitive on $\{T_{1}, \ldots, T_{k}\}$ (as $T_{i}^{g} \triangleleft N \Rightarrow T_{i}^{g} = T_{j}$ for some $j$, for all $g \in G$), and $N$ acts trivially on $\{T_{1}, \ldots, T_{k}\}$ by conjugation, so $G_{\omega}$ is transitive on $\{T_{1}, T_{2}, \ldots, T_{k}\}$. Also, $G_{\omega}$ normalizes $N_{\omega}$, so $G_{\omega}$ is transitive on $\{H_{1}, \ldots, H_{k}\}$ by conjugation.

Then $N_{\omega} \leqslant H_{1} \times \cdots \times H_{k} \leqslant N$ and $K = H_{1} \times \cdots \times H_{k}$ is normalized by $G_{\omega}$. Thus $G_{\omega} \leqslant KG_{\omega} < G$. Since $G$ is primitive, $G_{\omega}$ is maximal. Then $G_{\omega} = KG_{\omega} \Rightarrow K = N_{\omega} \leqslant G_{\omega}$ (so $K \leqslant N$ and $K \leqslant G_{\omega}$).

% [OCR unclear: argument about $KG_{\omega} \neq G$]

Consider $N = T_{1} \times \cdots \times T_{k}$ acting on $\Omega$. Identify $\Omega$ with $[N:N_{\omega}]$:
\[
\Omega = [N:N_{\omega}] = [T_{1} \times \cdots \times T_{k} : H_{1} \times \cdots \times H_{k}] = [T_{1}:H_{1}] \times \cdots \times [T_{k}:H_{k}].
\]

with $N$ acting on $\Omega$ defined by
\[
w(t_{1}, \ldots, t_{k}) = (H_{1}x_{1}, \ldots, H_{k}x_{k})^{(t_{1}, \ldots, t_{k})} = (H_{1}x_{1}t_{1}, \ldots, H_{k}x_{k}t_{k})
\]
where $w = (H_{1}x_{1}, \ldots, H_{k}x_{k})$.

We have $G_{\omega} \leqslant (L_{1} \times \cdots \times L_{k}){:}S_{k}$ where $H_{i} \leqslant L_{i} \leqslant \operatorname{Aut}(T_{i})$, and
\[
G \leqslant (\operatorname{Aut}(T_{1}) \times \cdots \times \operatorname{Aut}(T_{k})){:}S_{k} = (T_{1} \times \cdots \times T_{k}){:}(\operatorname{Out}(T_{1}) \times \cdots \times \operatorname{Out}(T_{k})){:}S_{k}
\]
(since $C_{G}(N) = 1$).

Write $g = (z_{1}, \ldots, z_{k})\pi$ where $z_{i} \in \operatorname{Aut}(T_{i})$, $\pi \in S_{k}$. Let $w = (\delta_{1}, \ldots, \delta_{k}) \in \Delta_{1} \times \cdots \times \Delta_{k}$, $g = (\tau_{1}, \ldots, \tau_{k})\pi$. Then
\begin{align*}
w^{g} &= (\delta_{1}, \ldots, \delta_{k})^{(z_{1}, \ldots, z_{k})\pi} \\
&= (\delta_{1}^{z_{1}}, \ldots, \delta_{k}^{z_{k}})^{\pi} \\
&= (\delta_{1\pi^{-1}}^{z_{1\pi^{-1}}}, \ldots, \delta_{k\pi^{-1}}^{z_{k\pi^{-1}}}) \in \Delta^{k}.
\end{align*}
\end{proof}

\begin{example}
Let $G = (\operatorname{Aut}(T) \times \operatorname{Aut}(T)){:}S_{2}$, $\Omega = \Delta_{1} \times \Delta_{2} = \Delta^{2}$, and $G_{\omega} = (L_{1} \times L_{2}){:}S_{2}$ where $H_{i} \leq L_{i} \leq \operatorname{Aut}(T_{i})$.

For instance, let $\Delta = \{0,1,2,3,4\}$, so $\Omega = \Delta^{2} = \{(i,j) \mid 0 \leq i, j \leq 4\}$. Fix $\omega = (0,0)$.
\end{example}

\end{topic}

\begin{topic}[Week 10. (part 3)]
\[
G_{\omega} = (\operatorname{Alt}(1,2,3,4) \times \operatorname{Alt}(1,2,3,4)) : \pi
\]
where $\pi: (t_1, t_2) \mapsto (t_2, t_1)$.

Then $G_\omega$ partitions $\Omega \setminus \{\omega\} = \Delta^2 \setminus \{(0,0)\}$ into two orbits:
\begin{itemize}
\item $\{(0, i), (i, 0) \mid 1 \leq i \leq 4\}$
\item $\{(i, j) \mid 1 \leq i, j \leq 4\}$
\end{itemize}

We have $(0,1) \xrightarrow{((12), (12)(34))} (0,2)$ and $(0,1) \xrightarrow{\pi} (1,0)$. Also $(1,1) \xrightarrow{((k_1, k_2), (k_1', k_2'))} (1,j)$. Thus $\operatorname{rank}(G) = 3$.

\begin{lemma}[HW]
Let $G = (T \times T) : S_2$ acting on $\Omega = \Delta^2$ in product action. Then $G$ is of rank at least $3$, and $\operatorname{rank}(G) = 3$ if and only if $T$ is $2$-transitive on $\Delta$.
\end{lemma}

\begin{exercise}
Let $G = (T \times T \times T) : S_3$ act on $\Omega = \Delta^3$ in product action. Find a sharp lower bound for $\operatorname{rank}(G)$.

\textbf{Clue:} Let $\Delta = \{0, 1, \ldots, n-1\}$, $\Omega = \Delta^k = \{(\delta_1, \ldots, \delta_k)\}$, and $\omega = (0, \ldots, 0)$. For $w \in \Omega$, define $\operatorname{weight}(w) = \#\{i : \delta_i \neq 0\}$. Then elements of the same weight lie in the same orbit.
\end{exercise}
\end{topic}

\begin{topic}[Week 11 (part 1)]

$\operatorname{rank}(G)=3$

\begin{theorem}
If $\operatorname{rank}(G)=3$ and $G$ is quasi-primitive on $\Omega$, then $G$ is HA, AS or $N=T^{2}$ and $G$ acts on $\Omega=\Delta^{2}$ in product action with $T$ on $\Delta$ being 2-transitive.
\end{theorem}

Counterexample: $G=A_{5}:S_{5} = \operatorname{Aut}(A_{5})$ has $\operatorname{rank}(4)$. $A_{5}$ acts on $A_{5}$ by right multiplication. $S_{5}=G_{w}$ acts on $A_{5}$ by conjugation (proved below in Lemma 1). Identify $w$ with $1$. Then orbits of $G_{1}$ are conjugacy classes of $A_{5}$ under $S_{5}$:
\[O_{1}=\{1\}, \quad O_{2}=\{(ij)(kl)\}, \quad O_{3}=\{(ijk)\}, \quad O_{4}=\{(ijklm)\}.\]

\begin{lemma}
Let $M \triangleleft G$. $G$ be regular on $\Omega$. Then $\operatorname{rank}(G) \geqslant$ number of fusion classes of elements of $M$ (orbits under $\operatorname{Aut}(M)$).

In particular, if $M=T^{k}$ with $T$ nonabelian simple, then $\operatorname{rank}(G) \geqslant 4$. (This implies $G$ is not of type HS, HC, TW.)
\end{lemma}

\begin{proof}
Identify $\Omega$ with $M$. Let $w \equiv 1$. Then $G=M:G_{w}$ and $G_{w}$ acts on $M \equiv \Omega$ by conjugation.

$G$ acts on $\Omega=[G:G_{w}]=\{G_{w}g \mid g \in G\}$. For $h \in G_{w}$: $G_{w}g \xrightarrow{h} G_{w}gh = G_{w}h^{-1}gh = G_{w}g^{h}$.

Let $g \in M \Rightarrow g^{h} \in M$.

Now the action of $G_{w}$ on $M$ partitions into orbits, i.e., fusion classes of $M$ since $G_{w} \leqslant \operatorname{Aut}(M)$. So $\operatorname{rank}(G) \geqslant \#$ of fusion classes of $M$.

Suppose $M=T^{k}$ with $T$ nonabelian simple $\Rightarrow M$ not solvable ($|M| \neq p^{a}q^{b}$). Then there exist distinct primes $r, s, t$ dividing $|M|$. Let $x, y, z \in M$ s.t. $|x|=r$, $|y|=s$, $|z|=t$. Then $x^{G_{w}}, y^{G_{w}}, z^{G_{w}}$ are three different fusion classes of $M$. So $\operatorname{rank}(G) \geqslant 4$.
\end{proof}

\begin{lemma}
Let $G$ be a quasi-primitive group of type SD (simple diagonal). Then $\operatorname{rank}(G) \geqslant 4$.
\end{lemma}

\begin{proof}
Let $N=T^{k} \triangleleft G$ and write $N=T_{1} \times \cdots \times T_{k}$ where $T_{1} \simeq \cdots \simeq T_{k} \simeq T$. % [OCR unclear for some details]

$N$ is regular on $\Omega$ ($N=N_{w}$ is transitive). Identify $\Omega$ with $[N:N_{w}]=\{N_{w}(t_{1},\ldots,t_{k}) \mid t_{i} \in T\}$, where $N_{w}(t_{1},\ldots,t_{k})=\{(s t_{1},\ldots,s t_{k}) \mid s \in T\}$ with a representative $(t_{k}^{-1}t_{1},\ldots,t_{k}^{-1}t_{k-1},1) \in N$.

Observe $N_{w}(s_{1},\ldots,s_{k-1},1)=N_{w}(t_{1},\ldots,t_{k-1},1) \Leftrightarrow (s_{1},\ldots,s_{k-1},1)=(t_{1},\ldots,t_{k-1},1)$.

Now, the stabilizer $G_{w}$ satisfies $N_{w} \cdot P \leqslant G_{w} \leqslant \operatorname{Aut}(T) \times S_{k}$ where $P \leqslant S_{k}$ is transitive. ($G_{w}$ acts by conjugation: $N_{w} \leqslant G$, $G_{w}$ acts on $T_{i}$ transitively and acts faithfully on $N$ as $C_{G}(N) \cap N=\{1\} \Rightarrow C_{G}(N)=\{1\}$. $G_{w} \leqslant \operatorname{Aut}(T) \times S_{k}$ as $G_{w}$ stabilizes $N_{w}$, and $\operatorname{Aut}(T) \times S_{k}$ is a direct product as $\operatorname{Aut}(T) \times \cdots \times \operatorname{Aut}(T)$ becomes $\operatorname{Aut}(T)$, thus $S_{k}$ acts on $\operatorname{Aut}(T)$ trivially.)

Each element of $G_{w}$ has the form $\alpha\pi$ with $\alpha \in \operatorname{Aut}(T)$ and $\pi \in S_{k}$, and an element $(t_{1},\ldots,t_{k}) \in N$ is sent by $\alpha\pi$ to $(t_{1},\ldots,t_{k})^{\alpha\pi}=(t_{1}^{\alpha},\ldots,t_{k}^{\alpha})^{\pi} \in N$.

Pick two elements $x:=(s_{1},1,\ldots,1)$, $y:=(t_{1},1,\ldots,1) \in N \setminus \{(1,\ldots,1)\}$.

Then $x, y$ lie in the same orbit of $G_{w}$ iff $\exists \alpha\pi \in G_{w}$ s.t.
\[(s_{1},1,\ldots,1)=(t_{1},1,\ldots,1)^{\alpha\pi}=(t_{1}^{\alpha},1,\ldots,1)^{\pi}.\]

\begin{enumerate}
\item If $1^{\pi}=1$, then $(s_{1},1,\ldots,1)=(t_{1}^{\alpha},1,\ldots,1)$ so $s_{1}=t_{1}^{\alpha}$, i.e., $s_{1}, t_{1}$ are conjugated by $\alpha \in \operatorname{Aut}(T)$.

\item If $1^{\pi}=k$, then $(s_{1},1,\ldots,1)=(1,\ldots,1,t_{1}^{\alpha}) = ((t_{1}^{\alpha})^{-1},\ldots,(t_{1}^{\alpha})^{-1},1) \in N$. So $s_{1}=(t_{1}^{\alpha})^{-1}=(t_{1}^{-1})^{\alpha}$ and $k=2$ (otherwise $(t_{1}^{\alpha})^{-1}=1$, impossible).

\item If $1^{\pi}=j \notin \{1,k\}$, say $1^{\pi}=2$ wLOG. Then $(s_{1},1,\ldots,1)=(1,t_{1}^{\alpha},1,\ldots,1) \in N$ so $s_{1}=1$, contradiction.
\end{enumerate}

Therefore $(s_{1},1,\ldots,1)$ and $(t_{1},1,\ldots,1)$ lie in the same orbit of $G_{w}$ either if $s_{1}=t_{1}^{\alpha}$ or $k=2$ and $s_{1}=(t_{1}^{-1})^{\alpha}$.

Thus $\operatorname{rank}(G) \geqslant \#$ of orbits of $\operatorname{Aut}(T)$ on $\{t, t^{-1} \mid t \in T\}$. This is $\geqslant 4$ (three distinct primes divide the order of the group; two elements of distinct order are not conjugate nor inverse-conjugate under $\operatorname{Aut}(T)$).
\end{proof}

\end{topic}

\begin{topic}[Week 11 (part 2)]
\begin{definition}[Wreath Product]
The \emph{wreath product} is defined as
\[
G = T \wr S_{k} = T^{k} \rtimes S_{k},
\]
where the semidirect product is defined by the action
\[
(t_{1}, t_{2}, \ldots, t_{k})^{\pi} = (t_{1\pi^{-1}}, t_{2\pi^{-1}}, \ldots, t_{k\pi^{-1}}).
\]
Equivalently, the multiplication of two elements is given by
\[
\bigl((s_{1}, \ldots, s_{k})\pi_{1}\bigr)\bigl((t_{1}, t_{2}, \ldots, t_{k})\pi_{2}\bigr) = (s_{1}t_{1}^{\pi_{1}}, s_{2}t_{2}^{\pi_{1}}, \ldots, s_{k}t_{k}^{\pi_{1}})\pi_{1}\pi_{2}.
\]
\end{definition}

\begin{definition}[Product Action]
Let $T$ be a transitive permutation group on $\Delta = \{0, 1, \ldots, m-1\}$. For an integer $k \geq 2$, let $P \leq S_{k}$ be transitive, and let
\[
G = T \wr P \leq T \wr S_{k} \quad \text{and} \quad \Omega = \Delta^{k}.
\]
Then $G$ acts on $\Omega$ naturally by
\[
(\delta_{1}, \ldots, \delta_{k})^{(t_{1}, \ldots, t_{k})\pi} = \bigl(\delta_{1}^{t_{1\pi^{-1}}}, \ldots, \delta_{k}^{t_{k\pi^{-1}}}\bigr).
\]
In this way, $G$ is said to be acting on $\Omega = \Delta^{k}$ in \emph{product action}, or $G$ is a \emph{blow-up} of $T$ on $\Delta$.
\end{definition}

Fix a point $w_{0} = (0, \ldots, 0)$. For a point $w = (\delta_{1}, \ldots, \delta_{k}) \in \Omega$, define the \emph{weight} of $w$:
\[
\mathrm{weight}(w) = \bigl|\{i \mid \delta_{i} \neq 0\}\bigr|,
\]
the number of nonzero entries of $w$. The action of each element $(t_{1}, \ldots, t_{k})\pi \in G_{w_{0}}$ preserves the weight of every point of $\Omega$. Thus $w_{1}$ is not equivalent to $w_{2}$ under $G_{w_{0}}$ if $\mathrm{weight}(w_{1}) \neq \mathrm{weight}(w_{2})$.

\begin{lemma}[Case: Product Action]
Using the notation defined above ($G = T \wr P \leq T \wr S_{k}$):
\begin{enumerate}
\item $\mathrm{rank}(G) \geq k + 1$.
\item $\mathrm{rank}(G) = 3$ if and only if $k = 2$ and $T$ is $2$-transitive on $\Delta$.
\end{enumerate}
\end{lemma}

\begin{proof}
(1) The weight function takes values in $\{0, 1, \ldots, k\}$. So $G_{w_{0}}$ has at least $k + 1$ orbits on $\Omega$.

(2) Assume $\mathrm{rank}(G) = 3$. Then $k = 2$ (since $k \geq 2$), and $\Omega = \Delta \times \Delta$ with $G = (T \times T) \rtimes S_{2}$. The points of weight equal to $1$ form one orbit of $G_{w_{0}}$, so $\{(\delta_{1}, 0) \mid \delta_{1} \in \Delta \setminus \{0\}\}$ is an orbit of $T_{0}$, i.e., $T$ is $2$-transitive on $\Delta$. The converse is straightforward.
\end{proof}
\end{topic}

\begin{topic}[Week 12 Examples]

Let $V = F^{d}$ ($d > 1$) and let $G = \mathrm{GL}(V)$ act on $V$ with orbits $\{0\}$ and $V \setminus \{0\} := \Omega$.

\begin{itemize}
\item $G$ acting on $\Omega$ is transitive.
\end{itemize}

\begin{enumerate}
\item If $|F| > 2$, then the action is imprimitive.

\textbf{Proof:} The sets $\{\langle v \rangle \mid v \in V \setminus \{0\}\}$ form a block system $\mathcal{B}$. Note that $|\langle v \rangle| = |F| - 1$.

\item If $|F| = 2$, then the action is $2$-transitive.

\textbf{Proof:} Let $(u_1, u_2), (v_1, v_2) \in \Omega \times \Omega$ with $u_1 \neq u_2$ and $v_1 \neq v_2$. Then $u_1, u_2$ are linearly independent, and so are $v_1, v_2$. Extend to bases $\{u_1, \ldots, u_d\}$ and $\{v_1, \ldots, v_d\}$. There exists $g \in \mathrm{GL}(V)$ such that $u_i^g = v_i$ for all $i$.

\item If $|F| > 2$, $G = \mathrm{GL}(V)$ acts on $\mathcal{B}$ transitively, with kernel equal to $Z(G)$. Then $G/Z(G) = \mathrm{PGL}(V)$ is $2$-transitive on $\mathcal{B}$.

\item $\mathrm{PGL}(V)$ on $\mathcal{B}$ is not $3$-transitive if $d > 2$.

\textbf{Proof:} For $d > 2$, choose one set of linearly independent vectors and one set of linearly dependent vectors.

For $d = 2$: Let $\langle u_1 \rangle, \langle u_2 \rangle, \langle u_3 \rangle$ be pairwise different, and $\langle v_1 \rangle, \langle v_2 \rangle, \langle v_3 \rangle$ be pairwise different. Then $u_1$ and $u_2$ are linearly independent, and $u_3 = a u_1 + b u_2$ with $a, b \in F^\times$. Similarly, $v_1$ and $v_2$ are linearly independent, and $v_3 = c v_1 + d v_2$ with $c, d \in F^\times$.

We need to find $g \in \mathrm{GL}(V)$ such that $(u_1, u_2)^g = (v_1, v_2)$ and
\[
u_3^g = (a u_1 + b u_2)^g = a v_1 + b v_2 = v_3 = c v_1 + d v_2.
\]
So define $g$ by $u_1 \mapsto (c/a) v_1$ and $u_2 \mapsto (d/b) v_2$, then $u_3 \mapsto v_3$.
\end{enumerate}

Suppose $|F| > 2$. Then $\mathrm{GL}(V)$ acting on $V \setminus \{0\} = \Omega$ is transitive and imprimitive, of rank
\[
1 + 1 + |F^\times| - 1 = |F| \quad \text{($F$ finite)}.
\]

\textbf{Proof:} The rank of $G^\Omega$ equals the number of $G$-orbits on $\Omega \times \Omega$. Consider the sets:
\[
\{(u, v) \mid \langle u \rangle = \langle v \rangle, \, u, v \in \Omega\}, \qquad \{(u, v) \mid \langle u \rangle \neq \langle v \rangle, \, u, v \in \Omega\}.
\]
If $(u, \lambda u) \mapsto (v, \lambda' v)$ under $g$, then $u^g = v$ and $\lambda u^g = \lambda v$, so $\lambda = \lambda'$. This partitions into $|F^\times| - 1$ orbits.

\medskip

Let $N = \mathbb{Z}_p^d$ with $p$ prime and $d \geq 1$. Then $H = \mathrm{Aut}(N) = \mathrm{GL}_d(p)$. Let $G = N \rtimes H$. Let $\Omega = N$ and define an action of $G = \mathbb{Z}_p^d \rtimes \mathrm{GL}_d(p)$ on $\Omega$ by
\[
w^{xy} = (w + x)^y = w^y + x^y \in N,
\]
where the operation in $N$ is addition.

\begin{proposition}
$G$ is an affine $2$-transitive permutation group on $\Omega$. Furthermore, if $p = 2$, then $G$ is $3$-transitive.
\end{proposition}

\textbf{Proof:} Let $(u_1, u_2), (v_1, v_2) \in \Omega \times \Omega$. We need $xy = g \in N \rtimes H$ such that
\[
(u_1, u_2)^{xy} = (v_1, v_2),
\]
i.e.,
\[
\bigl((u_1 + x)^y, (u_2 + x)^y\bigr) = (v_1, v_2).
\]
% [OCR unclear: remaining details of proof]

Equivalently, $G$ is $2$-transitive on $\Omega$ if and only if $G_w$ is transitive on $\Omega \setminus \{w\}$.

\end{topic}

\begin{topic}[Week 12 Examples (part 2)]

\begin{remark}
It is easy to see that $N$ is a minimal normal subgroup. Every normal subgroup either equals $N$ or is trivial. $N$ is transitive on itself, so $G$ is quasi-primitive $\Rightarrow$ affine.
\end{remark}

Let $y$ map linearly dependent (l.d.) vectors to l.d.\ vectors and linearly independent (l.i.) vectors to l.i.\ vectors.

\textbf{Case 1:} Both pairs l.i. There exists $y \in G$ mapping one pair to the other.

\textbf{Case 2:} $u_1, u_2$ l.i.\ and $v_1, v_2$ l.d. Let $x = au_1 + bu_2$.
\begin{align*}
u_1 + x &= (1+a)u_1 + bu_2 \\
u_2 + x &= au_1 + (1+b)u_2 \quad (\lambda \neq 1).
\end{align*}
Then $(1+a)u_1 + bu_2 = \lambda(au_1 + (1+b)u_2)$, which gives:
\[
1+a = \lambda a \Rightarrow a = \frac{1}{\lambda-1}, \qquad b = \lambda(1+b) \Rightarrow b = \frac{\lambda}{1-\lambda}.
\]

\textbf{Case 3:} $u_1, u_2$ l.d.\ and $v_1, v_2$ l.i. Let $x$ be a l.i.\ combination of $u_1$, then $u_1 + x$ and $u_2 + x$ are l.i.

\textbf{Case 4:} $u_1, u_2$ l.d.\ and $v_1, v_2$ l.d. Let $u_1 = \lambda u_2$ and $v_1 = \lambda' v_2$ with $\lambda, \lambda' \neq 1$. Let $x = yu_2$.
\[
\frac{x+u_1}{x+u_2} = \frac{\lambda+y}{1+y} = x' \Rightarrow (x'-1)y = \lambda - x', \qquad y = \frac{\lambda - x'}{x'-1}.
\]

\begin{definition}[$k$-transitive]
$G$ is said to be \emph{$k$-transitive} on $\Omega$ if for any $k$-tuples $(\omega_1, \ldots, \omega_k)$ and $(\mu_1, \ldots, \mu_k)$ where the $\omega_i$'s are distinct and the $\mu_i$'s are distinct, there exists $g \in G$ such that $(\omega_1, \ldots, \omega_k)^g = (\mu_1, \ldots, \mu_k)$, i.e., $\omega_i^g = \mu_i$ for all $i$.
\end{definition}

\begin{proposition}
$G$ is $k$-transitive if and only if $G_\omega$ is $(k-1)$-transitive on $\Omega \setminus \{\omega\}$ and $G$ is transitive on $\Omega$.
\end{proposition}

\begin{proof}
($\Rightarrow$) Clear.

($\Leftarrow$) Let $(\omega_1, \ldots, \omega_k)$ and $(\mu_1, \ldots, \mu_k)$ be $k$-tuples with distinct entries. We need to find $g \in G$ such that $(\omega_1, \ldots, \omega_k)^g = (\mu_1, \ldots, \mu_k)$.

Since $G$ is transitive on $\Omega$, there exist $g_1, g_2 \in G$ such that $\omega_1^{g_1} = \omega$ and $\mu_1^{g_2} = \omega$. Then:
\begin{align*}
(\omega_1, \ldots, \omega_k)^{g_1} &= (\omega, \omega_2^{g_1}, \ldots, \omega_k^{g_1}), \\
(\mu_1, \ldots, \mu_k)^{g_2} &= (\omega, \mu_2^{g_2}, \ldots, \mu_k^{g_2}).
\end{align*}
Since $G_\omega$ is $(k-1)$-transitive on $\Omega \setminus \{\omega\}$, there exists $g \in G_\omega$ such that $(\omega_2^{g_1}, \ldots, \omega_k^{g_1})^g = (\mu_2^{g_2}, \ldots, \mu_k^{g_2})$. Thus $(\omega_1, \ldots, \omega_k)^{g_1 g g_2^{-1}} = (\mu_1, \ldots, \mu_k)$.
\end{proof}

\begin{question}
When is a group sharply $2$-transitive? (A proper subgroup is no longer $2$-transitive.)
\end{question}

\begin{definition}[Sharply $k$-transitive]
$G$ is said to be \emph{sharply $k$-transitive} on $\Omega$ if for any $k$-tuples $(\omega_1, \ldots, \omega_k)$ and $(\omega_1', \ldots, \omega_k')$ with distinct entries, there is exactly one element $g \in G$ such that $(\omega_1, \ldots, \omega_k)^g = (\omega_1', \ldots, \omega_k')$.
\end{definition}

\begin{example}
Let $F = \mathbb{F}_q$ where $q = p^f$. Let $F^+ \cong \mathbb{Z}_p^f$ denote the additive group, and let $F^\times \cong \mathbb{Z}_{p^f-1} = \langle \rho \rangle$ denote the multiplicative group.

Then $F^\times = \langle \rho \rangle$ acts on $F^+$ naturally by field multiplication:
\[
v^\rho = v\rho \in F^+.
\]
Since $\rho$ is an automorphism of the group $F^+$, we have $\rho \in \mathrm{GL}_f(p)$. Define
\[
G := F^+ \rtimes \langle \rho \rangle \leqslant \mathrm{Hol}(F^+) = \mathbb{Z}_{p^f} \rtimes \mathrm{GL}_f(p).
\]

Note that $\langle \rho \rangle \cong \mathbb{Z}_{p^f-1}$ is transitive on $F^+ \setminus \{0\}$: for $u, v \in F^+ \setminus \{0\}$, write $u = \rho^i$ and $v = \rho^j$, then $u = v\rho^{i-j}$. So $G$ is $2$-transitive on $F^+$.

\textbf{Verification:} The number of ordered pairs $(\omega_1, \omega_2)$ with $\omega_1 \neq \omega_2 \in F^+$ is $p^f(p^f - 1) = |G|$, confirming sharp $2$-transitivity.
\end{example}

\end{topic}

\begin{topic}[Week 13. Hall subgroups (part 1)]

\begin{definition}[Hall subgroup]
Let $G$ be a finite group of order $|G|=p_{1}^{f_{1}} p_{2}^{f_{2}} \ldots p_{t}^{f_{t}}$ where $p_i$'s are the prime divisors of $|G|$. Let
\[
\pi(G) = \{p_{1}, \ldots, p_{t}\}.
\]
For a subset $\pi \subseteq \pi(G)$, a subgroup $H \leqslant G$ is called a \emph{Hall $\pi$-subgroup} of $G$ if $\pi(H)=\pi$ and $\gcd(|H|,|G|/|H|)=1$.
\end{definition}

\begin{remark}
\begin{enumerate}
\item If $|\pi|=1$, then a Hall $\pi$-subgroup is a Sylow subgroup.
\item Hall subgroups do not necessarily exist.
\item Hall $\pi$-subgroups are not necessarily conjugate.
\end{enumerate}
\end{remark}

\begin{topic}[Notation]
$G_\pi$ denotes a Hall $\pi$-subgroup (where $\pi$ is understood as $\pi \cap \pi(G)$). We write $G_p$ if $\pi = \{p\}$, and $\pi' = \pi(G) \setminus \pi$.

\textbf{Example:} $G=A_{5}$. Then $|G|=2^{2} \cdot 3 \cdot 5$.
\begin{itemize}
\item $G_{\{2,3\}}=A_{4}$
\item $G_{5}=C_{5}=G_{\{2,3\}'}$
\end{itemize}
\end{topic}

\begin{example}
\begin{enumerate}
\item $G=A_{5}$. Then $|G|=60$. Consider:
\[
\pi = \{2,3\}, \quad \{3,5\} \text{ (does not exist)}, \quad \{2,5\} \text{ (does not exist)}.
\]
\textbf{Proof:} If $H$ is a Hall $\{2,5\}$-subgroup, then $[G:H]$ has size $3$. Then $G \hookrightarrow \operatorname{Sym}([G:H]) \simeq S_{3}$, which is impossible since $G=A_5$ is simple, hence the kernel would be trivial or $G$, leading to a contradiction. Similarly for $\{3,5\}$.

\item $G=\operatorname{PSL}_2(11)$ is simple. Then $|G|=5 \cdot 11 \cdot 12$. This group has subgroups $H$ and $K$ with $H \simeq A_4$ and $K \simeq D_{12}$, which are both Hall $\{2,3\}$-subgroups of $G$. They are not isomorphic, hence not conjugate.
\end{enumerate}
\end{example}

\begin{theorem}[Hall's Theorem]
Let $G$ be a finite group with $|G|=p_{1}^{f_{1}} \ldots p_{t}^{f_{t}}$ where $p_{1}, \ldots, p_{t}$ are distinct primes. Then $G$ is solvable if and only if $G$ has Hall $\pi$-subgroups for every subset $\pi \subseteq \pi(G)$.
\end{theorem}

\begin{proof}
($\Leftarrow$) We proceed by induction on $|\pi(G)|$.

When $|\pi(G)|=1$, $G$ is a $p$-group, hence solvable.

If $|\pi(G)|=2$, then $G$ is solvable by Burnside's $p^a q^b$ theorem.

Assume $t \geqslant 3$. Let $H_{1}$ be a Hall $p_{1}'$-subgroup of $G$. Then $H_{1}$ is solvable by induction since $|\pi(H_{1})|=t-1$.

Let $p$ divide $|H_{1}|$, i.e., $p=p_j$ for some $j \in \{2, \ldots, t\}$. Such a $p$ exists since a minimal normal subgroup of a solvable group is an elementary abelian $p$-group ($\mathbb{Z}_p^d$ for some $p$ and $d$), and thus is contained in $O_p(H_{1})$.

Then $p$ divides $|H_{2}|$ or $|H_{3}|$; say $p \mid |H_{2}|$. Let $P$ be a Sylow $p$-subgroup of $H_{2}$. Then $P$ is a Sylow $p$-subgroup of $G$, and $O_{p}(H_{1}) \leqslant P^{g} \leqslant H_{2}^{g}$ for some $g$ by Sylow's theorem. Further, we have $G = H_{1} H_{2}^{g}$ since
\[
|H_{1} H_{2}^{g}| = \frac{|H_{1}| \cdot |H_{2}^{g}|}{|H_{1} \cap H_{2}^{g}|} \geqslant \frac{(p_{2}^{f_{2}} p_{3}^{f_{3}} \cdots p_{t}^{f_{t}})(p_{1}^{f_{1}} p_{3}^{f_{3}} \cdots p_{t}^{f_{t}})}{p_{3}^{f_{3}} \cdots p_{t}^{f_{t}}} = |G|.
\]

Let $N=\langle O_{p}(H_{1})^{x} \mid x \in G \rangle$, the normal closure of $O_{p}(H_{1})$ in $G$. Then $N \triangleleft G$ and $N \leq H_{2}^{g}$, since for all $x \in G$, we can write $x=x_{1} x_{2}$ for some $x_{1} \in H_{1}$, $x_{2} \in H_{2}^{g}$, and then
\[
O_{p}(H_{1})^{x}=O_{p}(H_{1})^{x_{1} x_{2}}=O_{p}(H_{1})^{x_{2}} \leq H_{2}^{g}.
\]
Thus $N$ is a proper normal subgroup of $G$.

For a Hall $\pi$-subgroup $H$ of $G$, $H \cap N$ is a Hall $\pi$-subgroup of $N$, and $H/(H \cap N) \simeq HN/N$ is a Hall $\pi$-subgroup of $G/N$.

By induction, $N$ and $G/N$ are both solvable, so $G$ is solvable.

($\Rightarrow$) Let $G$ be solvable. Let $M$ be a minimal normal subgroup of $G$. Then $M \simeq \mathbb{Z}_p^{d}$ for some prime $p$ and $d \geqslant 1$. The quotient $\bar{G}=G/M$ has order properly dividing $|G|$. By induction on the solvable group $\bar{G}$, it has Hall $\pi$-subgroups for all $\pi \subseteq \pi(\bar{G})$.

Take a subset $\pi \subseteq \pi(G)$. Let $\bar{H}$ be a Hall $\pi$-subgroup of $\bar{G}$.

If $p \in \pi$, then the full preimage of $\bar{H}$ under $G \to \bar{G}$ is $M \cdot \bar{H}$, which is a Hall $\pi$-subgroup of $G$.

If $p \notin \pi$, then $p \in \pi'$, and we can construct a Hall $\pi$-subgroup using the Schur--Zassenhaus theorem applied to the extension $1 \to M \to M\bar{H} \to \bar{H} \to 1$.
\end{proof}

\end{topic}

\begin{topic}[Week 13. Hall subgroup (part 2)]
If $p \notin \pi$, aim to find a subgroup of order $|H|$ of $G$. Now $(p, |H|)=1$. Let $X := M \cdot H$ be the full preimage of $\bar{H}$ under $G \rightarrow \bar{G}$. If $X < G$ then by induction $X$ has a Hall $\pi$-subgroup $H$ which is isomorphic to $\bar{H}$ and is a Hall $\pi$-subgroup of $G$.

Assume $X = G$. Let $\bar{Q} = O_{q}(\bar{G}) \neq 1$ for some $q \in \pi(\bar{G})$. Then the full preimage of $\bar{Q}$ under $G \rightarrow \bar{G}$ has the form $M \cdot \bar{Q} = M \rtimes Q \triangleleft G$ for some Sylow $q$-subgroup $Q \simeq \bar{Q}$ of $M \cdot \bar{Q}$ (full preimage of a normal subgroup is a normal subgroup).

\textbf{(1) Suppose $C_{M}(Q) \neq 1$.}

Then $C_{M}(Q) \leq Z(M \rtimes Q)$. Since $M$ is abelian, $P$ is a characteristic subgroup of $P \times Q_{1}$ (Sylow $p$-subgroup of $P \times Q_{1} = Z(M \rtimes Q)$). $Z(M \rtimes Q)$ is a characteristic subgroup of $M \rtimes Q \triangleleft G$, so $P \triangleleft G$. As $P \leq M \triangleleft G$ is minimal, $P = M$ and thus $M \rtimes Q = M \times Q$.

Now $Q$ is characteristic in $M \times Q = M \rtimes Q \triangleleft G$, so $Q \triangleleft G$. Let $\bar{K}$ be a Hall $\pi$-subgroup of $G/Q$. Then the full preimage of $\bar{K}$ under $G \rightarrow G/Q$ is a Hall $\pi$-subgroup of $G$ (case $p \in \pi$).

\textbf{(2) Suppose $C_{M}(Q) = 1$.}

Note that $N_{M}(Q) = C_{M}(Q)$ (let $x \in M$ such that $x \in N_{M}(Q)$, then $xyx^{-1}y^{-1} \in M \cap Q = 1$).

\textbf{Claim:} $N_{G}(Q) \simeq N_{\bar{G}}(\bar{Q}) = \bar{G}$ (as $\bar{Q} \triangleleft \bar{G}$).

Let $\bar{g} \in \bar{G} = N_{\bar{G}}(\bar{Q})$ and let $g$ be a preimage of $\bar{g}$ in $G \rightarrow \bar{G}$. Then there exists a unique $x \in M$ such that $gx \in N_{G}(Q)$.

\textit{Proof.} Since $\bar{g}^{-1}\bar{Q}\bar{g} = \bar{Q}$, we have $g^{-1}(M \rtimes Q)g = M \rtimes Q = M \rtimes g^{-1}Qg$. So $g^{-1}Qg$ is a Sylow $q$-subgroup of $M \rtimes Q$. By Sylow's theorem, there exists $x \in M$ such that $x^{-1}(g^{-1}Qg)x = Q^{gx} = Q$, i.e., $gx \in N_{G}(Q)$.

Suppose $gx' \in N_{G}(Q)$ with $x' \in M$. Then $x^{-1}x' = (gx)^{-1}gx' \in N_{G}(Q)$. Since $x^{-1}x' \in M$, we have $x^{-1}x' \in N_{G}(Q) \cap M = N_{M}(Q) = 1$, so $x = x'$.

Define $\varphi: N_{\bar{G}}(\bar{Q}) \rightarrow N_{G}(Q)$ by $\bar{g} \mapsto gx$. Suppose $g_{1}x_{1} = g_{2}x_{2}$ for some $x_{1}, x_{2} \in M$. Then $g_{2}^{-1}g_{1} = x_{2}x_{1}^{-1} \in M$, so $\overline{g_{2}^{-1}g_{1}} = \overline{x_{2}x_{1}^{-1}} = 1$, hence $\bar{g}_{2} = \bar{g}_{1}$. Thus $\varphi$ is injective, so $|N_{\bar{G}}(\bar{Q})| \leq |N_{G}(Q)|$.

Then equality must hold, and we are done (if strict inequality held, then $MN_{G}(Q)/M \leq G/M = \bar{G}$ while $MN_{G}(Q)/M = N_{G}(Q)/(M \cap N_{G}(Q)) = N_{G}(Q)/N_{M}(Q) = N_{G}(Q)$, contradiction). \qed

\begin{remark}
Moreover, for $G$ solvable, Hall $\pi$-subgroups of $G$ are conjugate for any $\pi \subseteq \pi(G)$.
\end{remark}

\textit{Proof.} Let $G$ be solvable. There exists $M < G$ such that $|G/M| = p$ for some prime $p$ (let $N \triangleleft G$ be minimal. Then $\bar{G} = G/N$ has a subgroup $\bar{L}$ such that $|\bar{G}/\bar{L}| = p$ by induction. Let $L$ be the full preimage of $\bar{L}$ under $G \rightarrow \bar{G}$. Then $|G|/|L| = |\bar{G}|/|\bar{L}| = p$).

Let $H, K$ be Hall $\pi$-subgroups of $G$. If $p \notin \pi$, then $H, K \leq M$. By induction, $H, K$ are conjugate in $M$.

Assume $p \in \pi$. Then $H/(H \cap M) \simeq \mathbb{Z}_{p} \simeq K/(K \cap M)$ and $H \cap M$, $K \cap M$ are Hall $\pi$-subgroups of $M$. By induction, $(H \cap M)^{x} = K \cap M$ for some $x \in M$. Now $H^{x}$, $K$ are Hall $\pi$-subgroups of $G$ with $K = \langle K \cap M, g \rangle$ for some $g$ with $g^{p} \in K \cap M$. \qed
\end{topic}

\begin{topic}[Week 15: Nilpotent Groups (Part 1)]

\begin{theorem}[Frattini Argument]
Let $G$ be finite and $N \triangleleft G$. Then for $P \in \operatorname{Syl}_{p}(N)$ we have $G = N_{G}(P) N$.
\end{theorem}

\begin{proof}
By Sylow theorems, $N$ acts transitively on $\operatorname{Syl}_{p}(N)$ by conjugation. Since $N \triangleleft G$, $G$ induces an action on $\operatorname{Syl}_{p}(N)$. For any $Q \in \operatorname{Syl}_{p}(N)$ and $g \in G$, we have $Q^{g} \in \operatorname{Syl}_{p}(N)$. As $N$ is transitive on $\operatorname{Syl}_{p}(N)$, we have $G = N N_{G}(P)$.
\end{proof}

\begin{remark}
\begin{enumerate}
\item Let $G$ be a $p$-group, then $Z(G) \neq 1$ and $Z(G/Z(G)) \neq 1$ (if $G$ is non-abelian). Let $K$ be the full preimage of $Z(G/Z(G))$ under $G \to G/Z(G)$. Then $Z(G) \triangleleft K \triangleleft G$. Continuing in this way we get a normal series.
\item Let $G = P \times Q$, where $P$ is a $p$-group, $Q$ is a $q$-group, $p, q$ distinct primes. Then $Z(G) \neq 1$ and $G/Z(G) \cong \bar{P} \times \bar{Q}$.
\end{enumerate}
\end{remark}

\begin{definition}
A group $G$ is called \emph{nilpotent} if it has a chain of subgroups:
\[
G = K_{1} > K_{2} > K_{3} > \cdots > K_{s+1} = 1
\]
such that $K_{i} \triangleleft G$ and $K_{i}/K_{i+1} \leq Z(G/K_{i+1})$. Such a series is called a \emph{central series}.
\end{definition}

\begin{example}[Non-nilpotent groups]
\begin{enumerate}
\item $A_{4} = C_{2}^{2} \rtimes C_{3}$ has only one proper nontrivial normal subgroup $C_{2}^{2}$. The chain $A_{4} > C_{2}^{2} > 1$ fails since $C_{2}^{2}/1 \not\leq Z(A_{4})$.

\item $S_{4}$ has normal subgroups $A_{4}$, $C_{2}^{2}$. The chain $S_{4} > A_{4} > C_{2}^{2} > 1$ is not possible since $C_{2}^{2} \neq Z(S_{4})$.

\item $D_{2p}$ for $p \geq 3$ prime. It has only one proper nontrivial normal subgroup $\langle a \rangle$ where $D_{2p} = \langle a, b \mid a^{p} = b^{2} = 1, a^{b} = a^{-1} \rangle$. The chain $D_{2p} > \langle a \rangle > 1$ fails since $\langle a \rangle \neq Z(D_{2p})$.
\end{enumerate}
\end{example}

\begin{theorem}[Equivalent definitions of nilpotent groups]
The following are equivalent:
\begin{enumerate}
\item $G$ is nilpotent.
\item If $H < G$, then $N_{G}(H) > H$.
\item Each maximal subgroup $M$ of $G$ is normal and is of prime index (i.e., $G/M \cong \mathbb{Z}_{p}$ for some $p$).
\item $G$ is a direct product of its Sylow subgroups, i.e., each Sylow subgroup is normal.
\end{enumerate}
\end{theorem}

\begin{example}
\begin{enumerate}
\item Abelian groups are nilpotent groups.
\item Subgroups and factor groups of nilpotent groups are nilpotent.
\item $G = A_{4} = C_{2}^{2} \rtimes C_{3}$. The subgroup $C_{3}$ is maximal but not normal, hence not of prime index.
\end{enumerate}
\end{example}

\begin{proof}[Proof of $(1) \Rightarrow (2)$]
$G$ has a chain of subgroups
\[
G = K_{1} > K_{2} > \cdots > K_{s+1} = 1.
\]
Let $H \leq G$. Then there exists $i$ such that $K_{i+1} \leq H$ and $K_{i} \not\leq H$.

Then $H/K_{i+1}$ and $Z(G/K_{i+1})$ centralize each other. As $K_{i}/K_{i+1} \leq Z(G/K_{i+1})$, for any $h \in H$, $y \in K_{i}$, we have $hyh^{-1}y^{-1} \in K_{i+1} \subset H$.

Hence $y h^{-1} y^{-1} \in h^{-1} H = H$, i.e., $y \in N_{G}(H)$. Thus $K_{i} \leq N_{G}(H)$.

Therefore $N_{G}(H) \geq H K_{i} > H$ as required.
\end{proof}

\begin{proof}[Proof of $(2) \Rightarrow (3)$]
% [OCR unclear: proof incomplete in source]
\end{proof}

\end{topic}

\begin{topic}[Week 15 nilpotent groups (part 2)]
Let $M \triangleleft G$ be maximal. Then $M \triangleleft G$. Then $G/M$ does not have a nonidentity proper subgroup as $M$ is maximal, so $|G/M|$ is prime as in (3).

(3) $\Rightarrow$ (4): Let $P \in \operatorname{Syl}_p(G)$. Then $P < G$ and $P < N_G(P) \leqslant G$. Suppose $N_G(P) \neq G$. Then $\exists M$ s.t.\ $N_G(P) < M < G$. Then $M \triangleleft G$ and by Frattini argument, $G = N_G(P)M = M$, contradiction. Hence $P \triangleleft N_G(P) = G$ as in (4).

(4) $\Rightarrow$ (1): Let $|G| = p_1^{e_1} p_2^{e_2} \cdots p_t^{e_t}$ with $p_1, \ldots, p_t$ distinct primes. Let $P_i \in \operatorname{Syl}_{p_i}(G)$. Then $P_i \triangleleft G$ and $G = P_1 \times \cdots \times P_t$. Let $L_1 = Z(G)$. Then $L_1 \neq 1$ and $\bar{G} = G/L_1$ is again a direct sum of its Sylow subgroups. Let $\bar{L}_2 = Z(\bar{G})$ and let $L_2$ be the full preimage of $\bar{L}_2$ under $G \to \bar{G}$. Then $L_2 \triangleleft G$ as $\bar{L}_2 \triangleleft \bar{G}$ and $L_2/L_1 = Z(G/L_1)$. Let $\bar{L}_3 = Z(G/L_2)$ and let $L_3$ be the full preimage of $\bar{L}_3$ under $G \to G/L_2$. Then $L_3 \triangleleft G$ and $L_3/L_2 = Z(G/L_2)$. Repeating this process produces a chain of subgroups
\[
1 < L_1 < L_2 < L_3 < \cdots < L_s = G
\]
such that $L_i \triangleleft G$ and $L_i/L_{i-1} = Z(G/L_{i-1})$ as in (1). $\square$
\end{topic}

\begin{topic}[Frattini subgroup and nilpotent groups]
\begin{definition}[Frattini subgroup]
Let $G$ be a finite group. Then $G$ has maximal subgroups, say $\operatorname{Max}(G) = \{M < G\}$. The intersection of all maximal subgroups is called the \emph{Frattini subgroup} of $G$, denoted by $\Phi(G)$.
\end{definition}

\begin{corollary}
\begin{enumerate}
\item $\Phi(G)$ is nilpotent.
\item $G$ nilpotent $\Leftrightarrow G/\Phi(G)$ nilpotent.
\item (Wielandt) $G$ nilpotent $\Leftrightarrow G' \leqslant \Phi(G)$.
\item If $G$ is a $p$-group, then $G/\Phi(G)$ is elementary abelian.
\end{enumerate}
\end{corollary}

\begin{remark}[Observation]
\begin{enumerate}
\item $\Phi(G)$ is a characteristic subgroup of $G$.
\item If $N \triangleleft G$, then $\Phi(N) \triangleleft G$ (by (1)).
\end{enumerate}
\end{remark}

\begin{definition}[Non-generator]
An element $x$ of $G$ is called a \emph{non-generator} if $\langle x, S \rangle = G$ implies $\langle S \rangle = G$ for any $S \subseteq G$.
\end{definition}

\begin{example}
\begin{enumerate}
\item $G = \langle a \rangle = C_{p^2}$. Then each element of $\langle a^p \rangle$ is a non-generator.
\item $Q_8$ has non-generators of order $1$ or $2$.
\item $D_{2n}$. % [OCR unclear: details omitted]
\item A nonabelian simple group has no nonidentity non-generator element. In fact, $\forall a$, $\exists b$ s.t.\ $\langle a, b \rangle = G$.
\end{enumerate}
\end{example}

\begin{lemma}[Characterization of $\Phi(G)$]
$\Phi(G)$ consists of all non-generators of $G$.
\end{lemma}

\begin{proof}
Let $x \in \Phi(G)$. Suppose $\langle x, S \rangle = G$ but $\langle S \rangle \neq G$. Then $\exists M < G$ s.t.\ $\langle S \rangle \leq M < G$. Then $x \in \Phi(G) \leq M$, so $G = \langle x, S \rangle \subseteq M$, not possible. Hence $x$ is a non-generator.

Let $x \in G$ be a non-generator. Suppose $M < G$ and $x \notin M$. Then $\langle x, M \rangle = G$, not possible as $M < G$. So $x \in M$. Since this holds for all maximal $M$, we have $x \in \Phi(G)$.
\end{proof}

\begin{theorem}[Gaschütz]
Let $N \triangleleft G$ s.t.\ $N \leq \Phi(G)$. Then $G/N$ is nilpotent $\Leftrightarrow G$ is nilpotent.
\end{theorem}

\begin{proof}
It suffices to prove $\Rightarrow$. Let $P \in \operatorname{Syl}_p(G)$. We will show $P \triangleleft G$. Then $PN/N \in \operatorname{Syl}_p(G/N)$ and $PN/N \triangleleft G/N$. Hence $PN \triangleleft G$. By Frattini argument,
\[
G = PN N_G(P) \xlongequal{N \leq \Phi(G)} P N_G(P) = N_G(P),
\]
so $P \triangleleft G$, and thus $G$ is nilpotent.
\end{proof}

\begin{proof}[Proof of Corollary]
\begin{enumerate}
\item It suffices to prove any Sylow $p$-subgroup $P$ of $\Phi(G)$ is normal in $\Phi(G)$. By Frattini argument, $G = \Phi(G) N_G(P)$. If $N_G(P) \neq G$, $\exists M$ s.t.\ $N_G(P) \leq M < G$. But $\Phi(G) \leqslant M$, so $G \leqslant M$, contradiction. Hence $P \triangleleft G$.
\item Take $N = \Phi(G)$ in the theorem.
\item Suppose $G$ is nilpotent. Then for any $M < G$, $M \triangleleft G$ and $G/M \simeq C_p$ is abelian. Thus $G' \leqslant M$ and $G' \leqslant \Phi(G)$.
\item By (3), $G/\Phi(G)$ is abelian. Moreover, $x^p \in \Phi(G)$ for all $x \in G$. Indeed, let $M < G$. If $x \in M$, we are done. If $x \notin M$, % [OCR unclear: argument incomplete]
\end{enumerate}
\end{proof}
\end{topic}

\begin{topic}[Week 15 nilpotent groups (part 3)]
Since $G/M \simeq C_p$, we have $x^{p} \in M$. Then $\forall \bar{g} \in G/\Phi(G)$, $\bar{g}^{p}=1$. Hence $G/\Phi(G)$ is elementary abelian.

\begin{example}
Let $G = C_{p}^{2} \rtimes C_{q} = \langle a \rangle \rtimes \langle b \rangle$, where $p \neq q$ are primes. Then $a^{p}b = ba^{p} \Leftrightarrow ab = ba \Leftrightarrow G/\langle a^{p} \rangle$ is abelian. In particular, $G$ abelian $\Leftrightarrow G/\langle a^{p} \rangle \simeq C_{p} \rtimes C_{q}$ abelian.
\end{example}

\begin{definition}[Fitting subgroup]
The product of all normal nilpotent subgroups of $G$ is called the \emph{Fitting subgroup} of $G$, denoted by $F(G)$. Note that $\Phi(G) \leq F(G)$.
\end{definition}

\begin{theorem}
Let $G$ be solvable, and $F = F(G)$. Let $|G| = p_{1}^{e_{1}} p_{2}^{e_{2}} \cdots p_{t}^{e_{t}}$. Then:
\begin{enumerate}
\item $F = O_{p_{1}}(G) \times \cdots \times O_{p_{t}}(G)$ (characterization).
\item $C_{G}(F) \leqslant F$, i.e., $F$ is self-centralizing. Consequently, $G/C_{G}(F) \leqslant \operatorname{Aut}(F)$.
\end{enumerate}
\end{theorem}

\begin{remark}
Recall $O_{p}(G)$. Let $p \mid |G|$. Then
\[
O_{p}(G) = \begin{cases}
\text{the largest normal $p$-subgroup of } G, \\
\text{the product of all normal $p$-subgroups of } G, \\
\bigcap_{P \in \operatorname{Syl}_{p}(G)} P.
\end{cases}
\]
\begin{enumerate}
\item $O_{p}(G) \operatorname{char} G$ ($O_{p}(G)$ is a characteristic subgroup) and $\bar{G} := G/O_{p}(G)$ satisfies $O_{p}(\bar{G}) = 1$.
\item If $q \neq p$, then $\langle O_{p}(G), O_{q}(G) \rangle = O_{p}(G) \times O_{q}(G)$.
\end{enumerate}
\end{remark}

\begin{proof}
(1) Let $N$ be a normal nilpotent subgroup of $G$. Then $N = Q_{1} \times Q_{2} \times \cdots \times Q_{t}$ where $Q_{i} \in \operatorname{Syl}_{p_{i}}(N)$. Now $Q_{i} \operatorname{char} N \triangleleft G$, so $Q_{i} \triangleleft G$ and thus $Q_{i} \leqslant O_{p_{i}}(G)$. Hence $N \leqslant O_{p_{1}}(G) \times \cdots \times O_{p_{t}}(G)$. Since $O_{p_{1}}(G) \times \cdots \times O_{p_{t}}(G)$ is a normal nilpotent subgroup of $G$, we have $F = O_{p_{1}}(G) \times \cdots \times O_{p_{t}}(G)$.

(2) Let $C = C_{G}(F)$. Then $C \cap F \leqslant Z(F)$. Since $F \operatorname{char} G$, so are $C$, $CF$ and $C \cap F$. Let $W = C \cap F$. Let $\bar{G} := G/W$. Suppose $\bar{C} \neq 1$. Then there exists $p$ such that $O_{p}(\bar{C}) \neq 1$, and $O_{p}(\bar{C}) \operatorname{char} \bar{C} \operatorname{char} \bar{G}$. Then the full preimage of $O_{p}(\bar{C})$, say $Y := W \cdot O_{p}(\bar{C}) \leqslant C$, is characteristic in $G$. Let $P \in \operatorname{Syl}_{p}(Y)$. Then $W_{p} \leqslant P \leqslant C$. By definition of $W$ and $C$, $P$ centralizes $W_{p}$, so $Y = W_{p} \times P$. Then $P \operatorname{char} Y \operatorname{char} G$ and $P \triangleleft G$, so that $W_{p} < P \leqslant F$, a contradiction. Thus $O_{p}(\bar{C}) = 1$ and $C \leqslant Z(F) \leqslant F$.
\end{proof}

\begin{example}
Let $G$ be such that each Sylow subgroup is cyclic. Then $G$ is solvable. Furthermore, $G$ is metacyclic, i.e., there exists $C \triangleleft G$ such that $C$ is cyclic and $G/C$ is cyclic.
\end{example}

\begin{proof}
Let $F = F(G)$. Then $F$ is cyclic and $G/C_{G}(F) \lesssim \operatorname{Aut}(F)$ is abelian. Since $F$ is abelian, $C_{G}(F) = F$ and $G/F$ is abelian. Since Sylow subgroups of $G/F$ are cyclic, $G/F$ is cyclic. Hence $G$ is solvable.
\end{proof}

% [OCR unclear: homework exercises partially readable]
\begin{exercise}
\begin{enumerate}
\item Let $G$ be as in the example above.
\item Let $G$ be solvable and $|G| = 4m$ where $m$ is odd and square-free. Characterize $G$.
\end{enumerate}
\end{exercise}
\end{topic}
