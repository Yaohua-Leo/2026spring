\end{topic}

\end{topic}

\begin{topic}[Week 2 (part 1)]

\textbf{Constructing groups and finding $\operatorname{Aut}(G)$ for the new $G$.}

\subsection*{Construction}

Let $G$ be a group and let $H \leqslant \operatorname{Aut}(G)$. Let $X=\{gh \mid g \in G, h \in H\}$ such that $(g_{1}h_{1})(g_{2}h_{2})=(g_{1}g_{2}^{h_{1}^{-1}})(h_{1}h_{2})$. Then $X$ is a group denoted by $G \cdot H$ in which $G \triangleleft X$ and $X/G \simeq H$.

\begin{example}[Cyclic group]
Let $G=Z_{7}=\langle g\rangle$. Then $\operatorname{Aut}(G)=Z_{6}$.
\begin{enumerate}
\item Let $\sigma \in \operatorname{Aut}(G)$ of order $2$ (so $g^{\sigma}=g^{-1}$).

Then $X=G \cdot \langle\sigma\rangle=\langle g\rangle \cdot \langle\sigma\rangle$ with $(g\sigma)(g\sigma)=gg^{\sigma}=1$. This gives
\[X=\langle g, \sigma \mid g^{\sigma}=g^{-1}, |g|=7, |\sigma|=2\rangle=Z_{7} \cdot Z_{2}=D_{14}.\]

\item Let $z \in \operatorname{Aut}(G)$ of order $3$.

Then $g^{z}=g^{2}$. Thus $X=\langle g, z\rangle$ where $|g|=7$, $|z|=3$, $g^{z}=g^{(2)}$, so $X \simeq Z_{7}:Z_{3}$.
\end{enumerate}
\end{example}

\begin{example}[General cyclic group]
Let $G=\langle g\rangle=Z_{p}$ where $p$ is prime. Then $\operatorname{Aut}(G)=Z_{p-1}$.

Let $\sigma \in \operatorname{Aut}(G)$ such that $|\sigma|=l$. Then $l \mid (p-1)$ and $\langle\sigma\rangle=Z_{l}$. We have $X=G \cdot \langle\sigma\rangle=Z_{p} \cdot Z_{l}=\langle g, \sigma\rangle$ where $|g|=p$, $|\sigma|=l$, $g^{\sigma}=g^{\lambda}$ for some $\lambda$.

If $|\sigma|=2$, then $X=D_{2p}$.

If $l=p-1$, then $X=\operatorname{AGL}(1,p)$ and $Z(X)=1$.
\end{example}

In general, for $G=Z_{n}$, we have $X=Z_{n} \cdot H$ where $H \leqslant U(n)$.

\begin{example}
Let $G=Z_{35}=Z_{5} \times Z_{7}$. Then $H \leqslant \operatorname{Aut}(G)=Z_{4} \times Z_{6}=\langle b_{1}\rangle \times \langle b_{2}\rangle$.

We have $X=Z_{35}:H < (Z_{5}:Z_{4}) \times (Z_{7}:Z_{6})$.

For instance, $X_{0}=Z_{35}:\langle b_{1}^{2}b_{2}^{3}\rangle=D_{70}$.
\end{example}

Let $G=D_{2n}=Z_{n}:Z_{2}$. Then $\operatorname{Aut}(G)=Z_{n}:U(n)=Z_{n}:\operatorname{Aut}(Z_{n})$.

\begin{example}[Finite field]
Let $F=\operatorname{GF}(p^{f})$ and let $G=F^{+} \simeq Z_{p}^{f}$, $H=F^{\times} \simeq Z_{p^{f}-1}$. Define a group $X=\{gh \mid g \in G, h \in H\}$ such that
\[(g_{1}h_{1})(g_{2}h_{2})=g_{1}g_{2}^{h_{1}^{-1}}h_{1}h_{2}\]
where $g_{2}^{h_{1}^{-1}}=g_{2}h_{1}^{-1}$ in $F$ under multiplication.

For $g, h \in F$, the element $h$ induces an automorphism of $G=F^{+}$ by multiplication: $(a+b)^{h}=(a+b)h=ah+bh=a^{h}+b^{h}$. Thus
\[X=G:H=Z_{p}^{f}:Z_{p^{f}-1}\]
which is a \textit{Singer cycle}.

Moreover,
\[\operatorname{Aut}(X)=X:\langle\tau\rangle=(Z_{p}^{f}:Z_{p^{f}-1}):Z_{f}=(Z_{p}^{f}:\langle g\rangle):\langle\tau\rangle\]
where $\tau: g \mapsto g^{p}$ is the \textit{Frobenius} automorphism.

In particular, $\operatorname{Aut}(Z_{p}:Z_{p-1}) \simeq Z_{p}:Z_{p-1}$.
\end{example}

\begin{example}
Assume $p=3$, $f=2$. Then
\[\operatorname{Aut}(X)=(Z_{3}^{2}:Z_{8}):Z_{2}\]
where $z: g \mapsto g^{3}$.

We have $\langle g\rangle$ and $\langle z\rangle$ with presentation
\[\langle a, b \mid a^{4}=1, a^{2}=b^{2}, a^{b}=-a\rangle.\]
\end{example}

\end{topic}

\begin{topic}[Week 2 (part 2)]

Let $a = g^{2}$ and $b = gz$. Let $\langle a, b\rangle = Q_{8} = \{1, -1, i, -i, j, -j, k, -k\}$.

\[b^{2} = gz \cdot gz = gg^{-1}z^{2} = z^{2} = g^{4}\]

and $|b| = 4$.

\[a^{2} = b^{2}\]

\[a^{b} = (gz)^{-1}g^{2}(gz) = g^{6} = (g^{2})^{-1} = a^{-1}\]

\[b^{a} = b^{-1}\]

We have $\langle g \rangle \lhd \langle g^{2}, gz \rangle$.

Also $\operatorname{Aut}(X) = (Z_{3}^{2} : Z_{8}) : Z_{2} = Z_{3}^{2} : (Z_{8} : Z_{2}) > Z_{3}^{2} : Q_{8}$.

\textbf{HW:} All elements of $Z_{3}^{2} : Q_{8}$ of order 3 are conjugate.

\begin{definition}[Group Action]
Let $G$ be a group and $\Omega$ a set. We say that $G$ acts on $\Omega$ if:
\begin{enumerate}
\item Each element $g$ of $G$ is a one-to-one map from $\Omega$ to $\Omega$. The image of $\omega \in \Omega$ under $g$ is denoted by $\omega^{g}$.
\item $\omega^{1} = \omega$ for all $\omega \in \Omega$.
\item $(\omega^{g_{1}})^{g_{2}} = \omega^{g_{1}g_{2}}$.
\end{enumerate}
\end{definition}

\begin{example}
\begin{enumerate}
\item $\mathrm{GL}(\Omega)$ acts on $\Omega = F^{n}$.
\item Conjugation: $\Omega = G$, $\omega^{g} = g^{-1}\omega g$. The conjugacy class of $g$ is $C(g) = \{g^{x} \mid x \in G\}$.
\item Right multiplication: $\Omega = G$, $\omega^{g} = \omega g$.
\end{enumerate}
\end{example}

\begin{lemma}[$N/C$-lemma]
For $H < G$, we have $C_{G}(H) \trianglelefteq N_{G}(H)$ and $N_{G}(H)/C_{G}(H) \lesssim \operatorname{Aut}(H)$.

In particular, if $H \trianglelefteq G$, then $G/C_{G}(H) \lesssim \operatorname{Aut}(H)$.
\end{lemma}

\begin{proof}
$N_{G}(H)$ acts on $H$ by conjugation with kernel equal to $C_{G}(H)$.
\end{proof}

\end{topic}

\begin{topic}[Week 3 (part 1)]

\begin{theorem}[Cauchy]
If $p \mid |G|$, then $\exists g \in G$ such that $|g| = p$.
\end{theorem}

Let $G$ act on a set $\Omega$. Then $G$ partitions $\Omega$ into orbits:
\[
\Omega = \Omega_{1} \dot\cup \Omega_{2} \dot\cup \cdots \dot\cup \Omega_{m}
\]

\begin{theorem}[Orbit-Stabilizer Theorem]
\[
|G| = |\Omega_{i}| \cdot |G_{w_{i}}| \quad \text{where } w_{i} \in \Omega_{i} \text{ and } G_{w_{i}} = \{g \in G \mid w_{i}^{g} = w_{i}\}
\]
\end{theorem}

\begin{example}[Conjugation action]
Assume $\Omega = G$ and $G$ acts on $\Omega$ by conjugation. Then $G = \{1\} \cup C(x_{1}) \cup \cdots \cup C(x_{t})$. Then $|G| = |C(x_{i})| \cdot |C_{G}(x_{i})|$. In particular, $|C(x_{i})| \mid |G|$.
\end{example}

\begin{theorem}
If $|G| = p^{e}$ with $p$ prime, then $Z(G) \neq 1$.
\end{theorem}

\begin{proof}
$G = \{1\} \dot\cup C(x_{1}) \dot\cup \cdots \dot\cup C(x_{t})$. Then
\[
|G| = p^{e} = 1 + |C(x_{1})| + \cdots + |C(x_{t})|
\]
\[
= 1 + p^{e_{1}} + \cdots + p^{e_{t}} \quad \text{where } e_{i} \geqslant 1.
\]
It follows that $|C(x_{i})| = 1$ for some $i$. So $1 \neq x_{i} \in Z(G)$.
\end{proof}

\begin{remark}
If $x$ and $y$ are conjugate, then $|x| = |y|$. The converse is not necessarily correct, e.g., in $C_{n} = \langle g \rangle$, $g$ and $g^{-1}$ are not conjugate.
\end{remark}

\begin{exercise}
If $G$ is a group satisfying that elements of the same order are conjugate, then $G \cong S_{2}$ or $S_{3}$. (Solved independently by W. Feit.)
\end{exercise}

\subsection*{Sylow Theorems}

Let $G$ be finite, $|G| = p^{e} m$ with $p$ prime and $\gcd(p, m) = 1$.

\begin{definition}[Sylow $p$-subgroup]
If $G$ has a subgroup $H$ such that $|H| = p^{e}$, then $H$ is called a \emph{Sylow $p$-subgroup}.
\end{definition}

\begin{remark}
Existence of $H \Rightarrow$ Cauchy's theorem.
\end{remark}

\begin{theorem}[First Sylow Theorem]
Sylow $p$-subgroups exist for all $p \mid |G|$.
\end{theorem}

\begin{proof}
Use the conjugation equation:
\[
G = \{1\} \dot\cup C(x_{1}) \dot\cup \cdots \dot\cup C(x_{t})
\]
\[
|G| = 1 + |C(x_{1})| + \cdots + |C(x_{t})| = |Z(G)| + |C(x_{1})| + \cdots + |C(x_{s})|
\]

(1) $p \nmid |Z(G)|$. Then $\exists C(x_{i})$ such that $\gcd(|C(x_{i})|, p) = 1$ and $C(x_{i}) \neq \{1\}$. By the orbit-stabilizer theorem, since $|G| = |C(x_{i})| \cdot |C_{G}(x_{i})|$, we have $p^{e} \mid |C_{G}(x_{i})|$, i.e., $C_{G}(x_{i})$ is a subgroup of $G$ of order divisible by $p^{e}$ with $|C_{G}(x_{i})| < |G|$. By induction, $C_{G}(x_{i})$ has a Sylow $p$-subgroup $P$. Then $P$ is a Sylow $p$-subgroup of $G$.

(2) $p \mid |Z(G)|$. $Z(G)$ is an abelian group. We first prove Cauchy's theorem for abelian groups.

Let $G$ be abelian. Pick $1 \neq x \in G$. If $p \mid |x|$, then $x^{|x|/p}$ is of order $p$. If $p \nmid |x|$, then $|G/\langle x \rangle|$ is divisible by $p$. By induction, $\exists a \in G$ such that $a\langle x \rangle$ is of order $p$. Then $p \mid |a|$, since $(a\langle x \rangle)^{|a|} = 1$. Then $a^{|a|/p}$ is of order $p$.

Thus $\exists x \in Z(G)$ of order $p$. So $p^{e-1} \mid |G/\langle x \rangle|$. By induction, $G/\langle x \rangle$ has a subgroup of the form $H/\langle x \rangle$ of order $p^{e-1}$. Then $H$ is a subgroup of order $p^{e}$.
\end{proof}

\begin{theorem}[Second Sylow Theorem]
Sylow $p$-subgroups are conjugate.
\end{theorem}

\begin{proof}
Let $\Omega = \{P_{1}, P_{2}, \ldots, P_{n}\}$ be the set of Sylow $p$-subgroups. Let $P = P_{1}$ and let $\Delta = \{Px \mid x \in G\}$. Then $|\Delta| = [G:P]$. Then $G$ acts on $\Delta$ by right multiplication: $g \colon Px \mapsto Pxg$.

Then $|\Delta| = \frac{|G|}{|P|}$, which is coprime to $p$, and the action of $G$ on $\Delta$ is transitive.

Let $H < G$ such that $|H| = p^{d} \leqslant p^{e}$. Then $H$ acting on $\Delta$ is intransitive (otherwise $|\Delta| \mid p^{d}$, contradiction). Suppose $H$ acting on $\Delta$ partitions $\Delta$ into orbits $\Delta_{1}, \ldots, \Delta_{r}$. Then $|\Delta_{i}| \mid |H|$ and $|\Delta| = |\Delta_{1}| + \cdots + |\Delta_{r}|$. So $|\Delta_{i}| = 1$ for some $i$ since $p \nmid |\Delta|$, i.e., $Pxh = Px$ for some $x$, for each $h \in H$.
\end{proof}

\end{topic}

\begin{topic}[Week 3 (part 2)]
\[
\begin{aligned}
xHx^{-1} &< P \\
H &< x^{-1}Px
\end{aligned}
\]
If $|H| = p^{e}$, then $H = x^{-1}Px$.

\begin{theorem}[Third Sylow Theorem]
Let $|G| = p^{e}m$ with $\gcd(p, m) = 1$ and let $n_{p}$ denote the number of Sylow $p$-subgroups of $G$. Then $n_{p} \mid m$ and $n_{p} \equiv 1 \pmod{p}$.
\end{theorem}

\section*{Group Actions}

Let $G$ be finite. Let $N \trianglelefteq G$ be minimal. Then $\bar{G} = G/N$ is a group with $|\bar{G}| < |G|$. So $G = N \cdot \bar{G}$ (extension).

\begin{lemma}
If $N$ is a minimal normal subgroup of $G$, then $N = S_{1} \times \cdots \times S_{r}$ where $S_{1} \simeq S_{2} \simeq \cdots \simeq S_{r}$ are simple. i.e., $N \simeq S^{r} = S_{1} \times \cdots \times S_{r}$. Furthermore, $N \simeq C_{p}^{r}$ or $S$ is nonabelian.
\end{lemma}

\textbf{Proof.} If $N$ is simple, then we are done.

Assume that $N$ is not simple. Let $M$ be a minimal normal subgroup of $N$. By induction, $M = T_{1} \times \cdots \times T_{m}$ where $T_{1} \simeq T_{2} \simeq \cdots \simeq T_{m}$ are simple.

For $g \in G$, the conjugate $M^{g} = g^{-1}Mg$ is a minimal normal subgroup of $N$. By minimality, either $M^{g} = M$ or $M \cap M^{g} = \{1\}$.

The normal closure of $M$ under $G$ is
\[
M^{G} = \langle M^{g} \mid g \in G \rangle = M \times M^{g_{1}} \times \cdots \times M^{g_{l}}.
\]
Note that if $M \cap M^{g} = 1$, then $\langle M, M^{g} \rangle = M \times M^{g}$ since $M \trianglelefteq N$ and $M^{g} \trianglelefteq N$.

Also, since $M = T_{1} \times \cdots \times T_{m}$, we have $M^{g} = T_{1}^{g} \times \cdots \times T_{m}^{g}$. Hence $M^{g} \simeq T^{m}$.

Since $M^{G} \trianglelefteq G$ and $M^{G} \leq N$, we have $N = M^{G} = T^{ml}$.

Now change notation: $M \trianglelefteq G$ minimal. Then
\[
M = \begin{cases}
C_{p}^{r} \\[4pt]
T \times \cdots \times T \text{ (nonabelian)}
\end{cases}
\]
We have
\[
G/C_{G}(M) \cong N_{G}(M)/C_{G}(M) \leqslant \operatorname{Aut}(M) \quad \text{where } M \trianglelefteq G.
\]

\textbf{Question:} For $T_{i}$ nonabelian, we want to find $\operatorname{Aut}(T \times \cdots \times T_{r})$.

For $g \in \operatorname{Aut}(M)$, we have $T_{i}^{g} \trianglelefteq M$ since $T_{i} \trianglelefteq M$.

\textbf{Claim:} $T_{i}^{g} = T_{j}$ for some $j$.

\textbf{Proof.} We have $T_{i}^{g} \trianglelefteq T_{1} \times \cdots \times T_{r} = M$.

Suppose $T_{i}^{g} \neq T_{j}$ for all $j$. Let $L = T_{2} \times \cdots \times T_{r}$. Then $T_{i}^{g} \cap L = 1$ since $T_{i}^{g} \cap L \trianglelefteq T_{i}^{g}$ and $T_{i}^{g}$ is simple.

Since $T_{i}^{g} \subseteq M = T_{1} \times \cdots \times T_{r}$, there exists $(t_{1}, y) \in T_{i}^{g}$ where $t_{1} \neq 1$ and $y \neq 1$, $y \in L$.

For all $t \in T_{1}$:
\[
(t_{1}, y)^{(t,1)} = (t_{1}^{t}, y).
\]
Since $T_{i}$ is nonabelian and simple, $Z(T_{i}) \trianglelefteq T_{i}$ implies $Z(T_{i}) = 1$. Hence there exists $t \in T_{1}$ such that $t_{1}^{t} \neq t_{1}$, and
\[
(t_{1}, y)^{-1}(t_{1}^{t}, y) = (t_{1}^{-1}t_{1}^{t}, 1) = (t_{0}, 1) \in T_{i}^{g}.
\]
Then
\[
\langle (t_{0}, 1)^{(t,1)} \mid (t,1) \in T_{1} \times L \rangle \trianglelefteq T_{i}^{g}.
\]
% [OCR unclear: argument continues]
\end{topic}

\begin{topic}[Week 3 (part 3)]
$\langle (t_0^t, 1) \mid t \in \Pi \rangle \subseteq T_1 \Rightarrow \langle \rangle = T_1 \Rightarrow \pi_1^g = T_1$.

On the other hand, $T_i^g < T_2 \times \cdots \times T_r$, continue.

$\Rightarrow \operatorname{Aut}(M)$ induces a permutation group on $\{T_1, T_2, \ldots, T_r\}$ with kernel $\operatorname{Aut}(T_1) \times \cdots \times \operatorname{Aut}(T_r) =: K$.

s.t.\ $\operatorname{Aut}(M)/K \cong S_r \Rightarrow \operatorname{Aut}(M) = K \cdot S_r = \operatorname{Aut}(T)^r \cdot S_r$.

\begin{example}
Structure of $G$ where $|G| = 72$.

Suppose it is solvable, $\exists N \trianglelefteq_{\min} G$.

\[
N \simeq T^r, \quad |T^r| \mid 72 \Rightarrow N \cong C_3^2 \text{ or } C_2^3.
\]

By conjugation action, $T \trianglelefteq \operatorname{Aut}(T)$, and $\operatorname{Aut}(T)/T$ is relatively small.
\end{example}
\end{topic}

\begin{topic}[Week 4 (part 1)]

\textbf{(Burnside)} If $G$ is a finite group whose Sylow subgroups are all cyclic, then $G$ is solvable.

\begin{definition}[Transfer]
Let $G$ be a finite group and $H < G$. Let $\Omega = [G:H] = \{Hx \mid x \in G\} = \{Hx_1, \ldots, Hx_n\}$. For $g \in G$, define
\[
\hat{g}\colon Hx_i \to Hx_j = Hx_i g.
\]
So $x_i g \in Hx_j$ and $x_i g = h_i(g) x_j$ for some $h_i(g) \in H$. The map $\hat{g}$ induces a permutation on $\{1, 2, \ldots, n\}$, denoted by $\pi(g)$, i.e., $i^{\pi(g)} = j$. Let
\[
h_i(g) = x_i g x_{\pi(g)(i)}^{-1} \in H.
\]
The \emph{transfer} from $G$ to $H/H'$ is defined by
\[
V_{G \to H}\colon G \to H/H', \quad g \mapsto \prod_{i=1}^{n} h_i(g) H' = \prod_{i=1}^{n} x_i g x_{\pi(g)(i)}^{-1} H'.
\]
\end{definition}

\begin{lemma}
\begin{enumerate}
\item $V_{G \to H}$ is a homomorphism from $G$ to $H/H'$.
\item $V_{G \to H}$ does not depend on the choice of coset representatives $x_1, \ldots, x_n$.
\item Writing $\hat{g}$ in cycle form,
\[
V_{G \to H}(g) = \prod_{i=1}^{t} \left( x_i g^{\ell_i} x_i^{-1} \right) H'.
\]
\end{enumerate}
\end{lemma}

\begin{proof}
(1) For $g_1, g_2 \in G$,
\begin{align*}
V_{G \to H}(g_1 g_2) &= \prod_{i=1}^{n} h_i(g_1 g_2) H' \\
&= \prod_{i=1}^{n} x_i g_1 g_2 x_{\pi(g_1 g_2)(i)}^{-1} H' \\
&= \prod_{i=1}^{n} x_i g_1 x_{\pi(g_1)(i)}^{-1} \cdot x_{\pi(g_1)(i)} g_2 x_{\pi(g_1 g_2)(i)}^{-1} H' \\
&= \prod_{i=1}^{n} x_i g_1 x_{\pi(g_1)(i)}^{-1} H' \cdot \prod_{i=1}^{n} x_{\pi(g_1)(i)} g_2 x_{\pi(g_1 g_2)(i)}^{-1} H' \\
&= V_{G \to H}(g_1) V_{G \to H}(g_2),
\end{align*}
where we used that $H/H'$ is abelian.

(2) Let $y_1, \ldots, y_n \in G$ such that $Hy_i = Hx_i$ for $1 \le i \le n$. Then $y_i = t_i x_i$ for some $t_i \in H$. For $g \in G$, let $y_i g = k_i(g) y_{\pi(g)(i)}$. Then $k_i(g) = y_i g y_{\pi(g)(i)}^{-1} \in H$. The corresponding transfer is
\begin{align*}
\tilde{V}_{G \to H}(g) &= \prod_{i=1}^{n} k_i(g) H' = \prod_{i=1}^{n} y_i g y_{\pi(g)(i)}^{-1} H' \\
&= \prod_{i=1}^{n} t_i x_i g \left( t_{\pi(g)(i)} x_{\pi(g)(i)} \right)^{-1} H' \\
&= \prod_{i=1}^{n} t_i \left( x_i g x_{\pi(g)(i)}^{-1} \right) t_{\pi(g)(i)}^{-1} H'.
\end{align*}
Since $H/H'$ is abelian,
\[
\tilde{V}_{G \to H}(g) = \prod_{i=1}^{n} x_i g x_{\pi(g)(i)}^{-1} H' \cdot \prod_{i=1}^{n} t_i H' \cdot \prod_{i=1}^{n} t_{\pi(g)(i)}^{-1} H' = \prod_{i=1}^{n} x_i g x_{\pi(g)(i)}^{-1} H' = V_{G \to H}(g).
\]

(3) The permutation $\hat{g}$ on $\Omega = \{Hx_1, \ldots, Hx_n\}$ partitions $\Omega$ into $t$ orbits:
\[
(Hx_1, Hx_1 g, \ldots, Hx_1 g^{\ell_1 - 1}), \quad (Hx_2, Hx_2 g, \ldots, Hx_2 g^{\ell_2 - 1}), \quad \ldots, \quad (Hx_t, \ldots, Hx_t g^{\ell_t - 1}),
\]
where $Hx_i g^{\ell_i} = Hx_i$. Take
\[
x_1, x_1 g, \ldots, x_1 g^{\ell_1 - 1}, \quad x_2, x_2 g, \ldots, x_2 g^{\ell_2 - 1}, \quad \ldots, \quad x_t, x_t g, \ldots, x_t g^{\ell_t - 1}
\]
as coset representatives. The corresponding transfer is
\[
V_{G \to H}(g) = \prod_{i=1}^{t} \left( x_i g^{\ell_i} x_i^{-1} \right) H'.
\]
\end{proof}

\end{topic}

\begin{topic}[Week 4 (part 2)]
\begin{align*}
V_{G \to H}(g) & = \prod x_i g(x_i g)^{-1}(x_i g)g(x_i g)^{-1} \cdots x_i g^{l_i-1}g x_i^{-1}H \\
& = \prod (x_i g^{l_i} x_i^{-1})H'
\end{align*}

\begin{definition}[$p$-nilpotent]
A group $G$ is called \emph{$p$-nilpotent} if $G = NP$ where $N \triangleleft G$ and $P$ is a Sylow $p$-subgroup and $N \cap P = 1$ (equivalently, if $G$ has a normal subgroup $N$ such that $|G/N| = |G|_p = |P|$, where $p$ is a prime divisor of $|G|$ and $P$ is any Sylow $p$-subgroup of $G$).
\end{definition}

\begin{theorem}[Burnside]
Let $G$ be a finite group and $P$ a Sylow $p$-subgroup. If $N_G(P) = C_G(P)$, then $G$ is $p$-nilpotent.
\end{theorem}

\begin{proof}
(Use transfer to construct $\ker V_{G \to P} = N$.) Since $N_G(P) = C_G(P)$, $P$ is abelian ($P \leq N_G(P)$ hence $P \subseteq C_G(P)$), so $P' = 1$.

Let $g \in P \setminus \{1\}$. Then
\[
V_{G \to P}(g) = \prod_{i=1}^{t} x_i g^{l_i} x_i^{-1}.
\]
As $g^{l_i}$, $x_i g^{l_i} x_i^{-1} \in P$ and $P$ is abelian, $C_G(g^{l_i}) \geq P$. Also $C_G(x_i g^{l_i} x_i^{-1}) = x_i C_G(g^{l_i}) x_i^{-1} \geq P$. Hence $C_G(g^{l_i}) \geq P$ and $C_G(g^{l_i}) \geq x_i^{-1} P x_i$.

By Sylow's theorem, there exists $u \in C_G(g^{l_i})$ such that
\[
u^{-1}(x_i^{-1} P x_i)u = P,
\]
i.e., $(x_i u)^{-1} P (x_i u) = P$.

Thus $x_i u \in N_G(P) = C_G(P) \Rightarrow x_i \in C_G(P) \leq C_G(g^{l_i})$.

Therefore
\[
V_{G \to P}(g) = \prod_{i=1}^{t} g^{l_i} = g^{l_1 + \cdots + l_t} = g^{|G:P|} \neq 1
\]
(since $g \in P \setminus \{1\}$), which yields $V_{G \to P}(P) = P$ (since it is injective by above discussion and $|G| < \infty$) $\Rightarrow V_{G \to P}(G) = P$.

Let $K = \ker V_{G \to P} \triangleleft G$. Then by the isomorphism theorem, $G/K \simeq P$, so $K \triangleleft G$.
\end{proof}

\begin{theorem}[Burnside]
Let $G$ be a finite group of which Sylow subgroups are all cyclic. Let $p$ be the smallest prime divisor of $|G|$ and let $P$ be a Sylow $p$-subgroup of $G$. Then:
\begin{enumerate}
\item $G$ is $p$-nilpotent;
\item $G$ is solvable.
\end{enumerate}
\end{theorem}

\begin{proof}
Now $P$ is cyclic and $N_G(P)/C_G(P) \lesssim \operatorname{Aut}(P)$ where $|\operatorname{Aut}(P)| = p^{e-1}(p-1)$, whose prime divisors are $\leq p$. Then we can only have $N_G(P)/C_G(P) = 1$ since $p^e \mid |N_G(P)|$ as $P \leq C_G(P)$, and all prime divisors of the LHS are $> p$. Then $N_G(P) = C_G(P)$ and so $G$ has a normal subgroup $K$ with $|K| = |G|/|P|$.

Let $p_1$ be the smallest prime divisor of $|K|$. Then $K$ is $p_1$-nilpotent and has a normal subgroup $K_1$ with $|K_1| = |K|/|P_1|$. Repeating this process, we have that
\[
G \triangleright K \triangleright K_1 \triangleright \cdots \triangleright Q
\]
where $Q$ is a Sylow $q$-subgroup, where $q$ is the largest prime divisor of $|G|$.
\end{proof}

\begin{remark}
$Q \triangleleft G$.
\end{remark}

\begin{proof}
Suppose $Q \triangleleft K_n \triangleleft K_{n-1}$. Then $\forall g \in K_{n-1}$, $g^{-1}Qg \subseteq g^{-1}K_n g = K_n$. Since $Q \triangleleft K_n$, $K_n$ has only one Sylow $q$-subgroup, then $g^{-1}Qg = Q$, hence $Q \triangleleft K_{n-1}$. Repeating this process, $Q \triangleleft G$.
\end{proof}

\begin{corollary}
If a Sylow $2$-subgroup of $G$ is cyclic, then $G$ is $2$-nilpotent hence solvable.
\end{corollary}

\begin{proof}
Need to use Feit--Thompson: $|G|$ odd $\Rightarrow G$ solvable. Then $N$ and $G/N$ both solvable $\Rightarrow G$ solvable.
\end{proof}

\begin{proposition}
Let $G$ be a finite nonabelian simple group. Let $p$ be a prime divisor of $|G|$.
\begin{enumerate}
\item If $p$ is the smallest prime divisor, then $G$ is divisible by $p^3$ or $12$.
\item If $|G| = pm$ with $\gcd(p, m) = 1$, then for a Sylow $p$-subgroup $P$:
\begin{enumerate}
\item[(i)] $C_G(P) \neq N_G(P) \neq G$;
\item[(ii)] $|N_G(P)/C_G(P)| \mid (p-1)$.
\end{enumerate}
\end{enumerate}
\end{proposition}

\begin{proof}
(1) Suppose $|G|$ is not divisible by $p^3$. Then $p^2 \mid |G|$, otherwise a Sylow $p$-subgroup $P \cong C_p$ so that $N_G(P) = C_G(P)$, and $G$ is $p$-nilpotent, contradiction since $G$ is nontrivial simple.
\end{proof}
\end{topic}

\begin{topic}[Week 4 (part 3)]
Then $|P|=p^{2}$ and so $P \simeq C_{p^{2}}$ or $C_{p} \times C_{p}$. The former would imply $G$ is $p$-nilpotent, not possible. Hence $P \simeq C_{p} \times C_{p}$ and $N_{G}(P) \neq C_{G}(P)$. So
\[
N_{G}(P)/C_{G}(P) \simeq \operatorname{Aut}(P) = \operatorname{Aut}(C_{p} \times C_{p}) \simeq GL(2, p).
\]
Now $|GL(2, p)| = p(p^{2}-1)(p-1) = p(p+1)(p-1)^{2}$.

Let $r$ be a prime divisor of $|N_{G}(P)/C_{G}(P)|$. Then $r \mid p(p+1)$. And $r > p$ (since $P \simeq C_{p} \times C_{p}$ so $P \leq C_{G}(P)$), so $p=2$ and $p+1=3$.

Hence $12 \mid |G|$.

(2) easy.

\begin{example}
If $|G| = 5 \cdot 7 \cdot 13$, then $G$ is cyclic.

Let $G_{p}$ denote a Sylow $p$-subgroup.
\begin{itemize}
\item $G_{13} \triangleleft G$ since $N_{G}(G_{13})/C_{G}(G_{13}) \leq \operatorname{Aut}(G_{13}) = C_{12}$.
\item $G$ is $5$-nilpotent.
\item $G$ is $13$-nilpotent. Hence $G = G_{7} \times G_{91}$.
\end{itemize}
\end{example}
\end{topic}

\begin{topic}[Week 5 (part 1)]

Let $G^{\prime}$ be the commutator subgroup of $G$. Let $G^{\prime\prime} = G^{(2)} = (G^{\prime})^{\prime}$ and $G^{(n)} = (G^{(n-1)})^{\prime}$. We have
\[
G \triangleright G^{\prime} \triangleright G^{\prime\prime} \triangleright \cdots \triangleright G^{(n)} \triangleright \cdots
\]

\begin{example}
Commutator subgroup $G^{\prime}$ of $G$:
\begin{enumerate}
\item If $G$ is simple and non-abelian, then $G/G^{\prime}$ is abelian and $G^{\prime} \neq 1$, so $G^{\prime} = G$.
\item $G = S_n$:
\[
G^{\prime} = \begin{cases} A_n & \text{if } n \geq 5 \\ A_4 & \text{if } n = 4 \end{cases}
\]
Note that $A_n$ is generated by all $3$-cycles, since
\[
(123) = (12)(13)(12)^{-1}(13)^{-1}.
\]
\end{enumerate}
\end{example}

If $G$ is finite, then in the sequence
\[
G \triangleright G^{\prime} \triangleright G^{(2)} \triangleright \cdots \triangleright G^{(n)} \triangleright G^{(n+1)} \triangleright \cdots
\]
either $G^{(n)} = G^{(n+1)} = G^{(n+2)} = \cdots = G^{(\infty)}$ or $G^{(n)} = 1$.

\begin{definition}
\begin{enumerate}
\item $G$ is \textbf{solvable} if $G^{(n)} = 1$ for some $n$.
\item $G$ is called a \textbf{perfect group} if $G = G^{\prime}$.
\end{enumerate}
\end{definition}

\begin{example}
Perfect groups:
\begin{enumerate}
\item All non-abelian simple groups.
\item $A_n$ with $n \geq 5$. For example, $(123)(345)(123)^{-1}(345)^{-1} = (143)$.
\item $\mathrm{SL}_d(q)$ when nonsolvable, i.e., $d \geq 2$ and $(d,q) \neq (2,2), (2,3)$. Note that $Z(\mathrm{SL}_d(q)) \cong \mathbb{Z}/(d, q-1)\mathbb{Z}$.
\end{enumerate}
\end{example}

\begin{proposition}
Properties of being solvable:
\begin{enumerate}
\item If $G$ is solvable, then so is each subgroup and each factor group of $G$.
\item If $N \triangleleft G$ such that $N$ and $G/N$ are solvable, then $G$ is solvable.
\item $p$-groups are solvable (use (2) and induction on $|G|$, noting that $Z(G) \neq 1$ when $G$ is nontrivial).
\end{enumerate}
\end{proposition}

\begin{lemma}
If $P$ is a non-normal Sylow $p$-subgroup of $G$, then $P \subsetneq N_G(P)$.
\end{lemma}

\begin{definition}
Let $P < G$. A \textbf{double coset} of $P$ in $G$ is a set of the form
\[
PxP = \{ph_1 h_2 \mid h_1, h_2 \in P\}.
\]
\end{definition}

\begin{lemma}
The number of right cosets of $P$ contained in $PxP$ is equal to $|P|/|P^x \cap P|$.
\end{lemma}

\begin{proof}
We have $PxP = \bigcup_{h \in P} Pxh$. Note that $Pxh_1 = Pxh_2$ for $h_1, h_2 \in P$ if and only if $h_1 h_2^{-1} \in P^x \cap P$.

Decompose $G = \bigcup_{x \in G} PxP$ (note that for $x, y \in G$, either $PxP = PyP$ or $PxP \cap PyP = \emptyset$). We have:
\begin{itemize}
\item $P1P = P$ has a unique coset of $P$.
\item $|G| = |P1P| + |Px_1P| + \cdots + |Px_tP|$.
\end{itemize}
Consider the number of cosets of $P$ on both sides. The LHS is divisible by $|P|$. On the RHS, $|Px_iP| = |P|/|P^{x_i} \cap P|$ is either divisible by $|P|$ or equals $1$. Then for some $x_j$, we have $|P^{x_j} \cap P| = |P|$, so $P^{x_j} \cap P = P$ and $P^{x_j} = P$, i.e., $x_j \in N_G(P)$. Thus $P \subsetneq N_G(P)$.
\end{proof}

\begin{theorem}
Let $G$ be a $p$-group.
\begin{enumerate}
\item If $H < G$, then $H < N_G(H)$.
\item If $H$ is a maximal subgroup of $G$, then $H \triangleleft G$ and $|G|/|H| = p$ (consider $G/H$).
\item $G$ is solvable (find $H$ maximal in $G$, use induction).
\item $Z(G) > 1$.
\item If $N$ is a normal subgroup of $G$ and $|N| = p$, then $N \leq Z(G)$.
\end{enumerate}
\end{theorem}

