\begin{topic}[Week 1 (part 1)]

\textbf{Part 1:} Review and study basic concepts and basic theory by studying important classes of groups.

\textbf{Part 2:} Group actions. Permutation groups---O'Nan--Scott theorem.

\textbf{Part 3:} Linear groups---classical groups and subgroups.

\subsection*{Cyclic Groups}

Cyclic groups (denoted by $C_n$):
\[ G = \langle g \rangle = \{1, g, g^2, g^3, \ldots\} \]
(or $\{0, 1, 2, \ldots\}$ sometimes written additively since commutative).
\begin{itemize}
    \item Cyclic groups are uniquely determined by their order.
    \item Subgroups are cyclic.
    \item Factor groups are cyclic.
\end{itemize}

\begin{proposition}
$\operatorname{Aut}(C_n) \simeq (\mathbb{Z}/n\mathbb{Z})^{\times} = \{\bar{x} \mid (x, n) = 1\} = U(n)$.
\end{proposition}

\begin{proof}
For all $\theta \in \operatorname{Aut}(C_n)$, $\theta(g) = g^i$ for some $i \in \mathbb{Z}$ and the integer $i$ uniquely determines $\theta$. Denote this automorphism by $\theta_i$. We have $(i, n) = 1$ since $g^i$ must have the same order as $g$. On the other hand, for all $a$ such that $(a, n) = 1$, the map $g \mapsto g^a$ is an automorphism of $C_n$. Hence we have a surjective map
\[
\psi\colon \operatorname{Aut}(C_n) \rightarrow (\mathbb{Z}/n\mathbb{Z})^{\times}, \quad \theta_a \mapsto a \pmod{n}.
\]
$\psi$ is obviously a homomorphism and injective.
\end{proof}

\begin{itemize}
    \item $\operatorname{Aut}(C_p) = C_{p-1} = \langle \theta \rangle$ (use the fact that $\mathbb{F}_p^{\times}$ is cyclic).
\end{itemize}

Recall: let $F = GF(p^l)$.
\begin{itemize}
    \item $F^+ = C_p^l = C_p \oplus \cdots \oplus C_p$
    \item $F^{\times} = C_{p^l - 1}$
\end{itemize}

\begin{proposition}
$\operatorname{Aut}(C_{p^e}) = C_{p^{e-1}(p-1)}$ where $e \geq 2$ and $p$ is an odd prime.
\end{proposition}

\begin{proof}
Let $r = \lambda$ or $p + \lambda$ where $\lambda$ is a primitive root for $C_p$ (so $\operatorname{ord}_p(\lambda) = p-1$). Since $(p+\lambda, p) = 1$, we have $(p+\lambda, p^e) = 1$, and
\[
(p+\lambda)^{p^{e-1}(p-1)} \equiv 1 \pmod{p^e}.
\]
It suffices to show $p^{e-1}(p-1)$ is the smallest integer $n$ such that $(p+\lambda)^n \equiv 1 \pmod{p^e}$, or equivalently $\lambda^n \equiv 1 \pmod{p^e}$.

First note that $p-1 \mid \operatorname{ord}_{p^e}(r)$ since $r^{|r|} \equiv 1 \pmod{p}$ yields $r^{|r|} \equiv 1 \pmod{p}$, so $p-1 \mid |r|$. Then it suffices to show $r^{p^{e-2}(p-1)} \not\equiv 1 \pmod{p^e}$.

When $e = 2$:
\[
(p+\lambda)^{p-1} \equiv \lambda^{p-1} + p(p-1)\lambda^{p-2} \pmod{p^2}.
\]
Here we use a lemma: for all $\lambda$ primitive root of $C_p$, either $\lambda$ or $p+\lambda$ is a primitive root for $(\mathbb{Z}/p^2\mathbb{Z})^{\times}$.

By above, $(p-1) \mid |\lambda|$, so $|\lambda| = p-1$ or $p(p-1)$. If $|\lambda| = p-1$, then
\[
(p+\lambda)^{p-1} \equiv \lambda^{p-1} + p(p-1)\lambda^{p-2} \equiv p(p-1)\lambda^{p-2} \pmod{p^2}.
\]
Since $p \nmid \lambda^{p-2}$, we have $(p+\lambda)^{p-1} \not\equiv 1 \pmod{p^2}$, so $p+\lambda$ is a primitive root for $(\mathbb{Z}/p^2\mathbb{Z})^{\times}$.

Suppose it works for $e \leq n$, i.e., $r^{p^{n-2}(p-1)} \not\equiv 1 \pmod{p^n}$. Since $r^{p^{n-2}(p-1)} \equiv 1 \pmod{p^{n-1}}$, we have
\[
r^{p^{n-2}(p-1)} = 1 + dp^{n-1}
\]
for some $(d, p) = 1$. Then
\[
r^{p^{n-1}(p-1)} = (1 + dp^{n-1})^p \equiv 1 + dp^n + \binom{p}{2}d^2 p^{2n-2} \equiv 1 + dp^n \not\equiv 1 \pmod{p^{n+1}}.
\]
\end{proof}

\begin{remark}
We actually proved that if $r$ is a primitive root for $(\mathbb{Z}/p^2\mathbb{Z})^{\times}$, then $r$ is a primitive root for $(\mathbb{Z}/p^k\mathbb{Z})^{\times}$ for any $k$. And we prove existence of such $r$ by noting that if $\lambda$ is a primitive root for $C_p$, then $\lambda$ or $p+\lambda$ is a primitive root of $(\mathbb{Z}/p^2\mathbb{Z})^{\times}$.
\end{remark}

\textbf{Computation:} Prove that each Sylow $q$-subgroup is cyclic for each prime $q$, and each finite abelian group is a direct sum of cyclic groups.

\begin{enumerate}
    \item[(1)] Sylow $p$-subgroup is cyclic.

    \textbf{Claim:} $1+p$ is an element of order $p^{\alpha-1}$ in $(\mathbb{Z}/p^{\alpha}\mathbb{Z})^{\times}$. (Show that $(1+p)^{p^{\alpha-1}} \equiv 1 \pmod{p^{\alpha}}$ but $(1+p)^{p^{\alpha-2}} \not\equiv 1 \pmod{p^{\alpha}}$.)

    \item[(2)] Sylow $q$-subgroup is cyclic, $q \neq p$.
\end{enumerate}

The map
\[
\mathbb{Z}/p^{\alpha}\mathbb{Z} \rightarrow \mathbb{Z}/p\mathbb{Z}, \quad a + (p^{\alpha}) \mapsto a + (p)
\]
is a ring homomorphism which gives a surjective homomorphism from $(\mathbb{Z}/p^{\alpha}\mathbb{Z})^{\times}$ onto $(\mathbb{Z}/p\mathbb{Z})^{\times}$. The latter group is cyclic of order $p-1$. The kernel of this map is of order $p^{\alpha-1}$, hence for all primes $q \neq p$, the Sylow $q$-subgroup of $(\mathbb{Z}/p^{\alpha}\mathbb{Z})^{\times}$ maps isomorphically into the cyclic group $(\mathbb{Z}/p\mathbb{Z})^{\times}$. All Sylow subgroups of $(\mathbb{Z}/p^{\alpha}\mathbb{Z})^{\times}$ are therefore cyclic, so $(\mathbb{Z}/p^{\alpha}\mathbb{Z})^{\times}$ is cyclic.

\begin{proposition}
$\operatorname{Aut}(C_{2^e}) = C_{2^{e-2}} \times C_2$ for $e \geq 2$.
\end{proposition}

Note that $C_2$ and $\mathbb{Z}/4\mathbb{Z}$ have primitive roots (1 and 3 respectively), but not for $\mathbb{Z}/2^{\alpha}\mathbb{Z}$ when $\alpha \geq 3$.

\begin{enumerate}
    \item[(1)] If $a = 2b + 1$ for some $b$, $k \geq 3$, then $a^{2^{k-2}} \equiv 1 \pmod{2^k}$.

    When $k = 3$: $a^2 = (2b+1)^2 = 4b^2 + 4b + 1 = 1 + 4b(b+1) \pmod{2^3}$. Since $8 \mid 4b(b+1)$, we have $a^2 \equiv 1 \pmod{2^3}$.

    Suppose it holds for $k \leq n$. Then $(1 + \ell \cdot 2^k)^2 = \ell^2 \cdot 2^{2k} + \ell \cdot 2^{k+1} + 1 \equiv 1 \pmod{2^{k+1}}$.

    \item[(2)] 5 is an element of order $2^{k-2}$ in $(\mathbb{Z}/2^k\mathbb{Z})^{\times}$. (Show that $(1+2^2)^{2^{k-2}} \equiv 1 \pmod{2^k}$ and $(1+2^2)^{2^{k-3}} \equiv 1 + 2^{k-1} \not\equiv 1 \pmod{2^k}$.)

    \item[(3)] Since $(\mathbb{Z}/2^k\mathbb{Z})^{\times}$ is finite abelian, it is a direct product of cyclic groups. It has an element of order $2^{k-2}$, then $(\mathbb{Z}/2^k\mathbb{Z})^{\times} \simeq C_{2^{k-2}} \times C_2$.
\end{enumerate}

\begin{proposition}
$\operatorname{Aut}(C_n) = \operatorname{Aut}(C_{p_1^{e_1}}) \times \cdots \times \operatorname{Aut}(C_{p_t^{e_t}})$ where
% [truncated by model: consider rerun with higher max_tokens]

\begin{topic}[Week 1 (part 2)]
defined by \[ r \mapsto (r + A_1, r + A_2, \ldots, r + A_k) \] is a ring homomorphism with kernel $A_1 \cap A_2 \cap \cdots \cap A_k$.

If for each $i, j \in \{1, 2, \ldots, k\}$ with $i \neq j$ the ideals $A_i$ and $A_j$ are coprime ($A_i + A_j = R$), then this map is surjective and $A_1 \cap A_2 \cap \cdots \cap A_k = A_1 A_2 \cdots A_k$, so
\[ R/(A_1 A_2 \cdots A_k) = R/(A_1 \cap A_2 \cap \cdots \cap A_k) \simeq \prod_{i=1}^{k} R/A_i. \]

\begin{theorem}[Chinese Remainder Theorem]
Let $m_1, \ldots, m_n$ be pairwise coprime integers. Then
\[ \mathbb{Z}/(m_1 \cdots m_n)\mathbb{Z} \simeq (\mathbb{Z}/m_1\mathbb{Z}) \times \cdots \times (\mathbb{Z}/m_n\mathbb{Z}). \]
\end{theorem}

\textbf{Proof sketch of general version:}
\begin{enumerate}
\item The homomorphism with $\ker\varphi = A_1 \cap \cdots \cap A_n$ is obvious.
\item Surjective if coprime.
\end{enumerate}

\begin{lemma}
Let $R$ be a ring with identity. If $I_1, I_2, J$ are ideals of $R$ such that $I_1$ and $J$ are coprime, and $I_2$ and $J$ are coprime, then $I_1 I_2$ and $J$ are coprime.
\end{lemma}

\begin{proof}
There exist $a_1 \in I_1$, $b_1 \in J$ such that $a_1 + b_1 = 1$, and $a_2 \in I_2$, $b_2 \in J$ such that $a_2 + b_2 = 1$. Then
\[ (a_1 + b_1)(a_2 + b_2) = 1 = \underbrace{a_1 a_2}_{\in I_1 I_2} + \underbrace{a_1 b_2 + b_1 a_2 + b_1 b_2}_{\in J}. \]
\end{proof}

By the lemma, $I_1$ and $I_2 \cdots I_n$ are coprime, so there exist $a \in I_1$, $b \in I_2 \cdots I_n$ such that $a + b = 1$. Let $x_1 = 1 - a = b$. Then $x_1 + I_1 = 1 - a + I_1 = 1 + I_1$ and $x_1 + I_i = b + I_i = I_i$ for $i \neq 1$. Hence $\varphi(x_1) = (1 + I_1, I_2, \ldots, I_n)$. Similarly we find $x_i$ for each $i$, so for all $x = (r_1 + I_1, \ldots, r_n + I_n) \in \prod_{i=1}^{k} R/A_i$, there exists $r = r_1 x_1 + \cdots + r_n x_n$ such that $x = \varphi(r)$.

\begin{enumerate}
\setcounter{enumi}{2}
\item If coprime, then $A_1 \cap \cdots \cap A_n = A_1 \cdots A_n$.
\end{enumerate}
This is obvious for $n = 1$. By induction, it suffices to prove $A_1 \cap A_2 \subseteq A_1 A_2$. Indeed, if $a \in A_1 \cap A_2$ and $x \in A_1$, $y \in A_2$ satisfy $x + y = 1$, then $a = a(x + y) = ax + ay \in A_1 A_2$ since $R$ is commutative.

Since the isomorphism in the Chinese Remainder Theorem is an isomorphism of rings, in particular the groups of units on both sides must be isomorphic. Thus
\[ (\mathbb{Z}/mn\mathbb{Z})^\times \simeq (\mathbb{Z}/m\mathbb{Z})^\times \times (\mathbb{Z}/n\mathbb{Z})^\times \]
whenever $(m, n) = 1$.

\begin{remark}
There are 3 elements of order 2 in $\operatorname{Aut}(C_{2^e})$:
\begin{itemize}
\item $g \mapsto g^{-1}$
\item $g \mapsto g^{2^{e-1}+1}$, e.g., using $g \mapsto g^5$
\item $g \mapsto g^{2^{e-1}-1}$ (which equals $(g^{2^{e-1}+1})^{-1}$)
\end{itemize}
\end{remark}

\begin{topic}[Dihedral Group $G = D_{2n}$]
The dihedral group is $G = \langle a, b \rangle$ with $a^2 = b^2 = 1$.
\end{topic}

\begin{example}
Let
\[ a = \begin{pmatrix} 0 & 1 \\ 1 & 0 \end{pmatrix}, \quad b = \begin{pmatrix} 0 & 2 \\ \frac{1}{2} & 0 \end{pmatrix} \in GL(2, \mathbb{R}). \]
\end{example}
\end{topic}

\begin{topic}[Week 1 (part 3)]

Let $|a|=|b|=2$ with $ab$ having infinite order. Then $G=\langle a, b\rangle$ is an infinite dihedral group.

\begin{remark}
$|G|$ is finite if and only if $|ab|$ is finite.
\end{remark}

The elements of $G$ are $a, ab, aba, abab, \ldots$ and $b, ba, bab, baba, \ldots$. As soon as we know the first term in these lists to give the identity element, we know $G$. It can't be elements like $ababa$, since $1=ababa=bab=a$. So it must be $(ab)^m=1$ for some $m$, and then $G$ is finite. Note that $(ab)^m=1 \Leftrightarrow (ba)^m=1$.

\[
G=\{(ab)^i, (ba)^j, (ab)^ia, (ba)^jb\}
\]

\[
\Rightarrow G=\{(ab)^i, b(ab)^i \mid i \in \mathbb{Z}\}.
\]

Since $(ba)^j=(ba)^jb^2=b(ab)^jb=((ab)^j)^{-1}$ and $(ab)^ia=b(ba)^{i+1}=b((ab)^i)^{-1}$.

If $G$ is finite, $|ab|=n$, so $|G|=2n$ and $|ab|=\frac{|G|}{2}$. Thus $G=\langle ab, b\rangle=\langle ab, a\rangle=\langle ab\rangle:\langle b\rangle=C_n:C_2$.

\begin{definition}
Let $G$ be a group, $A, B < G$. Then $G$ is called a \emph{semidirect product} of $A$ by $B$, denoted $A:B$ or $A \rtimes B$, if:
\begin{enumerate}
\item $A \triangleleft G$
\item $A \cap B=1$
\item $G=AB$
\end{enumerate}
\end{definition}

\begin{example}
Consider $\mathrm{Aut}(D_{2n})$. Let $g \mapsto g^i$ where $(i,n)=1$. If $n$ is odd, then $b \mapsto g^jb$ for some $j$ gives an automorphism of $D_{2n}$.

Then $\mathrm{Aut}(D_{2n})\simeq C_n:\mathrm{Aut}(C_n)$.

In particular:
\begin{itemize}
\item $\mathrm{Aut}(D_{2p})=C_p:C_{p-1}$
\item $\mathrm{Aut}(D_{2p^l})=C_{p^l}:C_{p^{l-1}(p-1)}$
\item $|\mathrm{Aut}(D_{2n})|=n\phi(n)$
\end{itemize}
\end{example}

\begin{remark}
Hint: $G=D_{2n}=\langle g\rangle:\langle b\rangle=C_n:C_2$. If $\sigma \in \mathrm{Aut}(G)$, then $g^\sigma=g^i$ since $\langle g^\sigma\rangle$ has odd order.
\end{remark}

\begin{topic}[Conjugacy classes of $D_{2n}$]
Let $D_{2n}=\langle g\rangle:\langle b\rangle=\{g^i, g^jb \mid 0 \leq i,j \leq n-1\}$.

\textbf{Case 1: $n$ is odd.}
\begin{enumerate}
\item Elements of odd order form conjugacy classes $\{g^i, g^{-i}\}$.
\item Elements of even order are all conjugate.
\end{enumerate}

\begin{proof}
Claim: $g^jb$ and $g^{j+1}b$ are conjugate.

Observe that:
\begin{enumerate}
\item $D_{2n}$ has exactly $n$ elements of order $2$: $g^jb$ for $0 \leq j \leq n-1$.
\item $g^{-i}bg^i$ with $0 \leq i \leq n-1$ are of order $2$ and distinct, and are obviously conjugate. Thus $g^ib=g^{-j}bg^j$ for some $j$, and all $g^ib$ are conjugate.
\end{enumerate}
\end{proof}

\textbf{Case 2: $n$ is even.}
